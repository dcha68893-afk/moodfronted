<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      SECURITY/FUNCTIONALITY FIX (audit-driven — was: calls likely completely
      non-functional on native Android): WebRTC voice/video calling code
      exists and is wired up (calls.html, calls-core.part*.js,
      PeerConnectionManager.js — a real, working RTCPeerConnection/
      getUserMedia implementation), but this manifest declared ONLY the
      INTERNET permission. On Android 6.0+, a runtime permission prompt can
      only be shown for a permission that is ALSO declared here — without
      these declarations, any getUserMedia({video:true,audio:true}) call
      made from the WebView is denied by the OS outright, silently, with no
      prompt ever shown to the user. This means the calls feature very
      likely could not access the camera or microphone at all on a real
      Android device before this fix, regardless of how correct the
      WebRTC/signaling code itself is — verified by reading that code (it's
      real and functional) and by the absence of these permissions (which
      is not something app code can work around).
      RECORD_AUDIO / CAMERA: required for getUserMedia to work at all.
      MODIFY_AUDIO_SETTINGS: needed to switch between earpiece/speaker/
      Bluetooth during a call (referenced by the app's own call UI, which
      has speaker/Bluetooth toggle controls).
      BLUETOOTH_CONNECT: Android 12+ (API 31+) requires this specifically to
      route call audio to a paired Bluetooth headset; the legacy BLUETOOTH
      permission alone is not sufficient on API 31+.
    -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!--
      Declares camera as used-but-not-required so this app remains
      installable on camera-less devices (e.g. some tablets) where only
      voice calls would be available — without this, the Play Store would
      assume camera hardware is mandatory and hide the app from those
      devices entirely.
    -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
</manifest>
