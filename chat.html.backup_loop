            }
            
            .content-area.iframe-container {
                left: 0 !important;
                width: 100% !important;
                height: 100vh !important;
                padding-bottom: 60px;
            }
            
            .chat-filter-tabs-header {
                margin: 0 auto;
                background: rgba(255, 255, 255, 0.1);
            }
            
            .chat-filter-tab-header {
                width: 44px;
                height: 44px;
                font-size: 18px;
            }
            
            #chatHeader .flex.space-x-3 {
                display: none !important;
            }
            
            #chatArea:not(.hidden) #chatHeader .flex.space-x-3 {
                display: flex !important;
            }
            
            .content-iframe {
                width: 100% !important;
                height: 100% !important;
                overflow: auto !important;
            }
            
            .iframe-container {
                overflow: auto !important;
                -webkit-overflow-scrolling: touch !important;
            }
            
            .mobile-nav-badge {
                position: absolute;
                top: 5px;
                right: 15px;
                background: #ef4444;
                color: white;
                border-radius: 50%;
                width: 18px;
                height: 18px;
                font-size: 10px;
                display: flex;
                align-items: center;
                justify-content: center;
                z-index: 1001;
            }
            
            .mobile-group-icon {
                display: inline-flex !important;
                align-items: center;
                justify-content: center;
                margin-right: 10px;
                padding: 8px;
                border-radius: 50%;
                background: rgba(255, 255, 255, 0.1);
                color: white !important;
            }
            
            .mobile-group-icon i {
                font-size: 18px !important;
                color: white !important;
            }
            
            .mobile-menu-button {
                display: none !important;
                margin-right: 10px;
                padding: 8px;
                border-radius: 50%;
                background: rgba(255, 255, 255, 0.1);
                color: white !important;
            }
            
            body.in-chat-view .mobile-menu-button {
                display: inline-flex !important;
            }
            
            .back-button {
                display: inline-flex !important;
                align-items: center;
                justify-content: center;
                margin-right: 10px;
                padding: 8px;
                border-radius: 50%;
                background: rgba(255, 255, 255, 0.1);
                color: white !important;
                cursor: pointer;
            }
            
            .back-button i {
                font-size: 18px !important;
                color: white !important;
            }
            
            body.in-chat-view .mobile-menu-button,
            body.in-status-view .mobile-menu-button,
            body.in-group-view .mobile-menu-button {
                display: none !important;
            }
            
            body.in-chat-view .back-button,
            body.in-status-view .back-button,
            body.in-group-view .back-button {
                display: inline-flex !important;
            }
        }
        
        @media (min-width: 768px) and (max-width: 1023px) {
            .iframe-container {
