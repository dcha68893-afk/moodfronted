    <title>Kynecta - Advanced Mood-Based Chat</title>

    <!-- ========== [FIXED] ENVIRONMENT DETECTION (DYNAMIC) ========== -->
<script>
(function() {
    'use strict';
    
    // Dynamic environment detection - SINGLE SOURCE OF TRUTH
    function detectEnvironment() {
        const hostname = window.location.hostname;
        
        // LOCAL environment detection
        if (hostname === 'localhost' || hostname === '127.0.0.1' || hostname === '::1') {
            return {
                type: 'LOCAL',
                isLocal: true,
                isProduction: false,
                apiBaseUrl: 'http://localhost:4000/api',
                wsBaseUrl: 'ws://localhost:4000/ws',
                wsPort: 4001,
                apiPort: 4000,
                detectionTime: Date.now()
            };
        }
        
        // PRODUCTION environment (Render.com)
        if (hostname.includes('onrender.com') || hostname.includes('render.com')) {
            return {
                type: 'PRODUCTION',
                isLocal: false,
                isProduction: true,
                apiBaseUrl: 'https://moodchat-fy56.onrender.com/api',
                wsBaseUrl: 'wss://moodchat-fy56.onrender.com/ws',
                wsPort: 443,
                apiPort: 443,
                detectionTime: Date.now()
            };
        }
        
        // Fallback: assume production with detected hostname
        const protocol = window.location.protocol === 'https:' ? 'https:' : 'http:';
        const baseUrl = `${protocol}//${hostname}`;
        
        return {
            type: 'CUSTOM',
            isLocal: false,
            isProduction: true,
            apiBaseUrl: `${baseUrl}/api`,
            wsBaseUrl: `${protocol === 'https:' ? 'wss:' : 'ws:'}//${hostname}/ws`,
            detectionTime: Date.now()
        };
    }
    
    const ENV = detectEnvironment();
    
    // Store environment globally
    window.__KYNECTA_ENV__ = ENV;
    
    // API Base URL getter - uses detected environment
    window.__getApiBase = function() {
        return ENV.apiBaseUrl;
    };
    
    // WebSocket Base URL getter
    window.__getWsBase = function() {
        return ENV.wsBaseUrl;
    };
    
    // Safe logger call
    if (window.__KYNECTA_LOGGER__ && window.__KYNECTA_LOGGER__.info) {
        window.__KYNECTA_LOGGER__.info('ENV', 'init', 'Environment detected', {
            type: ENV.type,
            apiBaseUrl: ENV.apiBaseUrl,
            wsBaseUrl: ENV.wsBaseUrl,
            hostname: window.location.hostname
        });
    } else {
        console.log('[ENV] Environment detected:', ENV.type, ENV.apiBaseUrl);
    }
    
    // Also expose Environment object for modules
    window.Environment = {
        type: ENV.type,
        isLocal: ENV.isLocal,
        isProduction: ENV.isProduction,
        apiBaseUrl: ENV.apiBaseUrl,
        wsBaseUrl: ENV.wsBaseUrl,
        detect: function() { return ENV; },
        get: function() { return { ...ENV }; }
    };
    
})();
</script>
<script>
// ========== CRITICAL: TOKEN RECOVERY ON PAGE LOAD ==========
(function recoverTokenOnLoad() {
    console.log('🔧 [RECOVERY] Running token recovery on page load...');
    
    // Function to get token from ANY location
    function getTokenFromAnyLocation() {
        // Priority 1: Direct token key
        let token = localStorage.getItem('token');
        if (token && token.length > 20 && token !== 'undefined' && token !== 'null') {
            console.log('✅ Token found in localStorage.token');
            return token;
        }
        
        // Priority 2: accessToken
        token = localStorage.getItem('accessToken');
        if (token && token.length > 20) {
            console.log('✅ Token found in localStorage.accessToken');
            return token;
        }
        
        // Priority 3: moodchat_token
        token = localStorage.getItem('moodchat_token');
        if (token && token.length > 20) {
            console.log('✅ Token found in localStorage.moodchat_token');
            return token;
        }
        
        // Priority 4: Unified auth storage
        const unifiedAuth = localStorage.getItem('kynecta_auth');
        if (unifiedAuth) {
            try {
                const parsed = JSON.parse(unifiedAuth);
                if (parsed.token && parsed.token.length > 20) {
                    console.log('✅ Token found in kynecta_auth');
                    return parsed.token;
                }
            } catch(e) {}
        }
        
        // Priority 5: Session storage
        token = sessionStorage.getItem('token');
        if (token && token.length > 20) {
            console.log('✅ Token found in sessionStorage');
            return token;
        }
        
        console.log('⚠️ No token found in any location');
        return null;
    }
    
    // Function to ensure token is in ALL locations
    function ensureTokenInAllLocations(token) {
        if (!token) return false;
        
        console.log('🔧 Ensuring token in all locations...');
        
        // Store in all localStorage keys
        localStorage.setItem('token', token);
        localStorage.setItem('accessToken', token);
        localStorage.setItem('moodchat_token', token);
        localStorage.setItem('USER_TOKEN', token);
        
        // Update unified storage
        let user = null;
        try {
            const existing = localStorage.getItem('kynecta_auth');
            if (existing) {
                const parsed = JSON.parse(existing);
                user = parsed.user;
            }
        } catch(e) {}
        
        const unifiedAuth = {
            token: token,
            user: user,
            timestamp: Date.now(),
            validated: true,
            expiresAt: Date.now() + 3600000
        };
        localStorage.setItem('kynecta_auth', JSON.stringify(unifiedAuth));
        
        // Store in session storage
        sessionStorage.setItem('token', token);
        sessionStorage.setItem('accessToken', token);
        
        // Store on window
        window.token = token;
        window.accessToken = token;
        
        console.log('✅ Token stored in all locations');
        return true;
    }
    
    // Validate token with backend
    async function validateTokenWithBackend(token) {
        if (!token) return { valid: false };
        
        try {
            const API_BASE = window.__getApiBase ? window.__getApiBase() : 'http://localhost:4000/api';
            console.log('🔍 Validating token with backend...');
            
            const response = await fetch(`${API_BASE}/auth/validate-token`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Authorization': `Bearer ${token}`
                },
                body: JSON.stringify({ token: token })
            });
            
            const data = await response.json();
            console.log('📡 Validation response:', data);
            
            // Check for valid token in multiple response formats
            let isValid = false;
            let userId = null;
            
            if (data.success === true && data.valid === true) {
                isValid = true;
                userId = data.userId || data.user?.id;
            } else if (data.authValidated === true) {
                isValid = true;
                userId = data.userId || data.user?.id;
            } else if (data.valid === true) {
                isValid = true;
                userId = data.userId || data.user?.id;
            } else if (data.user && data.user.id) {
                isValid = true;
                userId = data.user.id;
            } else if (data.userId && data.userId > 0) {
                isValid = true;
                userId = data.userId;
            }
            
            if (isValid && userId) {
                console.log('✅ Token is valid for user:', userId);
                return { valid: true, userId: userId, user: data.user };
            }
            
            console.log('❌ Token validation failed');
            return { valid: false };
        } catch (error) {
            console.error('❌ Validation error:', error);
            return { valid: false, error: error.message };
        }
    }
    
    // Main recovery function
    async function recoverAndRedirect() {
        console.log('🔧 Running token recovery...');
        
        // Get token from any location
        let token = getTokenFromAnyLocation();
        
        if (!token) {
            console.log('⚠️ No token found, staying on login page');
            return false;
        }
        
        console.log('🔍 Found token, validating...');
        
        // Validate token with backend
        const validation = await validateTokenWithBackend(token);
        
        if (validation.valid) {
            console.log('✅ Token is valid! Ensuring storage and redirecting...');
            
            // Ensure token is in all locations
            ensureTokenInAllLocations(token);
            
            // Store user info if available
            if (validation.user) {
                localStorage.setItem('currentUser', JSON.stringify(validation.user));
                window.currentUser = validation.user;
            }
            
            // Dispatch events
            window.dispatchEvent(new CustomEvent('session:ready', {
                detail: {
                    token: token,
                    user: validation.user,
                    userId: validation.userId,
                    timestamp: Date.now(),
                    recovered: true
                }
            }));
            
            // Check if we're already on chat.html
            if (window.location.pathname.includes('chat.html')) {
                console.log('✅ Already on chat.html, reloading to ensure session');
                window.location.reload();
            } else {
                console.log('🚀 Redirecting to chat.html...');
                window.location.href = 'chat.html';
            }
            
            return true;
        } else {
            console.log('❌ Token invalid, clearing and staying on login');
            // Clear invalid token
            localStorage.removeItem('token');
            localStorage.removeItem('accessToken');
            localStorage.removeItem('moodchat_token');
            localStorage.removeItem('kynecta_auth');
            sessionStorage.clear();
            return false;
        }
    }
    
    // Run recovery on page load
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', () => {
            setTimeout(recoverAndRedirect, 100);
        });
    } else {
        setTimeout(recoverAndRedirect, 100);
    }
    
    // Also run on storage events (for cross-tab sync)
    window.addEventListener('storage', function(event) {
        if (event.key === 'token' || event.key === 'kynecta_auth') {
            console.log('📦 Storage changed, checking token...');
            setTimeout(recoverAndRedirect, 100);
        }
    });
    
})();
</script>
<!-- ========== [FIXED] STRUCTURED LOGGING UTILITY (NO GLOBAL OVERRIDES) ========== -->
<script>
(function() {
    'use strict';
    
    // Initialize logger first - before any other scripts
    window.__KYNECTA_LOGGER__ = {
        _logs: [],
        _maxLogs: 500,
        _enabled: true,
        
        log: function(level, moduleId, requestId, message, data) {
            if (!this._enabled) return;
            
            const logEntry = {
                timestamp: Date.now(),
                level: level,
                moduleId: moduleId || 'parent',
                requestId: requestId || 'unknown',
                message: message,
                data: data ? JSON.parse(JSON.stringify(data)) : null
            };
            
            this._logs.push(logEntry);
            if (this._logs.length > this._maxLogs) {
                this._logs.shift();
            }
            
            // Use native console methods (no overrides)
            const nativeConsole = window.console;
            if (level === 'error') {
                nativeConsole.error(`[${logEntry.moduleId}] ${message}`, data || '');
            } else if (level === 'warn') {
                nativeConsole.warn(`[${logEntry.moduleId}] ${message}`, data || '');
            } else {
                nativeConsole.log(`[${logEntry.moduleId}] ${message}`, data || '');
            }
        },
        
        info: function(moduleId, requestId, message, data) {
            this.log('info', moduleId, requestId, message, data);
        },
        
        warn: function(moduleId, requestId, message, data) {
            this.log('warn', moduleId, requestId, message, data);
        },
        
        error: function(moduleId, requestId, message, data) {
            this.log('error', moduleId, requestId, message, data);
        },
        
        getLogs: function() {
            return [...this._logs];
        },
        
        clear: function() {
            this._logs = [];
        },
        
        enable: function() { this._enabled = true; },
        disable: function() { this._enabled = false; }
    };
    
    // Log initialization
    try {
        window.__KYNECTA_LOGGER__.info('parent', 'init', 'Structured logging initialized');
    } catch(e) {
        console.log('[Logger] Initialized');
    }
    
})();
</script>

<script>
// ========== TOKEN DEBUG AND FIX UTILITY ==========
(function fixTokenIssues() {
    console.log('🔧 Running token fix utility...');
    
    // Function to ensure token is properly stored in ALL locations
    window.__ensureTokenStored = function(token) {
        if (!token || token === 'undefined' || token === 'null') {
            console.warn('⚠️ Cannot store invalid token');
            return false;
        }
        
        // Store in ALL possible locations
        try {
            localStorage.setItem('token', token);
            localStorage.setItem('accessToken', token);
            localStorage.setItem('moodchat_token', token);
            localStorage.setItem('USER_TOKEN', token);
            localStorage.setItem('jwt', token);
            localStorage.setItem('authToken', token);
            
            // Store in sessionStorage as backup
            sessionStorage.setItem('token', token);
            sessionStorage.setItem('accessToken', token);
            
            // Store in unified auth
            const unifiedAuth = {
                token: token,
                timestamp: Date.now(),
                validated: true
            };
            localStorage.setItem('kynecta_auth', JSON.stringify(unifiedAuth));
            
            // Store on window
            window.token = token;
            window.accessToken = token;
            window.__userToken = token;
            
            console.log('✅ Token stored in all locations');
            return true;
        } catch (e) {
            console.error('❌ Failed to store token:', e);
            return false;
        }
    };
    
    // Function to get token from ANY location
    window.__getTokenFromAnyLocation = function() {
        // Priority order
        const tokenLocations = [
            () => localStorage.getItem('token'),
            () => localStorage.getItem('accessToken'),
            () => localStorage.getItem('moodchat_token'),
            () => localStorage.getItem('USER_TOKEN'),
            () => {
                const auth = localStorage.getItem('kynecta_auth');
                if (auth) {
                    try {
                        return JSON.parse(auth).token;
                    } catch(e) {}
                }
                return null;
            },
            () => sessionStorage.getItem('token'),
            () => window.token,
            () => window.accessToken
        ];
        
        for (const getter of tokenLocations) {
            try {
                const token = getter();
                if (token && token !== 'undefined' && token !== 'null' && token.length > 20) {
                    console.log('✅ Found token from:', getter.toString().substring(0, 50));
                    return token;
                }
            } catch(e) {}
        }
        
        console.warn('⚠️ No token found in any location');
        return null;
    };
    
    // Fix authorizedFetch to use token from any location
    if (window.authorizedFetch) {
        const originalFetch = window.authorizedFetch;
        window.authorizedFetch = async function(url, options = {}) {
            const token = window.__getTokenFromAnyLocation();
            
            if (!token) {
                console.error('❌ No token available for authorizedFetch');
                throw new Error('Missing authentication token');
            }
            
            const headers = {
                'Content-Type': 'application/json',
                ...(options.headers || {}),
                'Authorization': `Bearer ${token}`
            };
            
            console.log(`🔐 authorizedFetch: ${options.method || 'GET'} ${url}`);
            
            let response = await fetch(url, {
                ...options,
                headers: headers
            });
            
            // If 401, try to refresh token
            if (response.status === 401) {
                console.log('⚠️ 401 detected, attempting token refresh...');
                const refreshResult = await window.__attemptTokenRefresh();
                if (refreshResult && refreshResult.token) {
                    window.__ensureTokenStored(refreshResult.token);
                    headers['Authorization'] = `Bearer ${refreshResult.token}`;
                    response = await fetch(url, {
                        ...options,
                        headers: headers
                    });
                }
            }
            
            return response;
        };
        console.log('✅ authorizedFetch patched');
    }
    
    // Fix token validation to handle multiple response formats
    window.__validateTokenWithBackend = async function(token) {
        if (!token) {
            return { valid: false, reason: 'no_token' };
        }
        
        try {
            const API_BASE = window.__getApiBase();
            console.log('🔍 Validating token with backend...');
            
            const response = await fetch(`${API_BASE}/auth/validate-token`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Authorization': `Bearer ${token}`
                },
                body: JSON.stringify({ token: token })
            });
            
            let data;
            try {
                data = await response.json();
            } catch(e) {
                const text = await response.text();
                console.error('❌ Failed to parse response:', text);
                return { valid: false, reason: 'invalid_response', raw: text };
            }
            
            console.log('📡 Validation response:', {
                status: response.status,
                hasSuccess: data.success !== undefined,
                hasValid: data.valid !== undefined,
                hasAuthValidated: data.authValidated !== undefined,
                hasUser: !!data.user,
                userId: data.userId || data.user?.id
            });
            
            // CRITICAL FIX: Handle multiple response formats
            let isValid = false;
            let userId = null;
            let user = null;
            
            // Format 1: { success: true, valid: true, authValidated: true }
            if (data.success === true && data.valid === true) {
                isValid = true;
                userId = data.userId || data.user?.id;
                user = data.user;
                console.log('✅ Token valid (format 1)');
            }
            // Format 2: { authValidated: true }
            else if (data.authValidated === true) {
                isValid = true;
                userId = data.userId || data.user?.id;
                user = data.user;
                console.log('✅ Token valid (format 2)');
            }
            // Format 3: { valid: true }
            else if (data.valid === true) {
                isValid = true;
                userId = data.userId || data.user?.id;
                user = data.user;
                console.log('✅ Token valid (format 3)');
            }
            // Format 4: { user: { id: ... } }
            else if (data.user && data.user.id) {
                isValid = true;
                userId = data.user.id;
                user = data.user;
                console.log('✅ Token valid (format 4)');
            }
            // Format 5: { userId: ... }
            else if (data.userId && data.userId > 0) {
                isValid = true;
                userId = data.userId;
                user = { id: userId };
                console.log('✅ Token valid (format 5)');
            }
            // Format 6: 200 status with no validation flags but has data
            else if (response.status === 200 && (data.id || data._id)) {
                isValid = true;
                userId = data.id || data._id;
                user = data;
                console.log('✅ Token valid (format 6 - fallback)');
            }
            
            if (isValid && userId) {
                console.log('✅ Token validated successfully for user:', userId);
                return {
                    valid: true,
                    userId: userId,
                    user: user,
                    expiresAt: data.expiresAt || data.expiry
                };
            }
            
            console.warn('❌ Token validation failed:', data);
            return { valid: false, reason: 'validation_failed', data: data };
            
        } catch (error) {
            console.error('❌ Token validation error:', error);
            return { valid: false, reason: error.message };
        }
    };
    
    // Fix auto-login to properly restore token
    window.__fixAutoLogin = async function() {
        console.log('🔧 Running auto-login fix...');
        
        // Try to get token from any location
        let token = window.__getTokenFromAnyLocation();
        
        if (!token) {
            console.log('No token found, skipping auto-login');
            return false;
        }
        
        console.log('Token found, validating with backend...');
        
        // Validate token
        const validation = await window.__validateTokenWithBackend(token);
        
        if (validation.valid) {
            console.log('✅ Token is valid, ensuring it\'s stored properly');
            
            // Ensure token is stored in ALL locations
            window.__ensureTokenStored(token);
            
            // Update global session
            if (window.__PARENT_SESSION__) {
                window.__PARENT_SESSION__.token = token;
                window.__PARENT_SESSION__.authenticated = true;
                window.__PARENT_SESSION__.userId = validation.userId;
                window.__PARENT_SESSION__.user = validation.user;
            }
            
            // Update window.currentUser
            window.currentUser = validation.user || { id: validation.userId };
            
            // Dispatch events
            window.dispatchEvent(new CustomEvent('session:ready', {
                detail: {
                    token: token,
                    user: validation.user,
                    userId: validation.userId,
                    timestamp: Date.now()
                }
            }));
            
            window.dispatchEvent(new CustomEvent('token:stored', {
                detail: { token: token, timestamp: Date.now() }
            }));
            
            console.log('✅ Auto-login successful');
            return true;
        } else {
            console.warn('❌ Token invalid, clearing...');
            // Clear invalid token
            localStorage.removeItem('token');
            localStorage.removeItem('accessToken');
            localStorage.removeItem('moodchat_token');
            localStorage.removeItem('kynecta_auth');
            return false;
        }
    };
    
    // Run auto-login fix after page loads
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', () => {
            setTimeout(window.__fixAutoLogin, 1000);
        });
    } else {
        setTimeout(window.__fixAutoLogin, 1000);
    }
    
    console.log('✅ Token fix utility loaded');
})();
</script><script>
// ========== TOKEN DEBUGGING ==========
(function debugTokenFlow() {
    // Log token status on load
    console.log('=== TOKEN STATUS ON LOAD ===');
    console.log('token:', localStorage.getItem('token')?.substring(0, 30) + '...');
    console.log('accessToken:', localStorage.getItem('accessToken')?.substring(0, 30) + '...');
    console.log('moodchat_token:', localStorage.getItem('moodchat_token')?.substring(0, 30) + '...');
    
    const auth = localStorage.getItem('kynecta_auth');
    if (auth) {
        try {
            const parsed = JSON.parse(auth);
            console.log('kynecta_auth.token:', parsed.token?.substring(0, 30) + '...');
            console.log('kynecta_auth.validated:', parsed.validated);
        } catch(e) {}
    }
    
    console.log('=== END TOKEN STATUS ===');
    
    // Monitor token changes
    window.addEventListener('storage', function(e) {
        if (e.key === 'token' || e.key === 'accessToken' || e.key === 'moodchat_token' || e.key === 'kynecta_auth') {
            console.log(`📦 Storage changed: ${e.key}`, {
                oldValue: e.oldValue?.substring(0, 30),
                newValue: e.newValue?.substring(0, 30)
            });
        }
    });
    
    // Intercept fetch to debug Authorization headers
    const originalFetch = window.fetch;
    window.fetch = function(...args) {
        const headers = args[1]?.headers;
        const authHeader = headers?.Authorization || headers?.authorization;
        
        if (authHeader) {
            console.log(`🔐 FETCH ${args[0]} - Auth header: ${authHeader.substring(0, 30)}...`);
        } else {
            console.log(`🔓 FETCH ${args[0]} - No auth header`);
        }
        
        return originalFetch.apply(this, args);
    };
})();
</script>

<!-- ========== [FIXED] EARLY API UTILITY FUNCTIONS ========== -->
<script>
(function() {
    'use strict';
    
    // API Base URL detection - uses dynamic environment
    window.__getApiBase = function() {
        return window.__KYNECTA_ENV__?.apiBaseUrl || 'http://localhost:4000/api';
    };
    
    // Endpoint normalization
    window.__normalizeEndpoint = function(endpoint) {
        if (!endpoint || typeof endpoint !== 'string') return '';
        let clean = endpoint.trim();
        while (clean.startsWith('/')) clean = clean.substring(1);
        while (clean.endsWith('/')) clean = clean.slice(0, -1);
        clean = clean.replace(/\/+/g, '/');
        return clean;
    };
    
    window.__KYNECTA_LOGGER__.info('parent', 'api', 'Early API utilities initialized');
})();
</script>

<!-- ========== [FIXED] ENHANCED AUTHORIZED FETCH WITH REFRESH TOKEN SUPPORT ========== -->
<script>
(function() {
    'use strict';
    
    let refreshInProgress = false;
    let refreshPromise = null;
    let failedRefreshAttempts = 0;
    const MAX_REFRESH_ATTEMPTS = 3;
    
    // Refresh token function - safe and idempotent
    async function attemptTokenRefresh() {
        // Prevent multiple concurrent refresh attempts
        if (refreshInProgress && refreshPromise) {
            window.__KYNECTA_LOGGER__.info('AUTH', 'refresh', 'Refresh already in progress, waiting');
            return refreshPromise;
        }
        
        refreshInProgress = true;
        
        refreshPromise = (async () => {
            try {
                const refreshToken = localStorage.getItem('refresh_token');
                
                if (!refreshToken) {
                    window.__KYNECTA_LOGGER__.warn('AUTH', 'refresh', 'No refresh token available');
                    refreshInProgress = false;
                    return { success: false, reason: 'no_refresh_token' };
                }
                
                const API_BASE = window.__getApiBase();
                const response = await fetch(`${API_BASE}/auth/refresh-token`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ refreshToken: refreshToken })
                });
                
                if (response.ok) {
                    const data = await response.json();
                    
                    if (data.token) {
                        // Get existing user data
                        let userId = null;
                        let userData = null;
                        
                        const authData = localStorage.getItem('kynecta_auth');
                        if (authData) {
                            try {
                                const parsed = JSON.parse(authData);
                                userId = parsed.userId;
                                userData = parsed.user;
                            } catch (e) {}
                        }
                        
                        // Validate that we have a valid userId from backend
                        if (!userId && data.user && data.user.id) {
                            userId = data.user.id;
                            userData = data.user;
                        }
                        
                        if (!userId) {
                            window.__KYNECTA_LOGGER__.error('AUTH', 'refresh', 'Cannot refresh: no valid userId');
                            refreshInProgress = false;
                            return { success: false, reason: 'no_user_id' };
                        }
                        
                        // Update all storage locations
                        localStorage.setItem('token', data.token);
                        localStorage.setItem('moodchat_token', data.token);
                        localStorage.setItem('accessToken', data.token);
                        
                        // Update unified auth storage
                        const updatedAuth = {
                            token: data.token,
                            userId: userId,
                            user: userData || { id: userId, username: 'User' },
                            expiry: Date.now() + 3600000,
                            timestamp: Date.now(),
                            refreshed: true,
                            sessionVersion: (window.__PARENT_SESSION__?.sessionVersion || 0) + 1
                        };
                        localStorage.setItem('kynecta_auth', JSON.stringify(updatedAuth));
                        
                        failedRefreshAttempts = 0;
                        
                        window.__KYNECTA_LOGGER__.info('AUTH', 'refresh', 'Token refresh successful', { userId });
                        
                        // Broadcast refreshed session to modules
                        setTimeout(() => {
                            if (window.__broadcastSessionToModules) {
                                window.__broadcastSessionToModules();
                            }
                        }, 100);
                        
                        refreshInProgress = false;
                        return { success: true, token: data.token };
                    }
                }
                
                // Handle 401 from refresh endpoint - token is invalid
                if (response.status === 401) {
                    window.__KYNECTA_LOGGER__.warn('AUTH', 'refresh', 'Refresh token invalid, clearing auth');
                    failedRefreshAttempts++;
                    
                    if (failedRefreshAttempts >= MAX_REFRESH_ATTEMPTS) {
                        window.__KYNECTA_LOGGER__.error('AUTH', 'refresh', 'Max refresh attempts exceeded, triggering logout');
                        window.__triggerLogoutAndCleanup();
                    }
                    
                    refreshInProgress = false;
                    return { success: false, reason: 'invalid_refresh_token' };
                }
                
                refreshInProgress = false;
                return { success: false, reason: 'refresh_failed' };
                
            } catch (error) {
                window.__KYNECTA_LOGGER__.error('AUTH', 'refresh', 'Refresh request failed', { error: error.message });
                refreshInProgress = false;
                return { success: false, reason: error.message };
            }
        })();
        
        return refreshPromise;
    }
    
    // Clean logout function
    window.__triggerLogoutAndCleanup = function() {
        window.__KYNECTA_LOGGER__.info('AUTH', 'logout', 'Clearing authentication state');
        
        // Clear tokens
        localStorage.removeItem('token');
        localStorage.removeItem('moodchat_token');
        localStorage.removeItem('accessToken');
        localStorage.removeItem('refresh_token');
        
        // Clear auth data
        localStorage.removeItem('kynecta_auth');
        localStorage.removeItem('kynecta_token');
        localStorage.removeItem('kynecta_user');
        localStorage.removeItem('moodchat_user');
        
        // Clear session cache
        if (window.__PARENT_SESSION__) {
            window.__PARENT_SESSION__.authenticated = false;
            window.__PARENT_SESSION__.token = null;
            window.__PARENT_SESSION__.userId = null;
            window.__PARENT_SESSION__.session = null;
            window.__PARENT_SESSION__.sessionVersion = (window.__PARENT_SESSION__.sessionVersion || 0) + 1;
        }
        
        // Broadcast logout to modules
        const iframes = document.querySelectorAll('iframe');
        iframes.forEach(iframe => {
            if (iframe.contentWindow) {
                iframe.contentWindow.postMessage({
                    type: 'SESSION_LOGOUT',
                    id: `logout_${Date.now()}`,
                    source: 'parent',
                    target: iframe.id?.replace('Iframe', '') || '*',
                    payload: { timestamp: Date.now() },
                    timestamp: Date.now()
                }, '*');
            }
        });
        
        // Redirect to login if not already there
        if (!window.location.pathname.includes('login') && !window.location.pathname.includes('index')) {
            setTimeout(() => {
                window.location.href = '../index.html';
            }, 500);
        }
    };
    
   
    // Validate token with backend - SINGLE SOURCE OF TRUTH
window.__validateTokenWithBackend = async function(token) {
    if (!token) {
        return { valid: false, reason: 'no_token' };
    }
    
    try {
        const API_BASE = window.__getApiBase();
        
        if (window.__KYNECTA_LOGGER__) window.__KYNECTA_LOGGER__.info('AUTH', 'validate', 'Validating token with backend', {
            tokenPrefix: token.substring(0, 20) + '...'
        });
        
        const response = await fetch(`${API_BASE}/auth/validate-token`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'Authorization': `Bearer ${token}`
            },
            body: JSON.stringify({ token: token })
        });
        
        // Parse response
        let data;
        try {
            data = await response.json();
        } catch (e) {
            if (window.__KYNECTA_LOGGER__) window.__KYNECTA_LOGGER__.error('AUTH', 'validate', 'Failed to parse response', { error: e.message });
            return { valid: false, reason: 'invalid_response' };
        }
        
        if (window.__KYNECTA_LOGGER__) window.__KYNECTA_LOGGER__.info('AUTH', 'validate', 'Token validation response', {
            status: response.status,
            hasSuccess: data.success !== undefined,
            hasAuthValidated: data.authValidated !== undefined,
            hasValid: data.valid !== undefined,
            hasUser: !!data.user,
            responseKeys: Object.keys(data)
        });
        
        // Check for successful validation - handle multiple response formats
        let isValid = false;
        let userId = null;
        let user = null;
        
        // CASE 1: Response has authValidated = true
        if (data.authValidated === true || data.authValidated === 'true') {
            isValid = true;
            userId = data.user?.id || data.userId || null;
            user = data.user;
        }
        // CASE 2: Response has success = true and authValidated = true
        else if (data.success === true && data.authValidated === true) {
            isValid = true;
            userId = data.user?.id || data.userId || null;
            user = data.user;
        }
        // CASE 3: Response has valid = true
        else if (data.valid === true) {
            isValid = true;
            userId = data.user?.id || data.userId || null;
            user = data.user;
        }
        // CASE 4: Response has authenticated = true
        else if (data.authenticated === true) {
            isValid = true;
            userId = data.user?.id || data.userId || null;
            user = data.user;
        }
        // CASE 5: Response has user object with id (token is valid if user data present)
        else if (data.user && data.user.id) {
            isValid = true;
            userId = data.user.id;
            user = data.user;
            if (window.__KYNECTA_LOGGER__) window.__KYNECTA_LOGGER__.info('AUTH', 'validate', 'Token valid based on user data', { userId });
        }
        // CASE 6: Response has userId directly
        else if (data.userId && data.userId > 0) {
            isValid = true;
            userId = data.userId;
            user = { id: userId, username: data.username || 'User', email: data.email || '' };
            if (window.__KYNECTA_LOGGER__) window.__KYNECTA_LOGGER__.info('AUTH', 'validate', 'Token valid based on userId', { userId });
        }
        
        // If response status is 200 but validation flags are missing, log the actual response
        if (response.status === 200 && !isValid) {
            if (window.__KYNECTA_LOGGER__) window.__KYNECTA_LOGGER__.warn('AUTH', 'validate', 'Token validation returned 200 but no validation flags', {
                data: JSON.stringify(data).substring(0, 500)
            });
            
            // Try to extract user info if available
            if (data.id || data._id) {
                userId = data.id || data._id;
                isValid = true;
                user = { id: userId, username: data.username || data.name || 'User', email: data.email || '' };
                if (window.__KYNECTA_LOGGER__) window.__KYNECTA_LOGGER__.info('AUTH', 'validate', 'Extracted user from response', { userId });
            }
        }
        
        if (isValid && userId && userId > 0) {
            if (window.__KYNECTA_LOGGER__) window.__KYNECTA_LOGGER__.info('AUTH', 'validate', 'Token validation successful', {
                userId: userId,
                validated: true
            });
            
            return {
                valid: true,
                userId: window.__normalizeUserId ? window.__normalizeUserId(userId) : userId,
                user: user,
                expiresAt: data.expiresAt || data.expiry || (Date.now() + 3600000)
            };
        }
        
        // If response is 401 or validation failed
        if (response.status === 401) {
            if (window.__KYNECTA_LOGGER__) window.__KYNECTA_LOGGER__.warn('AUTH', 'validate', 'Token invalid/expired (401)');
            return { valid: false, reason: 'token_invalid', status: 401 };
        }
        
        // If response is 200 but validation failed
        if (window.__KYNECTA_LOGGER__) window.__KYNECTA_LOGGER__.warn('AUTH', 'validate', 'Token validation failed', { 
            status: response.status,
            responseData: data 
        });
        return { valid: false, reason: 'validation_failed', status: response.status, data: data };
        
    } catch (error) {
        if (window.__KYNECTA_LOGGER__) window.__KYNECTA_LOGGER__.error('AUTH', 'validate', 'Token validation error', { error: error.message });
        return { valid: false, reason: error.message };
    }
};

    // SINGLE GLOBAL AUTHORIZED FETCH FUNCTION - ALL API CALLS MUST USE THIS
    window.authorizedFetch = async function(url, options = {}) {
        // Get token from primary storage
        let token = localStorage.getItem('token');
        
        // Check alternative storage locations
        if (!token || token === 'undefined' || token === 'null') {
            token = localStorage.getItem('moodchat_token');
        }
        if (!token || token === 'undefined' || token === 'null') {
            const authData = localStorage.getItem('kynecta_auth');
            if (authData) {
                try {
                    const parsed = JSON.parse(authData);
                    if (parsed && parsed.token) {
                        token = parsed.token;
                    }
                } catch (e) {}
            }
        }
        
        if (!token || token === 'undefined' || token === 'null') {
            window.__KYNECTA_LOGGER__.error('AUTH', 'authorizedFetch', 'No token found in localStorage', { url });
            throw new Error('Missing authentication token');
        }
        
        // Ensure headers object exists
        const headers = {
            'Content-Type': 'application/json',
            ...(options.headers || {})
        };
        
        // STRICT: Authorization header MUST be Bearer <token>
        headers['Authorization'] = `Bearer ${token}`;
        
        let response;
        let attempt = 0;
        const MAX_ATTEMPTS = 2;
        
        while (attempt < MAX_ATTEMPTS) {
            try {
                response = await fetch(url, {
                    ...options,
                    headers: headers
                });
                
                // Handle 401 - token invalid/expired
                if (response.status === 401) {
                    window.__KYNECTA_LOGGER__.warn('AUTH', 'authorizedFetch', '401 Unauthorized', {
                        url: url,
                        attempt: attempt + 1
                    });
                    
                    if (attempt === 0) {
                        // First attempt - try to refresh token
                        const refreshResult = await attemptTokenRefresh();
                        
                        if (refreshResult.success && refreshResult.token) {
                            // Update token for retry
                            token = refreshResult.token;
                            headers['Authorization'] = `Bearer ${token}`;
                            attempt++;
                            continue;
                        } else {
                            // Refresh failed - trigger logout
                            window.__KYNECTA_LOGGER__.error('AUTH', 'authorizedFetch', 'Token refresh failed, triggering logout');
                            window.__triggerLogoutAndCleanup();
                            throw new Error('Authentication failed - please log in again');
                        }
                    } else {
                        // Second attempt also failed - logout
                        window.__KYNECTA_LOGGER__.error('AUTH', 'authorizedFetch', 'Token still invalid after refresh');
                        window.__triggerLogoutAndCleanup();
                        throw new Error('Authentication failed - please log in again');
                    }
                }
                
                // Success or other status - break the loop
                break;
                
            } catch (error) {
                if (attempt === MAX_ATTEMPTS - 1) {
                    throw error;
                }
                attempt++;
                await new Promise(resolve => setTimeout(resolve, 1000));
            }
        }
        
        if (response.ok) {
            window.__KYNECTA_LOGGER__.info('AUTH', 'authorizedFetch', `Request successful: ${url}`, {
                status: response.status
            });
        } else if (response.status !== 401) {
            window.__KYNECTA_LOGGER__.warn('AUTH', 'authorizedFetch', `Request returned status ${response.status}: ${url}`);
        }
        
        return response;
    };
    
    // Helper for safe API calls with automatic token injection
    window.__safeApiCall = async function(apiCallFn) {
        try {
            const result = await apiCallFn();
            return result;
        } catch (error) {
            window.__KYNECTA_LOGGER__.error('AUTH', 'safeApiCall', 'API call failed', { error: error.message });
            throw error;
        }
    };
    
    // Alias for backward compatibility
    window.__authorizedFetch = window.authorizedFetch;
    
    // Also expose to window.API if it exists later
    if (window.API) {
        window.API.authorizedFetch = window.authorizedFetch;
    }
    
    window.__KYNECTA_LOGGER__.info('AUTH', 'init', 'Enhanced authorizedFetch with refresh support initialized');
    
})();
</script>

<!-- ========== [FIXED] SESSION VALIDATION WITH BACKEND VERIFICATION ========== -->
<script>
(function() {
    'use strict';
    
    // Store validation state per session
    const validationCache = new Map();
    
    // ENHANCED VALIDATION WITH BACKEND VERIFICATION
    window.__validateSessionIntegrity = async function(session, allowRecovery = true) {
        if (!session || typeof session !== 'object') {
            window.__KYNECTA_LOGGER__.warn('AUTH', 'validate', 'Session validation failed: null or invalid object');
            return false;
        }
        
        // Token validation
        if (!session.token || typeof session.token !== 'string') {
            window.__KYNECTA_LOGGER__.warn('AUTH', 'validate', 'Session validation failed: missing or invalid token');
            return false;
        }
        
        if (session.token === 'undefined' || session.token === 'null' || session.token.length < 10) {
            window.__KYNECTA_LOGGER__.warn('AUTH', 'validate', 'Session validation failed: token is placeholder or too short');
            return false;
        }
        
        // Check cache to avoid repeated backend calls
        const cacheKey = `${session.token.substring(0, 20)}_${session.userId || ''}`;
        const cached = validationCache.get(cacheKey);
        
        if (cached && (Date.now() - cached.timestamp < 60000)) {
            window.__KYNECTA_LOGGER__.info('AUTH', 'validate', 'Using cached validation result', {
                valid: cached.valid,
                userId: session.userId
            });
            return cached.valid;
        }
        
        // CRITICAL: Validate with backend - this is the ONLY source of truth
        const validation = await window.__validateTokenWithBackend(session.token);
        
        // Store in cache
        validationCache.set(cacheKey, {
            valid: validation.valid,
            timestamp: Date.now(),
            userId: validation.userId
        });
        
        // Clean cache periodically
        if (validationCache.size > 50) {
            const now = Date.now();
            for (const [key, value] of validationCache.entries()) {
                if (now - value.timestamp > 300000) {
                    validationCache.delete(key);
                }
            }
        }
        
        if (!validation.valid) {
            window.__KYNECTA_LOGGER__.error('AUTH', 'validate', 'Backend validation failed', {
                reason: validation.reason,
                tokenPrefix: session.token.substring(0, 20)
            });
            
            // If validation fails and we have a token, try refresh once
            if (allowRecovery && session.token) {
                window.__KYNECTA_LOGGER__.info('AUTH', 'validate', 'Attempting token refresh after validation failure');
                const refreshResult = await window.__attemptTokenRefresh?.();
                
                if (refreshResult?.success && refreshResult.token) {
                    window.__KYNECTA_LOGGER__.info('AUTH', 'validate', 'Token refreshed, re-validating');
                    session.token = refreshResult.token;
                    
                    const reValidation = await window.__validateTokenWithBackend(session.token);
                    if (reValidation.valid) {
                        session.userId = reValidation.userId;
                        session.user = reValidation.user;
                        return true;
                    }
                }
            }
            
            return false;
        }
        
        // Update session with validated data
        if (validation.userId && validation.userId > 0) {
            session.userId = validation.userId;
            if (validation.user) {
                session.user = validation.user;
            } else if (!session.user) {
                session.user = { id: validation.userId, username: 'User', email: '' };
            } else if (session.user.id !== validation.userId) {
                session.user.id = validation.userId;
            }
        }
        
        return true;
    };
    
    // Helper to normalize userId from various shapes
    window.__normalizeUserId = function(input) {
        if (input === undefined || input === null) return null;
        
        // If it's a number, validate
        if (typeof input === 'number') {
            return isNaN(input) || input <= 0 ? null : input;
        }
        
        // If it's a string
        if (typeof input === 'string') {
            // Reject invalid fallback strings
            if (input === 'user' || input === 'User' || input === 'guest' || input === 'undefined' || input === 'null') {
                return null;
            }
            const num = Number(input);
            return isNaN(num) || num <= 0 ? null : num;
        }
        
        // If it's an object with id
        if (typeof input === 'object' && input !== null) {
            const id = input.id || input.userId;
            return window.__normalizeUserId(id);
        }
        
        return null;
    };
    
    // Safe JWT decoder - for informational purposes only, NOT for validation
    window.__safeDecodeJWT = function(token) {
        if (!token || typeof token !== 'string') return null;
        
        try {
            const parts = token.split('.');
            if (parts.length !== 3) return null;
            
            const payload = parts[1];
            const decoded = atob(payload.replace(/-/g, '+').replace(/_/g, '/'));
            const parsed = JSON.parse(decoded);
            
            return parsed;
        } catch (e) {
            return null;
        }
    };
    
    // Extract userId from JWT - FOR INFO ONLY, NOT VALIDATION
    window.__extractUserIdFromJWT = function(token) {
        const payload = window.__safeDecodeJWT(token);
        if (!payload) return null;
        
        const userId = payload.userId || payload.user_id || payload.id || payload.sub;
        
        if (userId) {
            const normalized = window.__normalizeUserId(userId);
            if (normalized && normalized > 0) {
                return normalized;
            }
        }
        
        return null;
    };
    
    window.__KYNECTA_LOGGER__.info('AUTH', 'init', 'Enhanced session validation with backend verification initialized');
    
})();
</script>

<!-- ========== [FIXED] TOKEN VALIDATION AND JWT DECODE UTILITIES ========== -->
<script>
(function() {
    'use strict';
    
    // Validate token with backend and recover userId - BACKEND IS SOURCE OF TRUTH
    window.__validateAndRecoverSession = async function(token, existingUserId = null) {
        if (!token) return { success: false, reason: 'no_token' };
        
        try {
            const validation = await window.__validateTokenWithBackend(token);
            
            if (validation.valid && validation.userId) {
                window.__KYNECTA_LOGGER__.info('SESSION', 'recover', 'Token validation successful', {
                    userId: validation.userId
                });
                
                return {
                    success: true,
                    userId: validation.userId,
                    user: validation.user,
                    validated: true
                };
            }
            
            // If validation fails, try refresh
            window.__KYNECTA_LOGGER__.info('SESSION', 'recover', 'Validation failed, attempting refresh');
            const refreshResult = await window.__attemptTokenRefresh?.();
            
            if (refreshResult?.success && refreshResult.token) {
                const reValidation = await window.__validateTokenWithBackend(refreshResult.token);
                if (reValidation.valid && reValidation.userId) {
                    return {
                        success: true,
                        userId: reValidation.userId,
                        user: reValidation.user,
                        validated: true,
                        refreshed: true
                    };
                }
            }
            
            return { success: false, reason: 'validation_failed' };
            
        } catch (error) {
            window.__KYNECTA_LOGGER__.error('SESSION', 'recover', 'Token validation error', { error: error.message });
            return { success: false, reason: error.message };
        }
    };
    
    window.__KYNECTA_LOGGER__.info('JWT', 'init', 'JWT utilities initialized (for info only)');
})();
</script>

<!-- ========== [FIXED] EARLY SESSION BOOTSTRAP (SYNCHRONOUS) ========== -->
<script>
(function() {
    'use strict';
    
    window.__PARENT_SESSION__ = {
        session: null,
        token: null,
        userId: null,
        authenticated: false,
        expiresAt: null,
        fromCache: false,
        loaded: false,
        sessionVersion: 0
    };
    
// Enhanced session reconstruction with validation
async function reconstructSessionFromStorage() {
    // Try to get unified auth first
    const authData = localStorage.getItem('kynecta_auth');
    if (authData) {
        try {
            const parsed = JSON.parse(authData);
            if (parsed && parsed.token) {
                // If already validated and has userId, use it
                if (parsed.validated === true && parsed.userId && parsed.userId > 0) {
                    if (window.__KYNECTA_LOGGER__) window.__KYNECTA_LOGGER__.info('parent', 'session_load', 'Using cached validated session', {
                        userId: parsed.userId
                    });
                    return {
                        token: parsed.token,
                        userId: parsed.userId,
                        user: parsed.user || { id: parsed.userId, username: 'User' },
                        expiry: parsed.expiry || (Date.now() + 3600000),
                        fromCache: true,
                        validated: true
                    };
                }
                
                // Otherwise validate with backend
                const validation = await window.__validateTokenWithBackend(parsed.token);
                
                if (validation.valid && validation.userId && validation.userId > 0) {
                    const user = validation.user || parsed.user || { id: validation.userId, username: 'User' };
                    if (user.id !== validation.userId) user.id = validation.userId;
                    
                    // Store validated data back with proper userId
                    const validatedAuth = {
                        token: parsed.token,
                        userId: validation.userId,
                        user: user,
                        expiry: validation.expiresAt || parsed.expiry || (Date.now() + 3600000),
                        timestamp: Date.now(),
                        validated: true
                    };
                    localStorage.setItem('kynecta_auth', JSON.stringify(validatedAuth));
                    
                    // Also ensure token is stored with correct key
                    localStorage.setItem('token', parsed.token);
                    
                    return {
                        token: parsed.token,
                        userId: validation.userId,
                        user: user,
                        expiry: validation.expiresAt || parsed.expiry || (Date.now() + 3600000),
                        fromCache: true,
                        validated: true
                    };
                } else {
                    if (window.__KYNECTA_LOGGER__) window.__KYNECTA_LOGGER__.warn('parent', 'session_load', 'Stored token invalid', {
                        reason: validation.reason
                    });
                }
            }
        } catch (e) {
            if (window.__KYNECTA_LOGGER__) window.__KYNECTA_LOGGER__.error('parent', 'session_load', 'Failed to parse auth data', { error: e.message });
        }
    }
    
    // Try direct token
    const directToken = localStorage.getItem('token');
    if (directToken && directToken !== 'undefined' && directToken !== 'null') {
        const validation = await window.__validateTokenWithBackend(directToken);
        
        if (validation.valid && validation.userId && validation.userId > 0) {
            const user = validation.user || { id: validation.userId, username: 'User' };
            
            // Store validated data
            const validatedAuth = {
                token: directToken,
                userId: validation.userId,
                user: user,
                expiry: validation.expiresAt || (Date.now() + 3600000),
                timestamp: Date.now(),
                validated: true
            };
            localStorage.setItem('kynecta_auth', JSON.stringify(validatedAuth));
            
            return {
                token: directToken,
                userId: validation.userId,
                user: user,
                expiry: validation.expiresAt || (Date.now() + 3600000),
                fromCache: true,
                validated: true
            };
        } else {
            if (window.__KYNECTA_LOGGER__) window.__KYNECTA_LOGGER__.warn('parent', 'session_load', 'Direct token invalid', {
                reason: validation.reason
            });
        }
    }
    
    return null;
}

    // Async session loading with validation
    async function loadSessionFromStorage() {
        const reconstructed = await reconstructSessionFromStorage();
        
        if (reconstructed && reconstructed.token && reconstructed.validated) {
            return reconstructed;
        }
        
        return null;
    }
    
    // Initialize session
    (async function() {
        try {
            const session = await loadSessionFromStorage();
            
            if (session && session.token) {
                const expiresAt = session.expiry || Date.now() + 3600000;
                
                window.__PARENT_SESSION__.session = {
                    authenticated: true,
                    userId: session.userId,
                    token: session.token,
                    user: session.user,
                    expiresAt: expiresAt,
                    timestamp: Date.now(),
                    sessionVersion: 0
                };
                window.__PARENT_SESSION__.token = session.token;
                window.__PARENT_SESSION__.userId = session.userId;
                window.__PARENT_SESSION__.authenticated = true;
                window.__PARENT_SESSION__.expiresAt = expiresAt;
                window.__PARENT_SESSION__.fromCache = session.fromCache || false;
                window.__PARENT_SESSION__.sessionVersion = 1;
                
                // Ensure storage consistency
                const authData = {
                    token: session.token,
                    userId: session.userId,
                    user: session.user,
                    expiry: expiresAt,
                    timestamp: Date.now(),
                    sessionVersion: 1,
                    validated: true
                };
                localStorage.setItem('kynecta_auth', JSON.stringify(authData));
                
                window.__KYNECTA_LOGGER__.info('parent', 'init', 'Session loaded from storage with validation', {
                    userId: session.userId,
                    userName: session.user?.username || session.user?.displayName
                });
            } else {
                window.__KYNECTA_LOGGER__.info('parent', 'init', 'No valid session found in storage');
            }
        } catch (e) {
            window.__KYNECTA_LOGGER__.error('parent', 'init', 'Error loading session', { error: e.message });
        }
        
        window.__PARENT_SESSION__.loaded = true;
    })();
    
    // Centralized token access
    window.__getAuthToken = function() {
        // First check direct localStorage (most reliable)
        const directToken = localStorage.getItem('token');
        if (directToken && directToken !== 'undefined' && directToken !== 'null' && directToken.length > 10) {
            return directToken;
        }
        
        // Check moodchat_token
        const moodchatToken = localStorage.getItem('moodchat_token');
        if (moodchatToken && moodchatToken !== 'undefined' && moodchatToken !== 'null' && moodchatToken.length > 10) {
            return moodchatToken;
        }
        
        // Check kynecta_auth
        const authData = localStorage.getItem('kynecta_auth');
        if (authData) {
            try {
                const parsed = JSON.parse(authData);
                if (parsed && parsed.token && parsed.token !== 'undefined' && parsed.token !== 'null') {
                    return parsed.token;
                }
            } catch (e) {}
        }
        
        if (window.__PARENT_SESSION__?.token) {
            return window.__PARENT_SESSION__.token;
        }
        
        return null;
    };
    
    // Enhanced token verification with backend
    window.__verifyAndRefreshToken = async function() {
        const token = window.__getAuthToken();
        if (!token) {
            window.__KYNECTA_LOGGER__.warn('parent', 'token', 'No token found for verification');
            return false;
        }
        
        const validation = await window.__validateTokenWithBackend(token);
        
        if (validation.valid) {
            window.__KYNECTA_LOGGER__.info('parent', 'token', 'Token is valid (backend confirmed)', {
                userId: validation.userId
            });
            
            // Update session with validated data
            if (validation.userId && validation.userId > 0) {
                window.__PARENT_SESSION__.userId = validation.userId;
                if (validation.user) {
                    window.__PARENT_SESSION__.user = validation.user;
                }
                
                const authData = {
                    token: token,
                    userId: validation.userId,
                    user: validation.user || window.__PARENT_SESSION__.user,
                    expiry: validation.expiresAt || (Date.now() + 3600000),
                    timestamp: Date.now(),
                    validated: true
                };
                localStorage.setItem('kynecta_auth', JSON.stringify(authData));
            }
            
            return true;
        }
        
        window.__KYNECTA_LOGGER__.warn('parent', 'token', 'Token invalid, attempting refresh');
        
        const refreshResult = await window.__attemptTokenRefresh?.();
        
        if (refreshResult?.success && refreshResult.token) {
            const reValidation = await window.__validateTokenWithBackend(refreshResult.token);
            
            if (reValidation.valid && reValidation.userId) {
                window.__KYNECTA_LOGGER__.info('parent', 'token', 'Token refreshed successfully', {
                    userId: reValidation.userId
                });
                
                window.__PARENT_SESSION__.token = refreshResult.token;
                window.__PARENT_SESSION__.userId = reValidation.userId;
                window.__PARENT_SESSION__.authenticated = true;
                window.__PARENT_SESSION__.user = reValidation.user;
                window.__PARENT_SESSION__.expiresAt = reValidation.expiresAt || (Date.now() + 3600000);
                window.__PARENT_SESSION__.sessionVersion = (window.__PARENT_SESSION__.sessionVersion || 0) + 1;
                
                const authData = {
                    token: refreshResult.token,
                    userId: reValidation.userId,
                    user: reValidation.user,
                    expiry: reValidation.expiresAt || (Date.now() + 3600000),
                    timestamp: Date.now(),
                    validated: true,
                    refreshed: true
                };
                localStorage.setItem('kynecta_auth', JSON.stringify(authData));
                localStorage.setItem('token', refreshResult.token);
                
                setTimeout(() => {
                    if (window.__broadcastSessionToModules) {
                        window.__broadcastSessionToModules();
                    }
                }, 100);
                
                return true;
            }
        }
        
        window.__KYNECTA_LOGGER__.error('parent', 'token', 'Token refresh failed, triggering logout');
        window.__triggerLogoutAndCleanup?.();
        return false;
    };
    
    // Enhanced authentication check
    window.__isAuthenticated = function() {
        const token = window.__getAuthToken();
        if (!token) return false;
        
        // Check if we have a valid session in PARENT_SESSION
        if (window.__PARENT_SESSION__?.authenticated && window.__PARENT_SESSION__.userId > 0) {
            return true;
        }
        
        // Check kynecta_auth
        const authData = localStorage.getItem('kynecta_auth');
        if (authData) {
            try {
                const parsed = JSON.parse(authData);
                if (parsed.validated && parsed.userId && parsed.userId > 0) {
                    return true;
                }
            } catch (e) {}
        }
        
        return false;
    };
    
    window.__syncTokenToApi = function(token) {
        if (!token) return false;
        if (window.__PARENT_SESSION__) {
            window.__PARENT_SESSION__.token = token;
            window.__PARENT_SESSION__.authenticated = true;
        }
        return true;
    };
    
    window.__getParentSession = function() {
        return window.__PARENT_SESSION__.session ? { ...window.__PARENT_SESSION__.session } : null;
    };
    
    window.__getParentToken = function() {
        return window.__getAuthToken();
    };
    
    window.__isParentAuthenticated = function() {
        return window.__isAuthenticated();
    };
    
    // Enhanced session data retrieval with backend validation
    window.__getSafeSessionData = function() {
        try {
            // Try direct token first
            const directToken = localStorage.getItem('token');
            if (directToken && directToken !== 'undefined' && directToken !== 'null') {
                // Check if we have validated auth data
                const authData = localStorage.getItem('kynecta_auth');
                if (authData) {
                    try {
                        const parsed = JSON.parse(authData);
                        if (parsed.validated && parsed.userId && parsed.userId > 0) {
                            return {
                                authenticated: true,
                                userId: parsed.userId,
                                token: directToken,
                                user: parsed.user || { id: parsed.userId, username: 'User' },
                                expiresAt: parsed.expiry || (Date.now() + 3600000),
                                sessionVersion: window.__PARENT_SESSION__?.sessionVersion || 0,
                                validated: true
                            };
                        }
                    } catch (e) {}
                }
                
                // No validated data, return with token but not authenticated
                return {
                    authenticated: false,
                    userId: null,
                    token: directToken,
                    user: null,
                    sessionVersion: 0,
                    needsValidation: true
                };
            }
            
            const authData = localStorage.getItem('kynecta_auth');
            if (authData) {
                const parsed = JSON.parse(authData);
                if (parsed && parsed.token && parsed.validated && parsed.userId && parsed.userId > 0) {
                    return {
                        authenticated: true,
                        userId: parsed.userId,
                        token: parsed.token,
                        user: parsed.user || { id: parsed.userId, username: 'User' },
                        expiresAt: parsed.expiry || (Date.now() + 3600000),
                        sessionVersion: window.__PARENT_SESSION__?.sessionVersion || 0,
                        validated: true
                    };
                }
            }
            
            return { authenticated: false, userId: null, token: null, user: null, sessionVersion: 0 };
        } catch (e) {
            window.__KYNECTA_LOGGER__.error('parent', 'getSession', 'Error reading session', { error: e.message });
            return { authenticated: false, userId: null, token: null, user: null, sessionVersion: 0 };
        }
    };
    
    window.__broadcastSessionToModules = function() {
        const sessionData = window.getFullSessionData ? window.getFullSessionData() : window.__getSafeSessionData();
        
        // CRITICAL: Validate before broadcasting
        if (!sessionData.authenticated || !sessionData.userId || sessionData.userId <= 0) {
            window.__KYNECTA_LOGGER__.warn('parent', 'broadcast', 'No valid session to broadcast');
            return;
        }
        
        const iframes = document.querySelectorAll('iframe');
        
        window.__KYNECTA_LOGGER__.info('parent', 'broadcast', 'Broadcasting session to iframes', {
            count: iframes.length,
            authenticated: sessionData.authenticated,
            userId: sessionData.userId,
            tokenPresent: !!sessionData.token
        });
        
        iframes.forEach(iframe => {
            if (iframe.contentWindow && iframe.id) {
                const targetOrigin = window.location.origin;
                const moduleName = iframe.id.replace('Iframe', '');
                try {
                    iframe.contentWindow.postMessage({
                        type: 'SESSION_DATA',
                        id: `session_broadcast_${Date.now()}_${iframe.id}`,
                        source: 'parent',
                        target: moduleName,
                        moduleId: moduleName,
                        payload: {
                            authenticated: true,
                            token: sessionData.token,
                            userId: sessionData.userId,
                            user: sessionData.user,
                            expiresAt: sessionData.expiresAt,
                            sessionVersion: sessionData.sessionVersion,
                            validated: true
                        },
                        timestamp: Date.now(),
                        sessionVersion: sessionData.sessionVersion
                    }, targetOrigin);
                    window.__KYNECTA_LOGGER__.info('parent', 'broadcast', `Sent session to ${moduleName}`);
                } catch (e) {
                    window.__KYNECTA_LOGGER__.error('parent', 'broadcast', 'Failed to send to iframe', {
                        iframeId: iframe.id,
                        error: e.message
                    });
                }
            }
        });
    };
    
    // Verify token on load
    setTimeout(async () => {
        if (window.__isAuthenticated()) {
            const isValid = await window.__verifyAndRefreshToken();
            if (isValid) {
                setTimeout(() => {
                    if (window.__broadcastSessionToModules) {
                        window.__broadcastSessionToModules();
                    }
                }, 500);
            } else {
                window.__KYNECTA_LOGGER__.warn('parent', 'init', 'Initial token validation failed');
            }
        }
    }, 1000);
    
})();
</script>

<!-- ========== [FIXED] TOKEN REFRESH AND 401 HANDLER ========== -->
<script>
(function() {
    'use strict';
    
    let refreshAttempts = 0;
    const MAX_REFRESH_ATTEMPTS = 3;
    let refreshLock = false;
    
    // Expose refresh function globally
    window.__attemptTokenRefresh = async function() {
        if (refreshLock) {
            window.__KYNECTA_LOGGER__.info('AUTH', 'refresh', 'Refresh already in progress, waiting');
            return { success: false, reason: 'already_in_progress' };
        }
        
        refreshLock = true;
        
        try {
            const refreshToken = localStorage.getItem('refresh_token');
            
            if (!refreshToken) {
                window.__KYNECTA_LOGGER__.warn('AUTH', 'refresh', 'No refresh token available');
                refreshLock = false;
                return { success: false, reason: 'no_refresh_token' };
            }
            
            if (refreshAttempts >= MAX_REFRESH_ATTEMPTS) {
                window.__KYNECTA_LOGGER__.error('AUTH', 'refresh', 'Max refresh attempts exceeded');
                refreshLock = false;
                window.__triggerLogoutAndCleanup?.();
                return { success: false, reason: 'max_attempts_exceeded' };
            }
            
            refreshAttempts++;
            
            const API_BASE = window.__getApiBase();
            const response = await fetch(`${API_BASE}/auth/refresh-token`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ refreshToken: refreshToken })
            });
            
            if (response.ok) {
                const data = await response.json();
                
                if (data.token) {
                    // Get existing user data
                    let userId = null;
                    let userData = null;
                    
                    const authData = localStorage.getItem('kynecta_auth');
                    if (authData) {
                        try {
                            const parsed = JSON.parse(authData);
                            userId = parsed.userId;
                            userData = parsed.user;
                        } catch (e) {}
                    }
                    
                    if (data.user && data.user.id) {
                        userId = data.user.id;
                        userData = data.user;
                    }
                    
                    if (!userId) {
                        window.__KYNECTA_LOGGER__.error('AUTH', 'refresh', 'No userId after refresh');
                        refreshLock = false;
                        return { success: false, reason: 'no_user_id' };
                    }
                    
                    // Update storage
                    localStorage.setItem('token', data.token);
                    localStorage.setItem('moodchat_token', data.token);
                    localStorage.setItem('accessToken', data.token);
                    
                    const updatedAuth = {
                        token: data.token,
                        userId: userId,
                        user: userData || { id: userId, username: 'User' },
                        expiry: Date.now() + 3600000,
                        timestamp: Date.now(),
                        validated: true,
                        refreshed: true
                    };
                    localStorage.setItem('kynecta_auth', JSON.stringify(updatedAuth));
                    
                    refreshAttempts = 0;
                    refreshLock = false;
                    
                    window.__KYNECTA_LOGGER__.info('AUTH', 'refresh', 'Token refresh successful', { userId });
                    
                    // Broadcast refreshed session
                    setTimeout(() => {
                        if (window.__broadcastSessionToModules) {
                            window.__broadcastSessionToModules();
                        }
                    }, 100);
                    
                    return { success: true, token: data.token, userId: userId };
                }
            }
            
            if (response.status === 401) {
                window.__KYNECTA_LOGGER__.warn('AUTH', 'refresh', 'Refresh token invalid');
                localStorage.removeItem('refresh_token');
            }
            
            refreshLock = false;
            return { success: false, reason: 'refresh_failed', status: response.status };
            
        } catch (error) {
            window.__KYNECTA_LOGGER__.error('AUTH', 'refresh', 'Refresh request failed', { error: error.message });
            refreshLock = false;
            return { success: false, reason: error.message };
        }
    };
    
    // Intercept 401 responses globally
    const originalFetch = window.fetch;
    window.fetch = async function(...args) {
        let response = await originalFetch(...args);
        
        if (response.status === 401) {
            window.__KYNECTA_LOGGER__.info('AUTH', 'fetch', '401 detected, attempting refresh');
            
            const refreshResult = await window.__attemptTokenRefresh();
            
            if (refreshResult.success && refreshResult.token) {
                // Retry original request with new token
                const newHeaders = {
                    ...(args[1]?.headers || {}),
                    'Authorization': `Bearer ${refreshResult.token}`
                };
                
                const retryOptions = {
                    ...(args[1] || {}),
                    headers: newHeaders
                };
                
                response = await originalFetch(args[0], retryOptions);
                
                if (response.ok) {
                    window.__KYNECTA_LOGGER__.info('AUTH', 'fetch', 'Request retry succeeded after refresh');
                }
            } else if (refreshResult.reason === 'no_refresh_token' || refreshResult.reason === 'refresh_failed') {
                window.__KYNECTA_LOGGER__.error('AUTH', 'fetch', 'Cannot refresh, triggering logout');
                window.__triggerLogoutAndCleanup?.();
            }
        }
        
        return response;
    };
    
    // Also update authorizedFetch
    if (window.authorizedFetch) {
        const originalAuthFetch = window.authorizedFetch;
        window.authorizedFetch = async function(url, options = {}) {
            let response = await originalAuthFetch(url, options);
            
            if (response.status === 401) {
                window.__KYNECTA_LOGGER__.info('AUTH', 'authorizedFetch', '401 detected, attempting refresh');
                const refreshResult = await window.__attemptTokenRefresh();
                
                if (refreshResult.success && refreshResult.token) {
                    response = await originalAuthFetch(url, options);
                } else if (refreshResult.reason === 'no_refresh_token' || refreshResult.reason === 'refresh_failed') {
                    window.__KYNECTA_LOGGER__.error('AUTH', 'authorizedFetch', 'Cannot refresh, triggering logout');
                    window.__triggerLogoutAndCleanup?.();
                }
            }
            
            return response;
        };
    }
    
    // Check token on load
    async function checkAndRefreshToken() {
        const token = localStorage.getItem('token');
        if (!token) {
            window.__KYNECTA_LOGGER__.info('AUTH', 'check', 'No token found');
            return;
        }
        
        const validation = await window.__validateTokenWithBackend(token);
        
        if (!validation.valid) {
            window.__KYNECTA_LOGGER__.warn('AUTH', 'check', 'Token invalid, attempting refresh');
            const refreshResult = await window.__attemptTokenRefresh();
            if (!refreshResult.success) {
                window.__KYNECTA_LOGGER__.error('AUTH', 'check', 'Token refresh failed');
            }
        } else {
            window.__KYNECTA_LOGGER__.info('AUTH', 'check', 'Token is valid');
        }
    }
    
    setTimeout(checkAndRefreshToken, 500);
    
})();
</script>

<!-- ========== [FIXED] RELIABLE MESSAGE BUS ========== -->
<script>
(function() {
    'use strict';
    
    // Module state constants
    const MODULE_STATES = {
        INIT: 'init',
        LOADING: 'loading',
        READY: 'ready',
        ACTIVE: 'active',
        ERROR: 'error',
        DEGRADED: 'degraded'
    };
    
    // Message queue per module
    const messageQueues = new Map();
    const moduleStates = new Map();
    const moduleRegistrations = new Map();
    
    // UUID generator
    function generateUUID() {
        return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function(c) {
            const r = Math.random() * 16 | 0;
            const v = c === 'x' ? r : (r & 0x3 | 0x8);
            return v.toString(16);
        });
    }
    
    // Generate request ID
    function generateRequestId() {
        return `req_${Date.now()}_${Math.random().toString(36).substr(2, 8)}_${Math.random().toString(36).substr(2, 4)}`;
    }
    
    // Message validation
    function validateMessage(message) {
        if (!message || typeof message !== 'object') {
            return { valid: false, reason: 'invalid_message_object' };
        }
        
        const requiredFields = ['type', 'timestamp'];
        for (const field of requiredFields) {
            if (message[field] === undefined) {
                return { valid: false, reason: `missing_${field}` };
            }
        }
        
        // Ensure requestId exists
        if (!message.requestId && !message.id) {
            message.requestId = generateRequestId();
        } else if (!message.requestId) {
            message.requestId = message.id;
        }
        
        // Ensure moduleId for routing
        if (!message.moduleId && message.target) {
            message.moduleId = message.target;
        }
        
        return { valid: true };
    }
    
    // Get module state
    function getModuleState(moduleId) {
        return moduleStates.get(moduleId) || { state: MODULE_STATES.INIT, ready: false, queue: [] };
    }
    
    // Set module state
    function setModuleState(moduleId, state, metadata) {
        const current = moduleStates.get(moduleId) || { state: MODULE_STATES.INIT, ready: false, queue: [] };
        current.state = state;
        if (metadata) Object.assign(current, metadata);
        moduleStates.set(moduleId, current);
        
        window.__KYNECTA_LOGGER__.info('message-bus', 'state', `Module ${moduleId} state: ${state}`, { metadata });
        
        // If module becomes ready, flush its queue
        if (state === MODULE_STATES.READY || state === MODULE_STATES.ACTIVE) {
            flushMessageQueue(moduleId);
        }
    }
    
    // Queue message for module
    function queueMessage(moduleId, message) {
        const state = getModuleState(moduleId);
        if (!state.queue) state.queue = [];
        state.queue.push({
            ...message,
            queuedAt: Date.now(),
            retryCount: 0
        });
        moduleStates.set(moduleId, state);
        
        window.__KYNECTA_LOGGER__.info('message-bus', message.requestId, `Queued message for ${moduleId}`, {
            type: message.type,
            queueSize: state.queue.length
        });
    }
    
    // Flush message queue for module
    function flushMessageQueue(moduleId) {
        const state = getModuleState(moduleId);
        if (!state.queue || state.queue.length === 0) return;
        
        const iframe = document.getElementById(`${moduleId}Iframe`);
        if (!iframe || !iframe.contentWindow) {
            window.__KYNECTA_LOGGER__.warn('message-bus', 'flush', `Cannot flush queue for ${moduleId}: iframe not ready`);
            return;
        }
        
        const targetOrigin = window.location.origin;
        const messages = [...state.queue];
        state.queue = [];
        moduleStates.set(moduleId, state);
        
        messages.forEach(message => {
            try {
                iframe.contentWindow.postMessage(message, targetOrigin);
                window.__KYNECTA_LOGGER__.info('message-bus', message.requestId, `Flushed message to ${moduleId}`, {
                    type: message.type
                });
            } catch (e) {
                window.__KYNECTA_LOGGER__.error('message-bus', message.requestId, `Failed to send queued message to ${moduleId}`, {
                    error: e.message
                });
                // Re-queue on failure
                queueMessage(moduleId, message);
            }
        });
    }
    
    // Send message to module (with queueing if not ready)
    function sendToModule(moduleId, message) {
        // Ensure required fields
        if (!message.requestId && !message.id) {
            message.requestId = generateRequestId();
        }
        if (!message.timestamp) {
            message.timestamp = Date.now();
        }
        if (!message.source) {
            message.source = 'parent';
        }
        if (!message.moduleId) {
            message.moduleId = moduleId;
        }
        
        // Validate message
        const validation = validateMessage(message);
        if (!validation.valid) {
            window.__KYNECTA_LOGGER__.error('message-bus', message.requestId, 'Invalid message', { reason: validation.reason });
            return false;
        }
        
        const iframe = document.getElementById(`${moduleId}Iframe`);
        const state = getModuleState(moduleId);
        
        // Check if module is ready
        const isReady = state.state === MODULE_STATES.READY || state.state === MODULE_STATES.ACTIVE;
        const iframeLoaded = iframe && iframe.contentWindow && iframe.src !== 'about:blank';
        
        if (isReady && iframeLoaded) {
            try {
                const targetOrigin = window.location.origin;
                iframe.contentWindow.postMessage(message, targetOrigin);
                window.__KYNECTA_LOGGER__.info('message-bus', message.requestId, `Sent to ${moduleId}`, {
                    type: message.type
                });
                return true;
            } catch (e) {
                window.__KYNECTA_LOGGER__.error('message-bus', message.requestId, `Send failed, queueing`, {
                    error: e.message
                });
                queueMessage(moduleId, message);
                return false;
            }
        } else {
            queueMessage(moduleId, message);
            window.__KYNECTA_LOGGER__.info('message-bus', message.requestId, `Queued for ${moduleId} (not ready)`, {
                type: message.type,
                state: state.state
            });
            return false;
        }
    }
    
    // Register module
    function registerModule(moduleId, iframeWindow, metadata) {
        const existing = moduleRegistrations.get(moduleId);
        if (existing && existing.registered && moduleStates.get(moduleId)?.state === MODULE_STATES.ACTIVE) {
            window.__KYNECTA_LOGGER__.info('message-bus', moduleId, 'Module already registered, skipping', metadata);
            return true;
        }
        
        moduleRegistrations.set(moduleId, {
            registered: true,
            registeredAt: Date.now(),
            window: iframeWindow,
            metadata: metadata || {}
        });
        
        setModuleState(moduleId, MODULE_STATES.READY, { ready: true, readyAt: Date.now() });
        
        window.__KYNECTA_LOGGER__.info('message-bus', moduleId, 'Module registered', metadata);
        
        // Send pending session if available - WITH VALIDATION
        const sessionData = window.__getSafeSessionData();
        if (sessionData.authenticated && sessionData.userId && sessionData.userId > 0) {
            sendToModule(moduleId, {
                type: 'SESSION_DATA',
                payload: sessionData,
                expectAck: false
            });
        }
        
        return true;
    }
    
    // Handle module error
    function markModuleError(moduleId, errorReason) {
        const state = getModuleState(moduleId);
        if (state.state === MODULE_STATES.ERROR) return;
        
        setModuleState(moduleId, MODULE_STATES.ERROR, { errorReason: errorReason, errorAt: Date.now() });
        
        window.__KYNECTA_LOGGER__.error('message-bus', moduleId, 'Module marked as ERROR', { reason: errorReason });
        
        // Clear message queue for errored module
        if (state.queue) {
            state.queue = [];
            moduleStates.set(moduleId, state);
        }
    }
    
    // Check if module is healthy
    function isModuleHealthy(moduleId) {
        const state = getModuleState(moduleId);
        return state.state !== MODULE_STATES.ERROR;
    }
    
    // Expose message bus API
    window.__KYNECTA_MESSAGE_BUS__ = {
        send: sendToModule,
        register: registerModule,
        setState: setModuleState,
        getState: getModuleState,
        markError: markModuleError,
        isHealthy: isModuleHealthy,
        flushQueue: flushMessageQueue,
        getQueues: () => {
            const queues = {};
            for (const [id, state] of moduleStates.entries()) {
                queues[id] = {
                    state: state.state,
                    queueSize: state.queue?.length || 0
                };
            }
            return queues;
        }
    };
    
    window.__KYNECTA_LOGGER__.info('message-bus', 'init', 'Message bus initialized');
})();
</script>

<!-- ========== [FIXED] SINGLE GLOBAL MESSAGE LISTENER (WITH BUS INTEGRATION) ========== -->
<script>
(function() {
    'use strict';

    // Track processed message IDs to prevent duplicates
    const processedMessageIds = new Set();
    const MAX_PROCESSED_IDS = 2000;
    
    // Track PARENT_READY sent per module to prevent duplicates
    const parentReadySent = new Map();

    // Map iframe ID to module name
    const IFRAME_ID_TO_MODULE = {
        'messagesIframe': 'messages',
        'statusIframe': 'status',
        'groupIframe': 'groups',
        'friendsIframe': 'friends',
        'callsIframe': 'calls',
        'settingsIframe': 'settings',
        'toolsIframe': 'tools'
    };

    const MODULE_TO_IFRAME_ID = {
        'messages': 'messagesIframe',
        'status': 'statusIframe',
        'groups': 'groupIframe',
        'friends': 'friendsIframe',
        'calls': 'callsIframe',
        'settings': 'settingsIframe',
        'tools': 'toolsIframe'
    };

    function getModuleNameFromIframeId(iframeId) {
        return IFRAME_ID_TO_MODULE[iframeId] || null;
    }

    function getIframeIdFromModuleName(moduleName) {
        return MODULE_TO_IFRAME_ID[moduleName] || null;
    }

    function isDuplicateMessageId(messageId) {
        if (!messageId) return false;
        if (processedMessageIds.has(messageId)) {
            return true;
        }
        processedMessageIds.add(messageId);
        if (processedMessageIds.size > MAX_PROCESSED_IDS) {
            const toRemove = Array.from(processedMessageIds).slice(0, 500);
            toRemove.forEach(id => processedMessageIds.delete(id));
        }
        return false;
    }
    
    function generateRequestId() {
        return `req_${Date.now()}_${Math.random().toString(36).substr(2, 8)}_${Math.random().toString(36).substr(2, 4)}`;
    }

    // Enhanced session retrieval with validation
    function getFullSessionData() {
        try {
            // Priority 1: Direct token from localStorage with validation
            const directToken = localStorage.getItem('token');
            if (directToken && directToken !== 'undefined' && directToken !== 'null') {
                // Check if we have validated auth data
                const authData = localStorage.getItem('kynecta_auth');
                if (authData) {
                    try {
                        const parsed = JSON.parse(authData);
                        if (parsed.validated && parsed.userId && parsed.userId > 0) {
                            return {
                                authenticated: true,
                                token: directToken,
                                tokenPresent: true,
                                userId: parsed.userId,
                                user: parsed.user || { id: parsed.userId, username: 'User' },
                                expiresAt: parsed.expiry || (Date.now() + 3600000),
                                sessionVersion: window.__PARENT_SESSION__?.sessionVersion || 0,
                                validated: true
                            };
                        }
                    } catch (e) {}
                }
                
                // No validated data - return with token but not authenticated
                return {
                    authenticated: false,
                    token: directToken,
                    tokenPresent: true,
                    userId: null,
                    user: null,
                    sessionVersion: 0,
                    needsValidation: true
                };
            }
            
            // Priority 2: kynecta_auth (unified storage)
            const authData = localStorage.getItem('kynecta_auth');
            if (authData) {
                const parsed = JSON.parse(authData);
                if (parsed && parsed.token && parsed.validated && parsed.userId && parsed.userId > 0) {
                    return {
                        authenticated: true,
                        token: parsed.token,
                        tokenPresent: true,
                        userId: parsed.userId,
                        user: parsed.user || { id: parsed.userId, username: 'User' },
                        expiresAt: parsed.expiry || (Date.now() + 3600000),
                        sessionVersion: window.__PARENT_SESSION__?.sessionVersion || 0,
                        validated: true
                    };
                }
            }
            
            return { authenticated: false, token: null, tokenPresent: false, userId: null, user: null, sessionVersion: 0 };
        } catch (e) {
            window.__KYNECTA_LOGGER__.error('parent', 'getSession', 'Error reading session', { error: e.message });
            return { authenticated: false, token: null, tokenPresent: false, userId: null, user: null, sessionVersion: 0 };
        }
    }

    // Ensure consistent session structure
    function normalizeSessionForModule(sessionData) {
        if (!sessionData) return { authenticated: false };
        
        // Ensure consistent structure across all modules
        const normalized = {
            authenticated: sessionData.authenticated === true,
            token: sessionData.token || null,
            userId: null,
            user: null,
            expiresAt: sessionData.expiresAt || null,
            sessionVersion: sessionData.sessionVersion || 0,
            validated: sessionData.validated || false
        };
        
        // Extract userId from various possible locations
        if (sessionData.userId && sessionData.userId > 0) {
            normalized.userId = sessionData.userId;
        } else if (sessionData.user && sessionData.user.id && sessionData.user.id > 0) {
            normalized.userId = sessionData.user.id;
        }
        
        // Ensure userId is a number
        if (normalized.userId && typeof normalized.userId === 'string') {
            normalized.userId = parseInt(normalized.userId, 10);
        }
        
        // Create user object if missing but we have userId
        if (normalized.userId && normalized.userId > 0 && !normalized.user) {
            normalized.user = {
                id: normalized.userId,
                username: 'User',
                email: '',
                displayName: 'User'
            };
        } else if (sessionData.user && normalized.userId) {
            normalized.user = {
                id: normalized.userId,
                username: sessionData.user.username || sessionData.user.name || 'User',
                email: sessionData.user.email || '',
                displayName: sessionData.user.displayName || sessionData.user.name || 'User',
                avatar: sessionData.user.avatar || null
            };
        }
        
        // Ensure token is present if authenticated
        if (normalized.authenticated && !normalized.token) {
            normalized.token = window.__getAuthToken();
        }
        
        return normalized;
    }
    
    // Override the session data sent to modules
    window.__getNormalizedSessionForModule = function() {
        const rawSession = getFullSessionData();
        return normalizeSessionForModule(rawSession);
    };

    // Enhanced API request handler with authorized fetch
    async function handleApiRequest(event, data, sourceWindow, origin) {
        // Extract payload
        let payload = data.payload || data;
        let requestId = payload.requestId || payload.messageId || generateRequestId();
        let endpoint = payload.endpoint;
        let method = payload.method || 'GET';
        let body = payload.body !== undefined ? payload.body : null;
        let headers = payload.headers || {};
        
        // Get source module
        const sourceModule = data.source || data.target || (data.moduleId ? data.moduleId : null);
        
        // Validate required fields
        if (!endpoint) {
            window.__KYNECTA_LOGGER__.warn('parent', requestId, 'API_REQUEST rejected: missing endpoint');
            if (sourceWindow) {
                sourceWindow.postMessage({
                    type: 'API_RESPONSE',
                    id: `api_err_${Date.now()}`,
                    requestId: requestId,
                    source: 'parent',
                    target: sourceModule || '*',
                    payload: { 
                        success: false, 
                        error: 'Missing endpoint',
                        requestId: requestId
                    },
                    timestamp: Date.now()
                }, origin);
            }
            return;
        }
        
        // Clean the endpoint
        let cleanEndpoint = endpoint.trim();
        while (cleanEndpoint.startsWith('/')) {
            cleanEndpoint = cleanEndpoint.substring(1);
        }
        while (cleanEndpoint.endsWith('/')) {
            cleanEndpoint = cleanEndpoint.slice(0, -1);
        }
        
        // Remove /api prefix if present
        if (cleanEndpoint.startsWith('api/')) {
            cleanEndpoint = cleanEndpoint.substring(4);
        } else if (cleanEndpoint === 'api') {
            cleanEndpoint = '';
        }
        
        const API_BASE = window.__getApiBase ? window.__getApiBase() : 'http://localhost:4000/api';
        const url = cleanEndpoint ? `${API_BASE}/${cleanEndpoint}` : API_BASE;
        
        window.__KYNECTA_LOGGER__.info('parent', requestId, `API_REQUEST → ${method} ${url}`, { sourceModule, originalEndpoint: endpoint });
        
        try {
            const token = window.__getAuthToken();
            
            if (!token) {
                window.__KYNECTA_LOGGER__.error('parent', requestId, 'No token available for API request');
                sourceWindow.postMessage({
                    type: 'API_RESPONSE',
                    id: `api_err_${requestId}`,
                    requestId: requestId,
                    source: 'parent',
                    target: sourceModule || '*',
                    payload: { 
                        success: false, 
                        error: 'Authentication required - no token available',
                        requestId: requestId
                    },
                    timestamp: Date.now()
                }, origin);
                return;
            }
            
            const fetchHeaders = {
                'Content-Type': 'application/json',
                ...headers
            };
            fetchHeaders['Authorization'] = `Bearer ${token}`;
            
            const controller = new AbortController();
            const timeoutId = setTimeout(() => controller.abort(), 30000);
            
            // CRITICAL: USE AUTHORIZED FETCH FOR ALL API CALLS
            const response = await window.authorizedFetch(url, {
                method,
                headers: fetchHeaders,
                body: body ? JSON.stringify(body) : undefined,
                signal: controller.signal
            });
            
            clearTimeout(timeoutId);
            
            let result;
            const contentType = response.headers.get('content-type');
            if (contentType && contentType.includes('application/json')) {
                result = await response.json();
            } else {
                const text = await response.text();
                try {
                    result = JSON.parse(text);
                } catch(e) {
                    result = { error: 'Invalid response', raw: text.substring(0, 200) };
                }
            }
            
            const responsePayload = {
                success: response.ok,
                data: result,
                status: response.status
            };
            
            if (!response.ok) {
                responsePayload.error = result.error || result.message || `HTTP ${response.status}`;
            }
            
            sourceWindow.postMessage({
                type: 'API_RESPONSE',
                id: `api_resp_${requestId}`,
                requestId: requestId,
                source: 'parent',
                target: sourceModule || '*',
                payload: responsePayload,
                timestamp: Date.now()
            }, origin);
            
            if (response.ok) {
                window.__KYNECTA_LOGGER__.info('parent', requestId, `API_RESPONSE success`);
            } else {
                window.__KYNECTA_LOGGER__.warn('parent', requestId, `API_RESPONSE error`, { status: response.status, error: responsePayload.error });
            }
        } catch (error) {
            window.__KYNECTA_LOGGER__.error('parent', requestId, `API_REQUEST failed`, { error: error.message });
            sourceWindow.postMessage({
                type: 'API_RESPONSE',
                id: `api_err_${requestId}`,
                requestId: requestId,
                source: 'parent',
                target: sourceModule || '*',
                payload: { 
                    success: false, 
                    error: error.message || 'API request failed',
                    requestId: requestId
                },
                timestamp: Date.now()
            }, origin);
        }
    }

    function sendParentReadyToModule(moduleName) {
        const iframeId = getIframeIdFromModuleName(moduleName);
        if (!iframeId) return false;
        
        const iframe = document.getElementById(iframeId);
        if (!iframe || !iframe.contentWindow) {
            setTimeout(() => sendParentReadyToModule(moduleName), 100);
            return false;
        }
        
        // Get token directly
        const token = window.__getAuthToken();
        if (!token) {
            window.__KYNECTA_LOGGER__.error('parent', moduleName, 'Cannot send PARENT_READY: No authentication token found');
            return false;
        }
        
        // Use normalized session data
        let sessionData = window.__getNormalizedSessionForModule();
        
        // If session is invalid, don't send
        if (!sessionData.authenticated || !sessionData.userId || sessionData.userId <= 0) {
            window.__KYNECTA_LOGGER__.warn('parent', moduleName, 'Cannot send PARENT_READY: No valid session');
            return false;
        }
        
        // CRITICAL: Ensure userId is present and valid
        if (!sessionData.userId || sessionData.userId <= 0) {
            window.__KYNECTA_LOGGER__.error('parent', moduleName, 'Cannot send PARENT_READY: Missing userId');
            return false;
        }
        
        // Ensure user object exists with correct ID
        if (!sessionData.user) {
            sessionData.user = {
                id: sessionData.userId,
                username: 'User',
                email: '',
                displayName: 'User'
            };
        } else if (sessionData.user.id !== sessionData.userId) {
            sessionData.user.id = sessionData.userId;
        }
        
        // Create message with proper format
        const message = {
            type: 'PARENT_READY',
            id: `parent_ready_${Date.now()}_${moduleName}`,
            source: 'parent',
            target: moduleName,
            module: moduleName,
            moduleId: moduleName,
            requestId: generateRequestId(),
            timestamp: Date.now(),
            payload: {
                protocol: 'KYN-8.0',
                state: 'READY',
                message: 'Module handshake complete',
                token: token,
                session: {
                    authenticated: sessionData.authenticated,
                    token: sessionData.token,
                    user: sessionData.user,
                    userId: sessionData.userId,
                    expiresAt: sessionData.expiresAt
                }
            }
        };
        
        // Use message bus for reliable delivery
        const result = window.__KYNECTA_MESSAGE_BUS__.send(moduleName, message);
        return result;
    }

    // Map iframe window references
    window.__iframeWindowMap = new WeakMap();

    // Update broadcastSessionData to use normalized session
    function broadcastSessionData() {
        const sessionData = window.__getNormalizedSessionForModule();
        
        if (!sessionData.authenticated || !sessionData.userId || sessionData.userId <= 0) {
            window.__KYNECTA_LOGGER__.info('parent', 'broadcastSession', 'No authenticated session to broadcast');
            return;
        }
        
        const iframes = document.querySelectorAll('iframe');
        iframes.forEach(iframe => {
            if (!iframe.contentWindow) return;
            const moduleName = iframe.id?.replace('Iframe', '');
            
            iframe.contentWindow.postMessage({
                type: 'SESSION_DATA',
                id: `session_data_${Date.now()}_${moduleName}`,
                source: 'parent',
                target: moduleName,
                moduleId: moduleName,
                requestId: generateRequestId(),
                payload: {
                    authenticated: sessionData.authenticated,
                    token: sessionData.token,
                    userId: sessionData.userId,
                    user: sessionData.user,
                    expiresAt: sessionData.expiresAt,
                    sessionVersion: sessionData.sessionVersion,
                    validated: true
                },
                timestamp: Date.now()
            }, window.location.origin);
        });
        
        window.__KYNECTA_LOGGER__.info('parent', 'broadcastSession', `Session broadcast to ${iframes.length} modules`, {
            userId: sessionData.userId
        });
    }

    // Call this after PARENT_READY
    setTimeout(() => {
        broadcastSessionData();
    }, 100);

    function registerIframeWindow(iframeId, iframeWindow) {
        if (iframeWindow && iframeWindow !== window) {
            window.__iframeWindowMap.set(iframeWindow, iframeId);
            window.__KYNECTA_LOGGER__.info('parent', 'register', `Registered ${iframeId}`);
        }
    }

    function getIframeIdFromSource(source) {
        if (window.__iframeWindowMap && window.__iframeWindowMap.has(source)) {
            return window.__iframeWindowMap.get(source);
        }
        
        const iframeIds = ['messagesIframe', 'statusIframe', 'groupIframe', 'friendsIframe', 'callsIframe', 'settingsIframe', 'toolsIframe'];
        for (const id of iframeIds) {
            const iframe = document.getElementById(id);
            if (iframe && iframe.contentWindow === source) {
                if (window.__iframeWindowMap) {
                    window.__iframeWindowMap.set(source, id);
                }
                return id;
            }
        }
        return null;
    }

    function setupIframeRegistration() {
        const iframeIds = ['messagesIframe', 'statusIframe', 'groupIframe', 'friendsIframe', 'callsIframe', 'settingsIframe', 'toolsIframe'];
        for (const id of iframeIds) {
            const iframe = document.getElementById(id);
            if (iframe) {
                if (iframe.contentWindow && iframe.contentWindow !== window) {
                    registerIframeWindow(id, iframe.contentWindow);
                }
                iframe.addEventListener('load', function() {
                    if (this.contentWindow && this.contentWindow !== window) {
                        registerIframeWindow(id, this.contentWindow);
                        const moduleName = getModuleNameFromIframeId(id);
                        if (moduleName) {
                            window.__KYNECTA_MESSAGE_BUS__.setState(moduleName, 'loading', { loadedAt: Date.now() });
                        }
                    }
                });
            }
        }
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', setupIframeRegistration);
        setTimeout(setupIframeRegistration, 0);
    } else {
        setupIframeRegistration();
    }

    // Main message handler
    function handleMessage(event) {
        // Origin validation: only accept same origin
        if (event.origin !== window.location.origin && event.origin !== 'null') {
            return;
        }
        
        if (!event.data || typeof event.data !== 'object') return;
        
        const data = event.data;
        
        const messageId = data.id || data.messageId || data.requestId;
        if (isDuplicateMessageId(messageId)) {
            return;
        }
        
        // Identify source iframe and module
        let iframeId = getIframeIdFromSource(event.source);
        let moduleName = null;
        
        if (iframeId) {
            moduleName = getModuleNameFromIframeId(iframeId);
        }
        
        if (!moduleName && data.module) {
            moduleName = data.module;
            iframeId = getIframeIdFromModuleName(moduleName);
        }
        
        if (!moduleName && data.source && data.source !== 'parent') {
            moduleName = data.source;
            iframeId = getIframeIdFromModuleName(moduleName);
        }
        
        // Handle CHILD_READY - register module with message bus
        if (data.type === 'CHILD_READY') {
            if (!moduleName) {
                window.__KYNECTA_LOGGER__.warn('parent', messageId, 'CHILD_READY missing moduleName');
                return;
            }
            
            const metadata = data.payload || {};
            window.__KYNECTA_MESSAGE_BUS__.register(moduleName, event.source, metadata);
            sendParentReadyToModule(moduleName);
            return;
        }
        
        // Handle API_REQUEST
        if (data.type === 'API_REQUEST') {
            handleApiRequest(event, data, event.source, event.origin);
            return;
        }
        
        // Handle VERIFY_SESSION
        if (data.type === 'VERIFY_SESSION') {
            const sessionData = getFullSessionData();
            try {
                event.source.postMessage({
                    type: 'VERIFY_RESPONSE',
                    id: `verify_resp_${messageId || Date.now()}`,
                    source: 'parent',
                    target: moduleName || data.source || '*',
                    payload: {
                        valid: sessionData.authenticated && sessionData.userId > 0,
                        userId: sessionData.userId,
                        token: sessionData.token ? 'present' : null,
                        user: sessionData.user
                    },
                    timestamp: Date.now()
                }, event.origin);
            } catch (e) {
                window.__KYNECTA_LOGGER__.error('parent', messageId, 'VERIFY_SESSION failed', { error: e.message });
            }
            return;
        }
        
        // Handle REQUEST_SESSION
        if (data.type === 'REQUEST_SESSION') {
            const sessionData = getFullSessionData();
            try {
                event.source.postMessage({
                    type: 'SESSION_RESPONSE',
                    id: `session_resp_${messageId || Date.now()}`,
                    source: 'parent',
                    target: moduleName || data.source || '*',
                    payload: sessionData,
                    timestamp: Date.now()
                }, event.origin);
            } catch (e) {
                window.__KYNECTA_LOGGER__.error('parent', messageId, 'REQUEST_SESSION failed', { error: e.message });
            }
            return;
        }
        
        // Handle PING
        if (data.type === 'PING') {
            try {
                event.source.postMessage({
                    type: 'PONG',
                    id: `pong_${messageId || Date.now()}`,
                    source: 'parent',
                    target: moduleName || '*',
                    payload: { timestamp: Date.now(), echo: data.payload },
                    timestamp: Date.now()
                }, event.origin);
            } catch (e) {
                window.__KYNECTA_LOGGER__.error('parent', messageId, 'PING response failed', { error: e.message });
            }
            return;
        }
        
        // Handle HEARTBEAT
        if (data.type === 'HEARTBEAT') {
            if (moduleName) {
                window.__KYNECTA_MESSAGE_BUS__.setState(moduleName, 'active', { lastHeartbeat: Date.now() });
            }
            try {
                event.source.postMessage({
                    type: 'HEARTBEAT_ACK',
                    id: `hb_ack_${messageId || Date.now()}`,
                    source: 'parent',
                    target: moduleName || '*',
                    payload: { timestamp: Date.now() },
                    timestamp: Date.now()
                }, event.origin);
            } catch (e) {
                window.__KYNECTA_LOGGER__.error('parent', messageId, 'HEARTBEAT response failed', { error: e.message });
            }
            return;
        }
        
        // Route all other messages through message bus with strict isolation
        if (moduleName && data.type && !data.type.startsWith('_')) {
            // Only route if module is healthy
            if (window.__KYNECTA_MESSAGE_BUS__.isHealthy(moduleName)) {
                // Forward to other modules if applicable
            }
        }
    }
    
    // Set up message listener (no override)
    window.removeEventListener('message', handleMessage);
    window.addEventListener('message', handleMessage);
    
    window.__GLOBAL_MESSAGE_LISTENER__ = true;
    
    // Storage event listener for session propagation - WITH DEBOUNCE AND VALIDATION
    let storageEventDebounceTimer = null;
    window.addEventListener('storage', function(event) {
        if (event.key === 'kynecta_auth' || event.key === 'moodchat_token' || event.key === 'moodchat_user' || event.key === 'token') {
            // Debounce to prevent loops
            if (storageEventDebounceTimer) clearTimeout(storageEventDebounceTimer);
            storageEventDebounceTimer = setTimeout(() => {
                // Increment session version
                if (window.__PARENT_SESSION__) {
                    window.__PARENT_SESSION__.sessionVersion = (window.__PARENT_SESSION__.sessionVersion || 0) + 1;
                }
                window.__KYNECTA_LOGGER__.info('parent', 'storage', 'Storage changed, broadcasting session');
                const sessionData = getFullSessionData();
                
                // Only broadcast if session is valid
                if (sessionData.authenticated && sessionData.userId && sessionData.userId > 0) {
                    const iframes = document.querySelectorAll('iframe');
                    iframes.forEach(iframe => {
                        if (iframe.contentWindow && iframe.id) {
                            const targetModule = getModuleNameFromIframeId(iframe.id);
                            if (targetModule && window.__KYNECTA_MESSAGE_BUS__.isHealthy(targetModule)) {
                                window.__KYNECTA_MESSAGE_BUS__.send(targetModule, {
                                    type: 'SESSION_DATA',
                                    id: `storage_session_${Date.now()}`,
                                    source: 'parent',
                                    target: targetModule,
                                    moduleId: targetModule,
                                    payload: sessionData,
                                    timestamp: Date.now(),
                                    sessionVersion: sessionData.sessionVersion
                                });
                            }
                        }
                    });
                }
            }, 100);
        }
    });
    
    // Expose reset function for module recovery
    window.__resetParentReadySent = function(moduleName) {
        parentReadySent.delete(moduleName);
    };
    
    // Expose the API handler globally
    window.__handleApiRequest = handleApiRequest;
    window.getFullSessionData = getFullSessionData;
})();
</script>

<!-- ========== [FIXED] DETERMINISTIC MODULE ORCHESTRATION LAYER ========== -->
<script>
(function() {
    'use strict';
    
    // VALID MODULE DEFINITIONS
    const VALID_MODULES = {
        'messagesIframe': { name: 'messages', container: 'messagesContent', src: 'message.html', critical: true },
        'statusIframe': { name: 'status', container: 'statusContent', src: 'status.html', critical: false },
        'groupIframe': { name: 'groups', container: 'groupContent', src: 'group.html', critical: false },
        'friendsIframe': { name: 'friends', container: 'friendsContent', src: 'friend.html', critical: false },
        'callsIframe': { name: 'calls', container: 'callsContent', src: 'calls.html', critical: false },
        'settingsIframe': { name: 'settings', container: 'settingsContent', src: 'settings.html', critical: false },
        'toolsIframe': { name: 'tools', container: 'toolsContent', src: 'Tools.html', critical: false }
    };
    
    // PERSISTENT MODULE REGISTRY
    const moduleRegistry = new Map();
    let parentIsReady = false;
    let parentReadyTimestamp = 0;
    
    function getModuleNameFromIframeId(iframeId) {
        return VALID_MODULES[iframeId]?.name || null;
    }
    
    function getOrCreateModuleEntry(iframeId) {
        if (moduleRegistry.has(iframeId)) {
            return moduleRegistry.get(iframeId);
        }
        
        const config = VALID_MODULES[iframeId];
        if (!config) return null;
        
        const entry = {
            iframeId: iframeId,
            moduleName: config.name,
            state: 'init',
            childReadyReceived: false,
            childReadyTimestamp: 0,
            parentReadySent: false,
            iframeLoaded: false,
            iframeLoadTimestamp: 0
        };
        
        moduleRegistry.set(iframeId, entry);
        return entry;
    }
    
    function markParentReadyAndBroadcast() {
        if (parentIsReady) {
            return;
        }
        
        // ENFORCE TOKEN AVAILABILITY AND VALIDITY BEFORE MARKING PARENT READY
        const token = localStorage.getItem('token');
        if (!token) {
            window.__KYNECTA_LOGGER__.error('parent', 'orchestration', 'Cannot mark parent ready: No authentication token found');
            return;
        }
        
        // Get session data
        let sessionData = window.getFullSessionData ? window.getFullSessionData() : window.__getSafeSessionData();
        
        // Validate the session data
        if (!sessionData.authenticated || !sessionData.userId || sessionData.userId <= 0) {
            window.__KYNECTA_LOGGER__.error('parent', 'orchestration', 'Cannot mark parent ready: Invalid session data');
            return;
        }
        
        window.__KYNECTA_LOGGER__.info('parent', 'orchestration', 'Marking parent as READY with valid token and userId', { userId: sessionData.userId });
        parentIsReady = true;
        parentReadyTimestamp = Date.now();
        
        window.__PARENT_READY_STATE__ = 'READY';
        window.__APP_STATE__ = 'ACTIVE';
        
        window.dispatchEvent(new CustomEvent('parentReady', {
            detail: { ready: true, timestamp: Date.now() }
        }));
        
        // Send PARENT_READY to all modules that have sent CHILD_READY
        for (const [iframeId, entry] of moduleRegistry.entries()) {
            if (entry.childReadyReceived && !entry.parentReadySent) {
                const moduleName = entry.moduleName;
                if (moduleName) {
                    window.__KYNECTA_MESSAGE_BUS__.send(moduleName, {
                        type: 'PARENT_READY',
                        id: `parent_ready_${Date.now()}_${moduleName}`,
                        source: 'parent',
                        target: moduleName,
                        moduleId: moduleName,
                        requestId: `parent_ready_${Date.now()}`,
                        timestamp: Date.now(),
                        payload: {
                            protocol: 'KYN-8.0',
                            state: 'READY',
                            message: 'Parent is ready',
                            token: token,
                            session: {
                                authenticated: true,
                                userId: sessionData.userId,
                                user: sessionData.user
                            }
                        }
                    });
                    entry.parentReadySent = true;
                }
            }
        }
    }
    
    function handleChildReady(iframeId, sourceWindow, origin, messageData) {
        if (!iframeId) {
            return false;
        }
        
        let entry = moduleRegistry.get(iframeId);
        if (!entry) {
            entry = getOrCreateModuleEntry(iframeId);
            if (!entry) return false;
        }
        
        const moduleNameFromMessage = messageData.module || messageData.payload?.module;
        if (moduleNameFromMessage && moduleNameFromMessage !== entry.moduleName) {
            entry.moduleName = moduleNameFromMessage;
        }
        
        if (entry.childReadyReceived) {
            return true;
        }
        
        entry.childReadyReceived = true;
        entry.childReadyTimestamp = Date.now();
        
        window.__KYNECTA_LOGGER__.info('parent', entry.moduleName, `CHILD_READY recorded for ${iframeId}`);
        
        if (parentIsReady && !entry.parentReadySent) {
            const token = localStorage.getItem('token');
            const sessionData = window.getFullSessionData ? window.getFullSessionData() : window.__getSafeSessionData();
            if (sessionData.authenticated && sessionData.userId > 0) {
                window.__KYNECTA_MESSAGE_BUS__.send(entry.moduleName, {
                    type: 'PARENT_READY',
                    id: `parent_ready_${Date.now()}_${entry.moduleName}`,
                    source: 'parent',
                    target: entry.moduleName,
                    moduleId: entry.moduleName,
                    requestId: `parent_ready_${Date.now()}`,
                    timestamp: Date.now(),
                    payload: {
                        protocol: 'KYN-8.0',
                        state: 'READY',
                        message: 'Module handshake complete',
                        token: token,
                        session: {
                            authenticated: true,
                            userId: sessionData.userId,
                            user: sessionData.user
                        }
                    }
                });
                entry.parentReadySent = true;
            }
        }
        
        return true;
    }
    
    function initOrchestration() {
        window.__KYNECTA_LOGGER__.info('parent', 'orchestration', 'Starting orchestration');
        
        for (const iframeId of Object.keys(VALID_MODULES)) {
            const iframe = document.getElementById(iframeId);
            if (iframe) {
                getOrCreateModuleEntry(iframeId);
                
                iframe.addEventListener('load', () => {
                    const entry = moduleRegistry.get(iframeId);
                    if (entry) {
                        entry.iframeLoaded = true;
                        entry.iframeLoadTimestamp = Date.now();
                        window.__KYNECTA_LOGGER__.info('parent', iframeId, 'Iframe loaded');
                    }
                });
            }
        }
        
        // Mark parent ready after a short delay (ensures iframes have time)
        setTimeout(() => {
            markParentReadyAndBroadcast();
        }, 2000);
        
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', () => {
                setTimeout(() => {
                    if (!parentIsReady) {
                        markParentReadyAndBroadcast();
                    }
                }, 500);
            });
        } else {
            setTimeout(() => {
                if (!parentIsReady) {
                    markParentReadyAndBroadcast();
                }
            }, 500);
        }
        
        window.__ModuleOrchestration = {
            getState: (iframeId) => {
                const entry = moduleRegistry.get(iframeId);
                return entry ? {
                    state: entry.state,
                    childReadyReceived: entry.childReadyReceived,
                    parentReadySent: entry.parentReadySent
                } : null;
            },
            getAllStates: () => {
                const states = {};
                for (const [iframeId, entry] of moduleRegistry.entries()) {
                    states[iframeId] = {
                        moduleName: entry.moduleName,
                        childReadyReceived: entry.childReadyReceived,
                        parentReadySent: entry.parentReadySent
                    };
                }
                return states;
            },
            isParentReady: () => parentIsReady,
            markParentReady: markParentReadyAndBroadcast,
            handleChildReady: handleChildReady
        };
    }
    
    window.forceParentReady = function() {
        const token = localStorage.getItem('token');
        if (!token) {
            window.__KYNECTA_LOGGER__.error('parent', 'forceParentReady', 'Cannot force parent ready: No token');
            return false;
        }
        const sessionData = window.getFullSessionData ? window.getFullSessionData() : window.__getSafeSessionData();
        if (!sessionData.authenticated || !sessionData.userId || sessionData.userId <= 0) {
            window.__KYNECTA_LOGGER__.error('parent', 'forceParentReady', 'Cannot force parent ready: Invalid session');
            return false;
        }
        markParentReadyAndBroadcast();
        return true;
    };
    
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initOrchestration);
    } else {
        initOrchestration();
    }
    
    // Listen for storage changes - WITH VALIDATION
    let storageDebounceTimer = null;
    window.addEventListener('storage', function(event) {
        if (event.key === 'kynecta_auth' || event.key === 'kynecta_token' || event.key === 'kynecta_user' || event.key === 'moodchat_token' || event.key === 'token') {
            if (storageDebounceTimer) clearTimeout(storageDebounceTimer);
            storageDebounceTimer = setTimeout(() => {
                window.__KYNECTA_LOGGER__.info('parent', 'storage', 'Session storage changed, broadcasting to modules');
                if (window.__broadcastSessionToModules) {
                    window.__broadcastSessionToModules();
                }
            }, 100);
        }
    });
    
    setTimeout(function() {
        if (window.__getSafeSessionData) {
            const sessionData = window.__getSafeSessionData();
            if (sessionData.authenticated && sessionData.userId && sessionData.userId > 0) {
                if (window.__broadcastSessionToModules) {
                    window.__broadcastSessionToModules();
                }
            }
        }
    }, 1000);
    
})();
</script>

<script>
// Fix session broadcast - ensure session is properly set after validation
(function fixSessionBroadcast() {
    // Override the session check to ensure it uses validated data
    const originalGetSafeSessionData = window.__getSafeSessionData;
    if (originalGetSafeSessionData) {
        window.__getSafeSessionData = function() {
            const result = originalGetSafeSessionData();
            
            // If result shows no authenticated but we have a token, try to fix
            if (!result.authenticated) {
                const token = localStorage.getItem('token') || localStorage.getItem('moodchat_token');
                const authData = localStorage.getItem('kynecta_auth');
                
                if (token && authData) {
                    try {
                        const parsed = JSON.parse(authData);
                        if (parsed.validated && parsed.userId && parsed.userId > 0) {
                            return {
                                authenticated: true,
                                userId: parsed.userId,
                                token: token,
                                user: parsed.user || { id: parsed.userId, username: 'User' },
                                expiresAt: parsed.expiry || (Date.now() + 3600000),
                                sessionVersion: window.__PARENT_SESSION__?.sessionVersion || 0,
                                validated: true
                            };
                        }
                    } catch(e) {}
                }
            }
            return result;
        };
    }
    
    // Ensure session is broadcast after a short delay
    setTimeout(() => {
        if (window.__propagateSessionToIframes__) {
            console.log('📡 Forcing session broadcast to iframes...');
            window.__propagateSessionToIframes__();
        }
    }, 500);
})();
</script>
<!-- ========== SYSTEM 1: EVENT BUS ========== -->
<script>
(function() {
    'use strict';

    class EventBus {
        constructor() {
            this._events = new Map();
            this._wildcardListeners = new Set();
            this._history = [];
            this._maxHistory = 100;
            this._stats = {
                emitted: 0,
                handled: 0,
                dropped: 0
            };
            this._initialized = false;
        }

        init() {
            if (this._initialized) return this;
            this._initialized = true;
            return this;
        }

        on(event, listener) {
            if (event === '*') {
                this._wildcardListeners.add(listener);
                return () => this._wildcardListeners.delete(listener);
            }

            if (!this._events.has(event)) {
                this._events.set(event, new Set());
            }
            
            this._events.get(event).add(listener);
            
            return () => {
                if (this._events.has(event)) {
                    this._events.get(event).delete(listener);
                }
            };
        }

        once(event, listener) {
            const wrapper = (payload) => {
                this.off(event, wrapper);
                listener(payload);
            };
            return this.on(event, wrapper);
        }

        off(event, listener) {
            if (this._events.has(event)) {
                this._events.get(event).delete(listener);
            }
        }

        emit(event, payload = {}, options = {}) {
            this._stats.emitted++;
            
            this._history.push({
                event,
                payload,
                timestamp: Date.now()
            });
            
            if (this._history.length > this._maxHistory) {
                this._history.shift();
            }

            let handled = false;

            this._wildcardListeners.forEach(listener => {
                try {
                    listener(event, payload);
                    this._stats.handled++;
                    handled = true;
                } catch (error) {
                    this._stats.dropped++;
                    window.__KYNECTA_LOGGER__.error('eventbus', event, 'Listener error', { error: error.message });
                }
            });

            if (this._events.has(event)) {
                this._events.get(event).forEach(listener => {
                    try {
                        listener(payload);
                        this._stats.handled++;
                        handled = true;
                    } catch (error) {
                        this._stats.dropped++;
                        window.__KYNECTA_LOGGER__.error('eventbus', event, 'Listener error', { error: error.message });
                    }
                });
            }

            return handled;
        }

        getStats() {
            return {
                ...this._stats,
                listeners: Array.from(this._events.entries()).map(([event, listeners]) => ({
                    event,
                    count: listeners.size
                })),
                wildcardListeners: this._wildcardListeners.size,
                historyLength: this._history.length
            };
        }

        clear() {
            this._events.clear();
            this._wildcardListeners.clear();
        }

        getHistory(limit = 10) {
            return this._history.slice(-limit);
        }
    }

    window.KynectaEventBus = new EventBus().init();
})();
</script>

<!-- ========== SYSTEM 2: STATE STORE ========== -->
<script>
(function() {
    'use strict';

    class StateStore {
        constructor() {
            this._state = {};
            this._subscribers = new Map();
            this._history = [];
            this._maxHistory = 50;
            this._frozen = false;
            this._initialized = false;
        }

        init() {
            if (this._initialized) return this;
            this._initialized = true;
            
            if (window.__PARENT_SESSION__?.session) {
                this.set('session', window.__PARENT_SESSION__.session);
            }
            
            return this;
        }

        get(path, defaultValue = null) {
            if (!path) return this._state;
            
            const parts = path.split('.');
            let current = this._state;
            
            for (const part of parts) {
                if (current === undefined || current === null) {
                    return defaultValue;
                }
                current = current[part];
            }
            
            return current !== undefined ? current : defaultValue;
        }

        set(path, value, options = {}) {
            if (this._frozen && !options.force) {
                return false;
            }

            const oldValue = this.get(path);
            
            if (oldValue === value && !options.force) {
                return true;
            }

            const parts = path.split('.');
            const lastPart = parts.pop();
            let current = this._state;
            
            for (const part of parts) {
                if (!current[part] || typeof current[part] !== 'object') {
                    current[part] = {};
                }
                current = current[part];
            }
            
            current[lastPart] = value;
            
            this._history.push({
                path,
                oldValue,
                newValue: value,
                timestamp: Date.now()
            });
            
            if (this._history.length > this._maxHistory) {
                this._history.shift();
            }

            this._notifySubscribers(path, value, oldValue);

            if (window.KynectaEventBus) {
                window.KynectaEventBus.emit('STATE_CHANGED', {
                    path,
                    value,
                    oldValue,
                    timestamp: Date.now()
                });
            }

            return true;
        }

        update(path, updater, options = {}) {
            const current = this.get(path);
            const newValue = updater(current);
            this.set(path, newValue, options);
            return newValue;
        }

        subscribe(path, listener) {
            if (!this._subscribers.has(path)) {
                this._subscribers.set(path, new Set());
            }
            
            this._subscribers.get(path).add(listener);
            
            const currentValue = this.get(path);
            if (currentValue !== null) {
                setTimeout(() => {
                    listener(currentValue, undefined, path);
                }, 0);
            }
            
            return () => {
                if (this._subscribers.has(path)) {
                    this._subscribers.get(path).delete(listener);
                }
            };
        }

        _notifySubscribers(path, newValue, oldValue) {
            if (this._subscribers.has(path)) {
                this._subscribers.get(path).forEach(listener => {
                    try {
                        listener(newValue, oldValue, path);
                    } catch (error) {
                        window.__KYNECTA_LOGGER__.error('store', path, 'Subscriber error', { error: error.message });
                    }
                });
            }

            const parts = path.split('.');
            while (parts.length > 1) {
                parts.pop();
                const parentPath = parts.join('.');
                
                if (this._subscribers.has(parentPath)) {
                    const parentValue = this.get(parentPath);
                    this._subscribers.get(parentPath).forEach(listener => {
                        try {
                            listener(parentValue, undefined, parentPath);
                        } catch (error) {
                            window.__KYNECTA_LOGGER__.error('store', parentPath, 'Subscriber error', { error: error.message });
                        }
                    });
                }
            }

            if (this._subscribers.has('*')) {
                this._subscribers.get('*').forEach(listener => {
                    try {
                        listener(newValue, oldValue, path);
                    } catch (error) {
                        window.__KYNECTA_LOGGER__.error('store', '*', 'Wildcard subscriber error', { error: error.message });
                    }
                });
            }
        }

        freeze() {
            this._frozen = true;
        }

        unfreeze() {
            this._frozen = false;
        }

        getAll() {
            return { ...this._state };
        }

        clear() {
            this._state = {};
            this._subscribers.clear();
        }

        getStats() {
            return {
                subscribers: Array.from(this._subscribers.entries()).map(([path, listeners]) => ({
                    path,
                    count: listeners.size
                })),
                historyLength: this._history.length,
                frozen: this._frozen
            };
        }
    }

    window.KynectaStore = new StateStore().init();
})();
</script>

<!-- ========== SYSTEM 3: API SERVICE LAYER (WITH AUTHORIZED FETCH) ========== -->
<script>
(function() {
    'use strict';

    // Use the already detected Environment from earlier
    const Environment = window.Environment || {
        type: 'LOCAL_DEV',
        isLocal: true,
        isProduction: false,
        apiBaseUrl: window.__getApiBase ? window.__getApiBase() : 'http://localhost:4000/api',
        wsBaseUrl: window.__getWsBase ? window.__getWsBase() : 'ws://localhost:4000/ws',
        
        detect: function() {
            // Already detected earlier, just return
            return this;
        },
        
        get: function() {
            return {
                type: this.type,
                isLocal: this.isLocal,
                isProduction: this.isProduction,
                apiBaseUrl: this.apiBaseUrl,
                wsBaseUrl: this.wsBaseUrl,
                timestamp: Date.now()
            };
        }
    };
    
    // Ensure Environment is properly set
    window.Environment = Environment;

    // Base API class with authorized fetch
    class BaseApiService {
        constructor() {
            this._initialized = false;
        }

        async request(endpoint, options = {}) {
            const API_BASE = Environment.apiBaseUrl;
            const url = endpoint.startsWith('http') ? endpoint : `${API_BASE}/${endpoint.replace(/^\//, '')}`;
            
            // Use authorizedFetch for all API calls
            const response = await window.authorizedFetch(url, {
                ...options,
                headers: {
                    'Content-Type': 'application/json',
                    ...(options.headers || {})
                }
            });
            
            const data = await response.json();
            return { success: response.ok, data, status: response.status };
        }

        async get(endpoint, options = {}) {
            return this.request(endpoint, { ...options, method: 'GET' });
        }

        async post(endpoint, body, options = {}) {
            return this.request(endpoint, { ...options, method: 'POST', body: JSON.stringify(body) });
        }

        async put(endpoint, body, options = {}) {
            return this.request(endpoint, { ...options, method: 'PUT', body: JSON.stringify(body) });
        }

        async delete(endpoint, options = {}) {
            return this.request(endpoint, { ...options, method: 'DELETE' });
        }
    }

    class MessageService extends BaseApiService {
        constructor() {
            super();
        }

        async getMessages(conversationId, options = {}) {
            return this.get(`/messages/${conversationId}`, options);
        }

        async sendMessage(message) {
            return this.post('/messages', message);
        }

        async getConversations() {
            return this.get('/chats');
        }

        async markAsRead(conversationId, messageIds) {
            return this.post(`/messages/read/${conversationId}`, { messageIds });
        }

        async deleteMessage(messageId) {
            return this.delete(`/messages/${messageId}`);
        }

        async reactToMessage(messageId, reaction) {
            return this.post(`/messages/${messageId}/react`, { reaction });
        }
    }

    class FriendService extends BaseApiService {
        constructor() {
            super();
        }

        async getFriends() {
            return this.get('/friends');
        }

        async getFriendRequests() {
            return this.get('/friends/requests');
        }

        async sendFriendRequest(userId) {
            return this.post('/friends/request', { userId });
        }

        async acceptFriendRequest(requestId) {
            return this.post(`/friends/accept/${requestId}`, {});
        }

        async rejectFriendRequest(requestId) {
            return this.post(`/friends/reject/${requestId}`, {});
        }

        async removeFriend(friendId) {
            return this.delete(`/friends/${friendId}`);
        }

        async blockUser(userId) {
            return this.post('/friends/block', { userId });
        }

        async getOnlineStatus() {
            return this.get('/friends/online');
        }
    }

    class GroupService extends BaseApiService {
        constructor() {
            super();
        }

        async getGroups() {
            return this.get('/group');
        }

        async getGroup(groupId) {
            return this.get(`/groups/${groupId}`);
        }

        async createGroup(groupData) {
            return this.post('/groups', groupData);
        }

        async updateGroup(groupId, groupData) {
            return this.put(`/groups/${groupId}`, groupData);
        }

        async deleteGroup(groupId) {
            return this.delete(`/groups/${groupId}`);
        }

        async addMember(groupId, userId) {
            return this.post(`/groups/${groupId}/members`, { userId });
        }

        async removeMember(groupId, userId) {
            return this.delete(`/groups/${groupId}/members/${userId}`);
        }

        async getGroupMessages(groupId, options = {}) {
            return this.get(`/groups/${groupId}/messages`, options);
        }

        async sendGroupMessage(groupId, message) {
            return this.post(`/groups/${groupId}/messages`, message);
        }
    }

    class StatusService extends BaseApiService {
        constructor() {
            super();
        }

        async getStatusUpdates() {
            return this.get('/status');
        }

        async postStatus(status) {
            return this.post('/status', status);
        }

        async deleteStatus(statusId) {
            return this.delete(`/status/${statusId}`);
        }

        async reactToStatus(statusId, reaction) {
            return this.post(`/status/${statusId}/react`, { reaction });
        }

        async getUserStatus(userId) {
            return this.get(`/status/user/${userId}`);
        }
    }

    class CallService extends BaseApiService {
        constructor() {
            super();
        }

        async initiateCall(targetUserId, callType = 'audio') {
            return this.post('/calls/initiate', { targetUserId, callType });
        }

        async acceptCall(callId) {
            return this.post(`/calls/${callId}/accept`, {});
        }

        async rejectCall(callId) {
            return this.post(`/calls/${callId}/reject`, {});
        }

        async endCall(callId) {
            return this.post(`/calls/${callId}/end`, {});
        }

        async getCallHistory() {
            return this.get('/calls/history');
        }

        async getCall(callId) {
            return this.get(`/calls/${callId}`);
        }
    }

    class SettingsService extends BaseApiService {
        constructor() {
            super();
        }

        async getSettings() {
            return this.get('/settings');
        }

        async updateSettings(settings) {
            return this.put('/settings', settings);
        }

        async getNotificationSettings() {
            return this.get('/settings/notifications');
        }

        async updateNotificationSettings(settings) {
            return this.put('/settings/notifications', settings);
        }

        async getPrivacySettings() {
            return this.get('/settings/privacy');
        }

        async updatePrivacySettings(settings) {
            return this.put('/settings/privacy', settings);
        }

        async getBlockedUsers() {
            return this.get('/settings/blocks');
        }

        async changePassword(currentPassword, newPassword) {
            return this.post('/settings/change-password', {
                currentPassword,
                newPassword
            });
        }
    }

    function initializeServices() {
        window.MessageService = new MessageService();
        window.FriendService = new FriendService();
        window.GroupService = new GroupService();
        window.StatusService = new StatusService();
        window.CallService = new CallService();
        window.SettingsService = new SettingsService();

        // Create API wrapper for backward compatibility
        window.API = {
            ...window.API,
            authorizedFetch: window.authorizedFetch,
            request: async (endpoint, options = {}) => {
                const API_BASE = Environment.apiBaseUrl;
                const url = endpoint.startsWith('http') ? endpoint : `${API_BASE}/${endpoint.replace(/^\//, '')}`;
                const response = await window.authorizedFetch(url, options);
                const data = await response.json();
                return { success: response.ok, data, status: response.status };
            },
            get: (endpoint, options) => window.API.request(endpoint, { ...options, method: 'GET' }),
            post: (endpoint, body, options) => window.API.request(endpoint, { ...options, method: 'POST', body: JSON.stringify(body) }),
            put: (endpoint, body, options) => window.API.request(endpoint, { ...options, method: 'PUT', body: JSON.stringify(body) }),
            delete: (endpoint, options) => window.API.request(endpoint, { ...options, method: 'DELETE' }),
            getUserToken: () => localStorage.getItem('token'),
            setUserToken: (token) => {
                if (token) localStorage.setItem('token', token);
            }
        };

        if (window.KynectaEventBus) {
            window.KynectaEventBus.emit('API_SERVICES_READY', { timestamp: Date.now() });
        }
        
        if (window.__KYNECTA_LOGGER__) {
            window.__KYNECTA_LOGGER__.info('API', 'init', 'API services initialized with authorized fetch');
        }
    }

    // Wait for authorizedFetch to be available
    if (window.authorizedFetch) {
        initializeServices();
    } else {
        const checkInterval = setInterval(() => {
            if (window.authorizedFetch) {
                clearInterval(checkInterval);
                initializeServices();
            }
        }, 100);
    }
})();
</script>

<!-- ========== SYSTEM 4: REALTIME COMMUNICATION ========== -->
<script>
(function() {
    'use strict';

    class RealtimeManager {
        constructor() {
            this._socket = null;
            this._connected = false;
            this._connecting = false;
            this._reconnectAttempts = 0;
            this._maxReconnectAttempts = 5;
            this._reconnectDelay = 1000;
            this._messageQueue = [];
            this._eventListeners = new Map();
            this._pingInterval = null;
            this._pongTimeout = null;
            this._lastPing = 0;
            this._connectionId = null;
            this._authenticated = false;
            this._initialized = false;
        }

        init() {
            if (this._initialized) return this;
            this._initialized = true;
            return this;
        }

        connect() {
            if (this._connected) return Promise.resolve();
            if (this._connecting) return this._connectionPromise;

            const token = window.__getAuthToken();
            if (!token) {
                return Promise.reject(new Error('No authentication token'));
            }

            this._connecting = true;
            this._connectionPromise = new Promise((resolve, reject) => {
                try {
                    const wsUrl = window.Environment.wsBaseUrl;
                    this._socket = new WebSocket(wsUrl);

                    this._socket.onopen = () => {
                        this._connected = true;
                        this._connecting = false;
                        this._reconnectAttempts = 0;
                        this._connectionId = `conn_${Date.now()}_${Math.random().toString(36).substr(2, 8)}`;

                        this.send('AUTHENTICATE', { token });

                        while (this._messageQueue.length > 0) {
                            const queued = this._messageQueue.shift();
                            this._socket.send(JSON.stringify(queued));
                        }

                        this._startPing();

                        window.KynectaEventBus?.emit('REALTIME_CONNECTED', {
                            connectionId: this._connectionId
                        });

                        resolve();
                    };

                    this._socket.onmessage = (event) => {
                        try {
                            const data = JSON.parse(event.data);
                            this._handleMessage(data);
                        } catch (error) {
                            window.__KYNECTA_LOGGER__.error('realtime', 'message', 'Failed to parse message', { error: error.message });
                        }
                    };

                    this._socket.onerror = (error) => {
                        window.KynectaEventBus?.emit('REALTIME_ERROR', { error });
                        window.__KYNECTA_LOGGER__.error('realtime', 'error', 'WebSocket error', { error });
                        
                        if (!this._connected) {
                            reject(error);
                        }
                    };

                    this._socket.onclose = () => {
                        const wasConnected = this._connected;
                        
                        this._connected = false;
                        this._authenticated = false;
                        this._connecting = false;
                        this._stopPing();

                        window.KynectaEventBus?.emit('REALTIME_DISCONNECTED', {
                            wasConnected
                        });

                        if (wasConnected) {
                            this._attemptReconnect();
                        }
                    };
                } catch (error) {
                    this._connecting = false;
                    reject(error);
                }
            });

            return this._connectionPromise;
        }

        disconnect() {
            this._stopPing();
            
            if (this._socket) {
                this._socket.close();
                this._socket = null;
            }
            
            this._connected = false;
            this._authenticated = false;
            this._connecting = false;
            this._reconnectAttempts = 0;
            this._messageQueue = [];
        }

        send(type, payload = {}) {
            const message = {
                type,
                payload,
                timestamp: Date.now(),
                connectionId: this._connectionId
            };

            if (this._connected && this._socket && this._socket.readyState === WebSocket.OPEN) {
                this._socket.send(JSON.stringify(message));
            } else {
                this._messageQueue.push(message);
            }
        }

        _handleMessage(data) {
            const { type, payload, requestId } = data;

            if (type === 'AUTHENTICATED') {
                this._authenticated = true;
                window.KynectaEventBus?.emit('REALTIME_AUTHENTICATED', payload);
                return;
            }

            if (type === 'PING') {
                this.send('PONG', { timestamp: Date.now() });
                return;
            }

            if (type === 'PONG') {
                if (this._pongTimeout) {
                    clearTimeout(this._pongTimeout);
                    this._pongTimeout = null;
                }
                
                const latency = Date.now() - this._lastPing;
                window.KynectaStore?.set('realtime.latency', latency);
                return;
            }

            window.KynectaEventBus?.emit(`REALTIME_${type}`, payload);

            if (this._eventListeners.has(type)) {
                this._eventListeners.get(type).forEach(listener => {
                    try {
                        listener(payload);
                    } catch (error) {
                        window.__KYNECTA_LOGGER__.error('realtime', type, 'Listener error', { error: error.message });
                    }
                });
            }

            if (requestId) {
                window.KynectaReliability?.handleAck(requestId, payload);
            }
        }

        _startPing() {
            this._stopPing();
            
            this._pingInterval = setInterval(() => {
                if (!this._connected) return;
                
                this._lastPing = Date.now();
                this.send('PING', { timestamp: this._lastPing });

                if (this._pongTimeout) {
                    clearTimeout(this._pongTimeout);
                }
                
                this._pongTimeout = setTimeout(() => {
                    if (this._connected) {
                        this._socket?.close();
                    }
                }, 5000);
            }, 30000);
        }

        _stopPing() {
            if (this._pingInterval) {
                clearInterval(this._pingInterval);
                this._pingInterval = null;
            }
            
            if (this._pongTimeout) {
                clearTimeout(this._pongTimeout);
                this._pongTimeout = null;
            }
        }

        _attemptReconnect() {
            if (this._reconnectAttempts >= this._maxReconnectAttempts) {
                window.KynectaEventBus?.emit('REALTIME_RECONNECT_FAILED', {
                    attempts: this._reconnectAttempts
                });
                return;
            }

            this._reconnectAttempts++;
            
            const delay = this._reconnectDelay * Math.pow(1.5, this._reconnectAttempts - 1);
            
            setTimeout(() => {
                const token = window.__getAuthToken();
                if (token) {
                    this.connect().catch(() => {});
                }
            }, delay);
        }

        on(type, listener) {
            if (!this._eventListeners.has(type)) {
                this._eventListeners.set(type, new Set());
            }
            
            this._eventListeners.get(type).add(listener);
            
            return () => {
                if (this._eventListeners.has(type)) {
                    this._eventListeners.get(type).delete(listener);
                }
            };
        }

        getStatus() {
            return {
                connected: this._connected,
                authenticated: this._authenticated,
                connecting: this._connecting,
                reconnectAttempts: this._reconnectAttempts,
                connectionId: this._connectionId,
                queueSize: this._messageQueue.length
            };
        }
    }

    window.KynectaRealtime = new RealtimeManager().init();
})();
</script>

<!-- ========== SYSTEM 5: SYNC MANAGER ========== -->
<script>
(function() {
    'use strict';

    class SyncManager {
        constructor() {
            this._syncInProgress = new Map();
            this._lastSync = new Map();
            this._syncInterval = null;
            this._syncQueue = [];
            this._syncHandlers = new Map();
            this._conflictResolvers = new Map();
            this._offlineCache = new Map();
            this._initialized = false;
        }

        init() {
            if (this._initialized) return this;
            
            this._registerDefaultHandlers();

            const startSync = () => {
                if (window.__SYNC_HALTED__) {
                    return;
                }
                
                if (!window.__isAuthenticated()) {
                    return;
                }
                
                this._syncInterval = setInterval(() => {
                    this._performPeriodicSync();
                }, 60000);
            };

            window.addEventListener('online', () => {
                window.KynectaEventBus?.emit('SYNC_NETWORK_ONLINE');
                
                if (!window.__SYNC_HALTED__ && window.__isAuthenticated()) {
                    this._processSyncQueue();
                }
            });

            window.addEventListener('offline', () => {
                window.KynectaEventBus?.emit('SYNC_NETWORK_OFFLINE');
            });

            window.KynectaEventBus?.on('SYNC_REQUESTED', (data) => {
                if (window.__SYNC_HALTED__) {
                    return;
                }
                
                if (!window.__isAuthenticated()) {
                    return;
                }
                
                this.sync(data.resource, data.options);
            });

            window.KynectaEventBus?.on('AUTH_SUCCESS', () => {
                window.__resetSyncHalted__?.();
                window.__TOKEN_READY__ = true;
                
                if (!this._syncInterval) {
                    startSync();
                }
            });

            if (window.__isAuthenticated()) {
                startSync();
            }

            this._initialized = true;
            return this;
        }

        _registerDefaultHandlers() {
            this.registerHandler('messages', async (options) => {
                if (window.__SYNC_HALTED__ || !window.__isAuthenticated()) {
                    return { success: false, reason: 'auth_required' };
                }
                
                if (!window.MessageService) return { success: false, reason: 'service_unavailable' };
                
                const since = this._lastSync.get('messages') || options.since || 0;
                try {
                    const response = await window.__safeApiCall(() => window.API.get('/chats'));
                    if (!response || !response.success) return { success: false, error: response?.error };
                    
                    const conversations = response.data;
                    
                    for (const conversation of conversations) {
                        try {
                            const msgResponse = await window.MessageService.getMessages(conversation.id, { since });
                            if (msgResponse && msgResponse.success) {
                                if (window.KynectaStore) {
                                    const existing = window.KynectaStore.get(`conversations.${conversation.id}.messages`) || [];
                                    const updated = [...existing, ...(msgResponse.data || [])];
                                    window.KynectaStore.set(`conversations.${conversation.id}.messages`, updated);
                                }
                            }
                        } catch (e) {
                            window.__KYNECTA_LOGGER__.error('sync', 'messages', 'Failed to sync conversation', { error: e.message });
                        }
                    }
                    
                    return { success: true, count: conversations.length };
                } catch (error) {
                    const cached = this._offlineCache.get('messages') || [];
                    return { success: true, cached: true, data: cached };
                }
            });

            this.registerHandler('friends', async () => {
                if (window.__SYNC_HALTED__ || !window.__isAuthenticated()) {
                    return { success: false, reason: 'auth_required' };
                }
                
                if (!window.FriendService) return { success: false, reason: 'service_unavailable' };
                
                try {
                    const friendsResponse = await window.__safeApiCall(() => window.API.get('/friends'));
                    const requestsResponse = await window.__safeApiCall(() => window.API.get('/friends/requests'));
                    
                    if (window.KynectaStore) {
                        window.KynectaStore.set('friends.list', friendsResponse?.success ? friendsResponse.data : []);
                        window.KynectaStore.set('friends.requests', requestsResponse?.success ? requestsResponse.data : []);
                    }
                    
                    this._offlineCache.set('friends', { 
                        friends: friendsResponse?.success ? friendsResponse.data : [], 
                        requests: requestsResponse?.success ? requestsResponse.data : [] 
                    });
                    
                    return { 
                        success: true, 
                        friends: friendsResponse?.success ? friendsResponse.data.length : 0, 
                        requests: requestsResponse?.success ? requestsResponse.data.length : 0 
                    };
                } catch (error) {
                    const cached = this._offlineCache.get('friends');
                    return { success: true, cached: true, data: cached };
                }
            });

            this.registerHandler('groups', async () => {
                if (window.__SYNC_HALTED__ || !window.__isAuthenticated()) {
                    return { success: false, reason: 'auth_required' };
                }
                
                if (!window.GroupService) return { success: false, reason: 'service_unavailable' };
                
                try {
                    const response = await window.__safeApiCall(() => window.API.get('/group'));
                    
                    if (window.KynectaStore) {
                        window.KynectaStore.set('groups.list', response?.success ? response.data : []);
                    }
                    
                    this._offlineCache.set('groups', response?.success ? response.data : []);
                    
                    return { success: true, count: response?.success ? response.data.length : 0 };
                } catch (error) {
                    const cached = this._offlineCache.get('groups');
                    return { success: true, cached: true, data: cached };
                }
            });

            this.registerHandler('status', async () => {
                if (window.__SYNC_HALTED__ || !window.__isAuthenticated()) {
                    return { success: false, reason: 'auth_required' };
                }
                
                if (!window.StatusService) return { success: false, reason: 'service_unavailable' };
                
                try {
                    const response = await window.__safeApiCall(() => window.API.get('/status'));
                    
                    if (window.KynectaStore) {
                        window.KynectaStore.set('status.list', response?.success ? response.data : []);
                    }
                    
                    this._offlineCache.set('status', response?.success ? response.data : []);
                    
                    return { success: true, count: response?.success ? response.data.length : 0 };
                } catch (error) {
                    const cached = this._offlineCache.get('status');
                    return { success: true, cached: true, data: cached };
                }
            });

            this.registerHandler('settings', async () => {
                if (window.__SYNC_HALTED__ || !window.__isAuthenticated()) {
                    return { success: false, reason: 'auth_required' };
                }
                
                if (!window.SettingsService) return { success: false, reason: 'service_unavailable' };
                
                try {
                    const response = await window.__safeApiCall(() => window.API.get('/settings'));
                    
                    if (window.KynectaStore) {
                        window.KynectaStore.set('settings', response?.success ? response.data : {});
                    }
                    
                    this._offlineCache.set('settings', response?.success ? response.data : {});
                    
                    return { success: true };
                } catch (error) {
                    const cached = this._offlineCache.get('settings');
                    return { success: true, cached: true, data: cached };
                }
            });
        }

        registerHandler(resource, handler) {
            this._syncHandlers.set(resource, handler);
        }

        registerConflictResolver(resource, resolver) {
            this._conflictResolvers.set(resource, resolver);
        }

        async sync(resource, options = {}) {
            if (window.__SYNC_RUNNING__ && !options.force) {
                return { success: false, queued: true, reason: 'sync_in_progress' };
            }
            
            if ((window.__SYNC_HALTED__ || !window.__isAuthenticated()) && !options.force) {
                return { success: false, reason: 'auth_required' };
            }

            if (this._syncInProgress.has(resource)) {
                return this._syncInProgress.get(resource);
            }

            if (!navigator.onLine && !options.force) {
                this._syncQueue.push({ resource, options, timestamp: Date.now() });
                return { success: false, queued: true };
            }

            window.__SYNC_RUNNING__ = true;

            const syncPromise = this._performSync(resource, options);
            this._syncInProgress.set(resource, syncPromise);

            try {
                const result = await syncPromise;
                
                if (result.success) {
                    this._lastSync.set(resource, Date.now());
                    
                    window.KynectaEventBus?.emit('SYNC_COMPLETED', {
                        resource,
                        timestamp: Date.now(),
                        result
                    });
                    
                    if (resource === 'auth' || resource === 'session') {
                        window.__resetSyncHalted__?.();
                    }
                } else {
                    window.KynectaEventBus?.emit('SYNC_FAILED', {
                        resource,
                        timestamp: Date.now(),
                        error: result.error
                    });
                }

                return result;
            } finally {
                this._syncInProgress.delete(resource);
                setTimeout(() => {
                    window.__SYNC_RUNNING__ = false;
                }, 500);
            }
        }

        async _performSync(resource, options) {
            const handler = this._syncHandlers.get(resource);
            
            if (!handler) {
                return { success: false, error: `No handler for resource: ${resource}` };
            }

            try {
                const localData = options.localData || 
                                 (window.KynectaStore?.get(resource));

                const remoteResult = await handler(options);

                if (localData && remoteResult.data && options.checkConflicts) {
                    const resolver = this._conflictResolvers.get(resource);
                    
                    if (resolver) {
                        const resolved = resolver(localData, remoteResult.data);
                        
                        if (resolved !== localData) {
                            if (window.KynectaStore) {
                                window.KynectaStore.set(resource, resolved);
                            }
                            
                            await this._pushChanges(resource, resolved);
                        }
                    }
                }

                return remoteResult;
            } catch (error) {
                window.__KYNECTA_LOGGER__.error('sync', resource, 'Sync failed', { error: error.message });
                return { success: false, error: error.message };
            }
        }

        async _pushChanges(resource, data) {
            switch(resource) {
                case 'messages':
                    break;
                    
                case 'settings':
                    if (window.SettingsService) {
                        await window.SettingsService.updateSettings(data);
                    }
                    break;
                    
                default:
                    if (window.API) {
                        await window.__safeApiCall(() => window.API.post(`/sync/${resource}`, data)).catch(() => {});
                    }
            }
        }

        async _performPeriodicSync() {
            if (!navigator.onLine || window.__SYNC_HALTED__ || !window.__isAuthenticated()) return;

            const resources = Array.from(this._syncHandlers.keys());
            
            for (const resource of resources) {
                const lastSync = this._lastSync.get(resource) || 0;
                if (Date.now() - lastSync > 300000) {
                    this.sync(resource).catch(() => {});
                }
            }
        }

        async _processSyncQueue() {
            if (!navigator.onLine || window.__SYNC_HALTED__ || !window.__isAuthenticated()) return;

            const queue = [...this._syncQueue];
            this._syncQueue = [];

            for (const item of queue) {
                await this.sync(item.resource, item.options);
            }
        }

        getStatus() {
            return {
                lastSync: Array.from(this._lastSync.entries()).map(([resource, timestamp]) => ({
                    resource,
                    timestamp,
                    age: Date.now() - timestamp
                })),
                inProgress: Array.from(this._syncInProgress.keys()),
                queueSize: this._syncQueue.length
            };
        }

        stop() {
            if (this._syncInterval) {
                clearInterval(this._syncInterval);
                this._syncInterval = null;
            }
        }
    }

    window.KynectaSyncManager = new SyncManager().init();
})();
</script>

<!-- ========== SYSTEM 6: OFFLINE QUEUE ========== -->
<script>
(function() {
    'use strict';

    class OfflineQueue {
        constructor() {
            this._queue = [];
            this._processing = false;
            this._maxSize = 1000;
            this._retryDelays = [1000, 3000, 5000, 10000, 30000];
            this._storageKey = 'kynecta_offline_queue';
            this._initialized = false;
            
            this._loadFromStorage();
        }

        init() {
            if (this._initialized) return this;
            
            window.addEventListener('online', () => {
                this.process();
            });

            window.addEventListener('offline', () => {
                window.KynectaEventBus?.emit('OFFLINE_QUEUE_PAUSED');
            });

            window.KynectaEventBus?.on('OFFLINE_QUEUE_PROCESS', () => {
                this.process();
            });

            setInterval(() => {
                this._saveToStorage();
            }, 10000);

            this._initialized = true;
            return this;
        }

        enqueue(action) {
            const id = `action_${Date.now()}_${Math.random().toString(36).substr(2, 8)}`;
            
            const queueItem = {
                id,
                type: action.type,
                payload: action.payload,
                timestamp: Date.now(),
                retries: 0,
                status: 'pending'
            };

            this._queue.push(queueItem);

            if (this._queue.length > this._maxSize) {
                this._queue.shift();
            }

            this._saveToStorage();

            window.KynectaEventBus?.emit('OFFLINE_QUEUE_ADDED', {
                id,
                type: action.type,
                queueSize: this._queue.length
            });

            if (navigator.onLine && window.__isAuthenticated()) {
                this.process();
            }

            return id;
        }

        async process() {
            if (window.__SYNC_HALTED__) {
                return;
            }
            
            if (!window.__isAuthenticated()) {
                return;
            }
            
            if (this._processing) return;
            if (!navigator.onLine) return;
            if (this._queue.length === 0) return;

            this._processing = true;

            try {
                let processed = 0;
                const maxProcessPerBatch = 10;

                while (this._queue.length > 0 && processed < maxProcessPerBatch) {
                    const item = this._queue[0];

                    if (Date.now() - item.timestamp > 604800000) {
                        this._queue.shift();
                        processed++;
                        continue;
                    }

                    const success = await this._processItem(item);

                    if (success) {
                        this._queue.shift();
                        processed++;

                        window.KynectaEventBus?.emit('OFFLINE_QUEUE_PROCESSED', {
                            id: item.id,
                            type: item.type
                        });
                    } else {
                        item.retries++;

                        const maxRetries = this._retryDelays.length;
                        if (item.retries >= maxRetries) {
                            this._queue.shift();
                            
                            window.KynectaEventBus?.emit('OFFLINE_QUEUE_FAILED', {
                                id: item.id,
                                type: item.type,
                                retries: item.retries
                            });
                        } else {
                            this._queue.shift();
                            this._queue.push(item);
                        }

                        processed++;
                    }

                    if (this._queue.length > 0) {
                        await new Promise(resolve => setTimeout(resolve, 500));
                    }
                }
            } finally {
                this._processing = false;

                this._saveToStorage();

                if (this._queue.length > 0 && navigator.onLine) {
                    setTimeout(() => this.process(), 5000);
                }
            }
        }

        async _processItem(item) {
            try {
                switch (item.type) {
                    case 'SEND_MESSAGE':
                        if (window.MessageService) {
                            const response = await window.MessageService.sendMessage(item.payload);
                            return response && response.success === true;
                        }
                        break;

                    case 'FRIEND_REQUEST':
                        if (window.FriendService) {
                            const response = await window.FriendService.sendFriendRequest(item.payload.userId);
                            return response && response.success === true;
                        }
                        break;

                    case 'GROUP_MESSAGE':
                        if (window.GroupService) {
                            const response = await window.GroupService.sendGroupMessage(
                                item.payload.groupId,
                                item.payload.message
                            );
                            return response && response.success === true;
                        }
                        break;

                    case 'STATUS_UPDATE':
                        if (window.StatusService) {
                            const response = await window.StatusService.postStatus(item.payload);
                            return response && response.success === true;
                        }
                        break;

                    case 'CALL_ACTION':
                        if (window.CallService) {
                            let response;
                            switch (item.payload.action) {
                                case 'initiate':
                                    response = await window.CallService.initiateCall(
                                        item.payload.targetUserId,
                                        item.payload.callType
                                    );
                                    break;
                                case 'accept':
                                    response = await window.CallService.acceptCall(item.payload.callId);
                                    break;
                                case 'reject':
                                    response = await window.CallService.rejectCall(item.payload.callId);
                                    break;
                                case 'end':
                                    response = await window.CallService.endCall(item.payload.callId);
                                    break;
                            }
                            return response && response.success === true;
                        }
                        break;

                    case 'SETTINGS_UPDATE':
                        if (window.SettingsService) {
                            const response = await window.SettingsService.updateSettings(item.payload);
                            return response && response.success === true;
                        }
                        break;
                }

                return false;
            } catch (error) {
                window.__KYNECTA_LOGGER__.error('offline', item.id, 'Process item failed', { error: error.message });
                return false;
            }
        }

        _saveToStorage() {
            try {
                const data = this._queue.map(item => ({
                    ...item,
                    payload: JSON.parse(JSON.stringify(item.payload))
                }));
                
                localStorage.setItem(this._storageKey, JSON.stringify(data));
            } catch (error) {
                window.__KYNECTA_LOGGER__.error('offline', 'storage', 'Failed to save to storage', { error: error.message });
            }
        }

        _loadFromStorage() {
            try {
                const data = localStorage.getItem(this._storageKey);
                if (data) {
                    this._queue = JSON.parse(data);
                }
            } catch (error) {
                this._queue = [];
                window.__KYNECTA_LOGGER__.error('offline', 'storage', 'Failed to load from storage', { error: error.message });
            }
        }

        clear() {
            this._queue = [];
            this._saveToStorage();
            
            window.KynectaEventBus?.emit('OFFLINE_QUEUE_CLEARED');
        }

        getStatus() {
            return {
                size: this._queue.length,
                processing: this._processing,
                oldest: this._queue.length > 0 ? this._queue[0].timestamp : null,
                types: this._queue.reduce((acc, item) => {
                    acc[item.type] = (acc[item.type] || 0) + 1;
                    return acc;
                }, {})
            };
        }

        getRetryDelay(item) {
            if (item.retries >= this._retryDelays.length) {
                return this._retryDelays[this._retryDelays.length - 1];
            }
            return this._retryDelays[item.retries];
        }
    }

    window.KynectaOfflineQueue = new OfflineQueue().init();
})();
</script>

<!-- ========== SYSTEM 7: MODULE REGISTRY ========== -->
<script>
(function() {
    'use strict';

    const MODULE_STATES = {
        UNKNOWN: 'unknown',
        REGISTERING: 'registering',
        REGISTERED: 'registered',
        ACTIVE: 'active',
        DEGRADED: 'degraded',
        FAILED: 'failed',
        RECOVERING: 'recovering',
        LOCKDOWN: 'lockdown'
    };

    const VALID_MODULES = new Set([
        'messages', 'calls', 'friends', 'groups', 'status', 'tools', 'settings'
    ]);

    class ModuleRegistry {
        constructor() {
            this._modules = new Map();
            this._moduleIds = {
                messages: 'messagesIframe',
                status: 'statusIframe',
                groups: 'groupIframe',
                friends: 'friendsIframe',
                calls: 'callsIframe',
                settings: 'settingsIframe',
                tools: 'toolsIframe'
            };
            this._initialized = false;
            this._expectedModules = new Set(['messages', 'calls', 'friends', 'groups', 'status', 'settings', 'tools']);
        }

        init() {
            if (this._initialized) return this;

            for (const [moduleName, iframeId] of Object.entries(this._moduleIds)) {
                this._modules.set(moduleName, {
                    name: moduleName,
                    iframeId: iframeId,
                    iframe: document.getElementById(iframeId),
                    state: MODULE_STATES.UNKNOWN,
                    registered: false,
                    registeredAt: null,
                    lastHeartbeat: 0,
                    lastActivity: Date.now(),
                    handshakeComplete: false,
                    sessionDelivered: false,
                    degraded: false,
                    messageQueue: [],
                    metadata: {},
                    capabilities: new Set(),
                    protocol: 'unknown',
                    version: null,
                    windowRef: null,
                    origin: null,
                    registrationAttempts: 0,
                    maxRegistrationAttempts: 1
                });
            }

            this._initialized = true;
            return this;
        }

        getExpectedModules() {
            return this._expectedModules.size;
        }

        getRegisteredCount() {
            let count = 0;
            for (const module of this._modules.values()) {
                if (module.registered) count++;
            }
            return count;
        }

        allModulesRegistered() {
            for (const module of this._expectedModules) {
                const mod = this._modules.get(module);
                if (!mod || !mod.registered) return false;
            }
            return true;
        }

        normalizeModuleName(name) {
            if (!name || typeof name !== 'string') return null;
            
            let normalized = name.trim().toLowerCase();
            
            const aliases = {
                'group': 'groups',
                'message': 'messages',
                'call': 'calls',
                'friend': 'friends',
                'setting': 'settings',
                'tool': 'tools'
            };
            
            if (aliases[normalized]) {
                normalized = aliases[normalized];
            }
            
            return VALID_MODULES.has(normalized) ? normalized : null;
        }

        register(moduleName, iframeWindow, metadata = {}) {
            const normalizedName = this.normalizeModuleName(moduleName);
            if (!normalizedName) {
                return false;
            }

            const module = this._modules.get(normalizedName);
            
            if (!module) {
                return false;
            }

            if (module.registered && module.windowRef && module.windowRef !== iframeWindow) {
                if (module.state === MODULE_STATES.FAILED || module.state === MODULE_STATES.LOCKDOWN) {
                    module.registered = false;
                    module.windowRef = null;
                    module.origin = null;
                } else {
                    window.KynectaEventBus?.emit('MODULE_REGISTRATION_DUPLICATE', { module: normalizedName });
                    window.__KYNECTA_LOGGER__.warn('registry', normalizedName, 'Duplicate registration attempt');
                    return false;
                }
            }

            module.iframe = document.getElementById(module.iframeId);
            
            module.windowRef = iframeWindow;
            try {
                if (module.iframe && module.iframe.src) {
                    const url = new URL(module.iframe.src, window.location.href);
                    module.origin = url.origin;
                }
            } catch (e) {
                module.origin = '*';
            }

            module.registered = true;
            module.state = MODULE_STATES.REGISTERED;
            module.registeredAt = Date.now();
            module.lastActivity = Date.now();
            module.registrationAttempts = 0;
            
            if (metadata.capabilities) {
                module.capabilities = new Set(metadata.capabilities);
            }
            if (metadata.version) {
                module.version = metadata.version;
            }
            if (metadata.protocol) {
                module.protocol = metadata.protocol;
            }
            Object.assign(module.metadata, metadata);

            if (window.__BOOT_STATE__) {
                window.__BOOT_STATE__.iframesRegistered.add(normalizedName);
            }

            window.KynectaEventBus?.emit('MODULE_REGISTERED', {
                module: normalizedName,
                timestamp: Date.now()
            });
            
            setTimeout(() => {
                if (window.__propagateSessionToIframes__) {
                    window.__propagateSessionToIframes__();
                }
            }, 100);

            return true;
        }

        setState(moduleName, state, metadata = {}) {
            const normalizedName = this.normalizeModuleName(moduleName);
            if (!normalizedName) return false;
            
            const module = this._modules.get(normalizedName);
            if (!module) return false;

            const oldState = module.state;
            module.state = state;
            module.lastActivity = Date.now();

            if (state === MODULE_STATES.ACTIVE) {
                module.handshakeComplete = true;
                module.degraded = false;
            }

            if (state === MODULE_STATES.DEGRADED) {
                module.degraded = true;
            }

            if (state === MODULE_STATES.LOCKDOWN) {
                module.degraded = true;
                module.handshakeComplete = false;
            }

            Object.assign(module, metadata);

            if (oldState !== state) {
                window.KynectaEventBus?.emit('MODULE_STATE_CHANGED', {
                    module: normalizedName,
                    oldState,
                    newState: state,
                    timestamp: Date.now()
                });
            }

            return true;
        }

        incrementRegistrationAttempt(moduleName) {
            const normalizedName = this.normalizeModuleName(moduleName);
            if (!normalizedName) return false;
            
            const module = this._modules.get(normalizedName);
            if (!module) return false;

            module.registrationAttempts++;
            return module.registrationAttempts <= module.maxRegistrationAttempts;
        }

        heartbeat(moduleName) {
            const normalizedName = this.normalizeModuleName(moduleName);
            if (!normalizedName) return false;
            
            const module = this._modules.get(normalizedName);
            if (!module || !module.registered) return false;

            module.lastHeartbeat = Date.now();
            module.lastActivity = Date.now();
            
            if (module.degraded) {
                module.degraded = false;
                module.state = MODULE_STATES.ACTIVE;
            }

            return true;
        }

        isAlive(moduleName, timeout = 60000) {
            const normalizedName = this.normalizeModuleName(moduleName);
            if (!normalizedName) return false;
            
            const module = this._modules.get(normalizedName);
            if (!module || !module.registered) return false;
            
            const now = Date.now();
            if (now - module.lastHeartbeat > timeout) {
                if (!module.degraded && module.state !== MODULE_STATES.LOCKDOWN) {
                    this.setState(moduleName, MODULE_STATES.DEGRADED);
                }
                return false;
            }
            
            return true;
        }

        get(moduleName) {
            const normalizedName = this.normalizeModuleName(moduleName);
            return normalizedName ? this._modules.get(normalizedName) : null;
        }

        getByWindow(win) {
            for (const module of this._modules.values()) {
                if (module.windowRef === win) {
                    return module;
                }
            }
            return null;
        }

        getByIframeId(iframeId) {
            const moduleName = Object.keys(this._moduleIds).find(
                key => this._moduleIds[key] === iframeId
            );
            return moduleName ? this._modules.get(moduleName) : null;
        }

        getRegistered() {
            const registered = [];
            for (const module of this._modules.values()) {
                if (module.registered) {
                    registered.push(module.name);
                }
            }
            return registered;
        }

        getStatus(moduleName) {
            const normalizedName = this.normalizeModuleName(moduleName);
            if (!normalizedName) return 'unknown';
            
            const module = this._modules.get(normalizedName);
            return module ? module.state : 'unknown';
        }

        isRegistered(moduleName) {
            const normalizedName = this.normalizeModuleName(moduleName);
            if (!normalizedName) return false;
            
            const module = this._modules.get(normalizedName);
            return !!(module && module.registered);
        }

        isActive(moduleName) {
            const normalizedName = this.normalizeModuleName(moduleName);
            if (!normalizedName) return false;
            
            const module = this._modules.get(normalizedName);
            return !!(module && module.registered && module.state === MODULE_STATES.ACTIVE);
        }

        queueMessage(moduleName, message) {
            const normalizedName = this.normalizeModuleName(moduleName);
            if (!normalizedName) return false;
            
            const module = this._modules.get(normalizedName);
            if (!module) return false;

            module.messageQueue.push({
                message,
                timestamp: Date.now(),
                attempts: 0
            });

            if (module.messageQueue.length > 100) {
                module.messageQueue.shift();
            }

            return true;
        }

        processQueue(moduleName) {
            const normalizedName = this.normalizeModuleName(moduleName);
            if (!normalizedName) return 0;
            
            const module = this._modules.get(normalizedName);
            if (!module || module.messageQueue.length === 0) return 0;

            if (!module.windowRef) return 0;

            let processed = 0;
            const remaining = [];

            for (const item of module.messageQueue) {
                try {
                    module.windowRef.postMessage({
                        ...item.message,
                        _queued: true,
                        _queueTimestamp: item.timestamp
                    }, module.origin || '*');
                    processed++;
                } catch (e) {
                    item.attempts++;
                    if (item.attempts < 3) {
                        remaining.push(item);
                    } else {
                        window.__KYNECTA_LOGGER__.error('registry', moduleName, 'Failed to process queued message after retries', { error: e.message });
                    }
                }
            }

            module.messageQueue = remaining;
            return processed;
        }

        getReport() {
            const report = {};
            for (const [name, module] of this._modules) {
                report[name] = {
                    name: module.name,
                    iframeId: module.iframeId,
                    state: module.state,
                    registered: module.registered,
                    registeredAt: module.registeredAt,
                    lastHeartbeat: module.lastHeartbeat ? new Date(module.lastHeartbeat).toISOString() : null,
                    lastActivity: new Date(module.lastActivity).toISOString(),
                    handshakeComplete: module.handshakeComplete,
                    sessionDelivered: module.sessionDelivered,
                    degraded: module.degraded,
                    queueSize: module.messageQueue.length,
                    protocol: module.protocol,
                    version: module.version,
                    capabilities: Array.from(module.capabilities),
                    registrationAttempts: module.registrationAttempts
                };
            }
            return report;
        }

        getModuleIds() {
            return { ...this._moduleIds };
        }

        isValidAndRegistered(moduleName) {
            const normalizedName = this.normalizeModuleName(moduleName);
            if (!normalizedName) return false;
            
            const module = this._modules.get(normalizedName);
            return !!(module && module.registered);
        }

        reset(moduleName) {
            const normalizedName = this.normalizeModuleName(moduleName);
            if (!normalizedName) return false;
            
            const module = this._modules.get(normalizedName);
            if (!module) return false;

            module.registered = false;
            module.state = MODULE_STATES.UNKNOWN;
            module.windowRef = null;
            module.origin = null;
            module.handshakeComplete = false;
            module.sessionDelivered = false;
            module.degraded = false;
            module.messageQueue = [];
            module.registrationAttempts = 0;
            
            // Reset parent ready sent flag for this module
            if (window.__resetParentReadySent) {
                window.__resetParentReadySent(normalizedName);
            }
            
            return true;
        }
    }

    window.KynectaModuleRegistry = new ModuleRegistry().init();
})();
</script>

<!-- ========== SYSTEM 8: SECURITY ORIGIN GUARD ========== -->
<script>
(function() {
    'use strict';

    class SecurityGuard {
        constructor() {
            this._trustedOrigins = new Set();
            this._locked = false;
            this._allowedSchemes = ['http:', 'https:', 'null'];
            this._originCache = new Map();
            this._validationStats = {
                total: 0,
                allowed: 0,
                rejected: 0,
                cached: 0
            };
            
            this._iframeOrigins = new Map();
            this._initialized = false;
        }

        init() {
            if (this._initialized) return this;
            
            const currentOrigin = window.location.origin;
            this.addTrustedOrigin(currentOrigin);
            this.addTrustedOrigin('null');

            setTimeout(() => {
                this._locked = true;
            }, 5000);

            this._initialized = true;
            return this;
        }

        addTrustedOrigin(origin) {
            if (!origin) return;
            
            const normalized = this._normalizeOrigin(origin);
            this._trustedOrigins.add(normalized);
            
            window.KynectaEventBus?.emit('SECURITY_ORIGIN_ADDED', { origin: normalized });
        }

        registerIframeOrigin(iframeId, origin) {
            if (!iframeId || !origin) return;
            this._iframeOrigins.set(iframeId, this._normalizeOrigin(origin));
        }

        validate(origin, source) {
            this._validationStats.total++;

            if (this._originCache.has(origin)) {
                this._validationStats.cached++;
                return this._originCache.get(origin);
            }

            if (origin === 'null') {
                this._originCache.set(origin, true);
                this._validationStats.allowed++;
                return true;
            }

            try {
                const url = new URL(origin);
                if (!this._allowedSchemes.includes(url.protocol)) {
                    this._validationStats.rejected++;
                    this._originCache.set(origin, false);
                    return false;
                }
            } catch (e) {
                this._validationStats.rejected++;
                this._originCache.set(origin, false);
                return false;
            }

            const normalized = this._normalizeOrigin(origin);
            
            if (this._trustedOrigins.has(normalized)) {
                this._originCache.set(origin, true);
                this._validationStats.allowed++;
                return true;
            }

            if (this._isOwnIframe(source)) {
                const iframeId = this._identifyIframeId(source);
                if (iframeId && this._iframeOrigins.has(iframeId)) {
                    const iframeOrigin = this._iframeOrigins.get(iframeId);
                    if (iframeOrigin === normalized) {
                        this._originCache.set(origin, true);
                        this._validationStats.allowed++;
                        return true;
                    }
                }
                this._originCache.set(origin, true);
                this._validationStats.allowed++;
                return true;
            }

            if (this._locked) {
                this._validationStats.rejected++;
                this._originCache.set(origin, false);
                
                window.KynectaEventBus?.emit('SECURITY_ORIGIN_REJECTED', { origin });
                return false;
            }

            this._originCache.set(origin, true);
            this._validationStats.allowed++;
            return true;
        }

        _isOwnIframe(source) {
            return this._identifyIframeId(source) !== null;
        }

        _identifyIframeId(source) {
            const iframeIds = [
                'messagesIframe', 'statusIframe', 'groupIframe',
                'friendsIframe', 'callsIframe', 'settingsIframe', 'toolsIframe'
            ];

            for (const id of iframeIds) {
                const iframe = document.getElementById(id);
                if (iframe && iframe.contentWindow === source) {
                    return id;
                }
            }
            return null;
        }

        _normalizeOrigin(origin) {
            if (!origin || origin === 'null') return 'null';
            
            try {
                let normalized = origin;
                if (normalized.endsWith('/')) {
                    normalized = normalized.slice(0, -1);
                }
                
                normalized = normalized.toLowerCase();
                
                return normalized;
            } catch (e) {
                return origin;
            }
        }

        getTargetOrigin(targetModule) {
            const moduleIds = window.KynectaModuleRegistry?.getModuleIds() || {};
            const iframeId = moduleIds[targetModule];
            if (!iframeId) return window.location.origin;

            if (this._iframeOrigins.has(iframeId)) {
                return this._iframeOrigins.get(iframeId);
            }

            const iframe = document.getElementById(iframeId);
            if (!iframe || !iframe.src) return window.location.origin;

            try {
                const url = new URL(iframe.src, window.location.href);
                const origin = url.origin;
                this._iframeOrigins.set(iframeId, origin);
                return origin;
            } catch (e) {
                return window.location.origin;
            }
        }

        validateMessage(message) {
            if (!message || typeof message !== 'object') return false;
            
            const hasId = !!(message.id || message.messageId || message.requestId);
            const hasAction = !!(message.action || message.type);
            const hasSource = !!(message.source || message.from || message.sender);
            const hasTarget = !!(message.target || message.to || message.destination);
            const hasData = !!(message.data !== undefined || message.payload !== undefined);
            const hasTimestamp = !!(message.timestamp !== undefined);
            
            return hasId && hasAction && hasSource && hasTarget && hasData && hasTimestamp;
        }

        getStats() {
            return {
                ...this._validationStats,
                trustedOrigins: Array.from(this._trustedOrigins),
                locked: this._locked,
                cacheSize: this._originCache.size,
                iframeOrigins: Array.from(this._iframeOrigins.entries())
            };
        }

        clearCache() {
            this._originCache.clear();
        }
    }

    window.KynectaSecurityGuard = new SecurityGuard().init();
})();
</script>

<!-- ========== SYSTEM 9: RELIABILITY LAYER (ACK TRACKING) ========== -->
<script>
(function() {
    'use strict';

    const MAX_RETRY_LIMIT = 2;
    const ACK_TIMEOUT = 8000;
    const RETRY_DELAYS = [1000, 2000];

    class ReliabilityManager {
        constructor() {
            this._pendingAcks = new Map();
            this._processedMessages = new Set();
            this._retryDelays = RETRY_DELAYS;
            this._maxRetries = MAX_RETRY_LIMIT;
            this._ackTimeout = ACK_TIMEOUT;
            this._stats = {
                messagesSent: 0,
                acksReceived: 0,
                acksTimeout: 0,
                retries: 0,
                dropped: 0,
                maxRetriesExceeded: 0
            };
            this._initialized = false;
        }

        init() {
            if (this._initialized) return this;
            
            window.KynectaEventBus?.on('MESSAGE_ACK', (data) => {
                this.handleAck(data.messageId, data.payload);
            });

            setInterval(() => this._cleanup(), 60000);

            this._initialized = true;
            return this;
        }

        sendWithAck(targetModule, message, options = {}) {
            return new Promise((resolve, reject) => {
                const messageId = message.messageId || this._generateMessageId();
                const timeout = options.timeout || this._ackTimeout;
                const maxRetries = options.maxRetries || this._maxRetries;

                if (!window.KynectaModuleRegistry?.isValidAndRegistered(targetModule)) {
                    reject(new Error(`Invalid or unregistered target module: ${targetModule}`));
                    return;
                }

                const timer = setTimeout(() => {
                    this._handleTimeout(messageId, maxRetries, reject);
                }, timeout);

                this._pendingAcks.set(messageId, {
                    resolve,
                    reject,
                    timer,
                    target: targetModule,
                    type: message.type,
                    retries: 0,
                    maxRetries,
                    message: { ...message, messageId }
                });

                this._stats.messagesSent++;

                this._sendMessage(targetModule, { ...message, messageId });
            });
        }

        send(targetModule, message) {
            if (!window.KynectaModuleRegistry?.isValidAndRegistered(targetModule)) {
                window.__KYNECTA_LOGGER__.warn('reliability', 'send', `Invalid target module: ${targetModule}`);
                return;
            }
            this._sendMessage(targetModule, message);
        }

        handleAck(messageId, payload = {}) {
            if (this._processedMessages.has(messageId)) {
                return false;
            }

            this._processedMessages.add(messageId);
            this._stats.acksReceived++;

            const pending = this._pendingAcks.get(messageId);
            if (pending) {
                clearTimeout(pending.timer);
                pending.resolve(payload);
                this._pendingAcks.delete(messageId);
                return true;
            }

            return false;
        }

        _handleTimeout(messageId, maxRetries, reject) {
            const pending = this._pendingAcks.get(messageId);
            if (!pending) return;

            if (pending.retries < maxRetries) {
                pending.retries++;
                this._stats.retries++;

                const delay = this._retryDelays[pending.retries - 1] || this._retryDelays[this._retryDelays.length - 1];

                setTimeout(() => {
                    if (window.KynectaModuleRegistry?.isValidAndRegistered(pending.target)) {
                        this._sendMessage(pending.target, pending.message);
                        
                        const newTimer = setTimeout(() => {
                            this._handleTimeout(messageId, maxRetries, reject);
                        }, this._ackTimeout);
                        
                        pending.timer = newTimer;
                        this._pendingAcks.set(messageId, pending);
                    } else {
                        this._pendingAcks.delete(messageId);
                        this._stats.maxRetriesExceeded++;
                        reject(new Error(`Target module ${pending.target} no longer valid`));
                    }
                }, delay);
            } else {
                this._pendingAcks.delete(messageId);
                this._stats.maxRetriesExceeded++;
                this._stats.acksTimeout++;
                reject(new Error(`ACK timeout after ${maxRetries} retries`));
                
                window.KynectaEventBus?.emit('RELIABILITY_MAX_RETRIES_EXCEEDED', {
                    messageId,
                    target: pending.target,
                    type: pending.type
                });
            }
        }

        _sendMessage(targetModule, message) {
            const moduleIds = window.KynectaModuleRegistry?.getModuleIds() || {};
            const iframeId = moduleIds[targetModule];
            if (!iframeId) return;

            const iframe = document.getElementById(iframeId);
            if (!iframe || !iframe.contentWindow) {
                window.KynectaModuleRegistry?.queueMessage(targetModule, message);
                return;
            }

            const targetOrigin = window.KynectaSecurityGuard?.getTargetOrigin(targetModule) || window.location.origin;

            try {
                iframe.contentWindow.postMessage({
                    ...message,
                    _reliability: true,
                    _timestamp: Date.now()
                }, targetOrigin);
            } catch (error) {
                this._stats.dropped++;
                window.__KYNECTA_LOGGER__.error('reliability', message.requestId, 'Failed to send message', { error: error.message });
            }
        }

        _generateMessageId() {
            return `msg_${Date.now()}_${Math.random().toString(36).substr(2, 8)}_${Math.floor(Math.random() * 1000)}`;
        }

        _cleanup() {
            if (this._processedMessages.size > 1000) {
                this._processedMessages.clear();
            }
        }

        getStats() {
            return {
                ...this._stats,
                pending: this._pendingAcks.size,
                processedMessages: this._processedMessages.size
            };
        }

        clearPendingForModule(moduleName) {
            for (const [messageId, pending] of this._pendingAcks.entries()) {
                if (pending.target === moduleName) {
                    clearTimeout(pending.timer);
                    this._pendingAcks.delete(messageId);
                }
            }
        }
    }

    window.KynectaReliability = new ReliabilityManager().init();
})();
</script>

<!-- ========== SYSTEM 10: SESSION MANAGER ========== -->
<script>
(function() {
    'use strict';

    const SESSION_STATES = {
        INITIAL: 'initial',
        LOADING: 'loading',
        AUTHENTICATED: 'authenticated',
        GUEST: 'guest',
        EXPIRED: 'expired',
        ERROR: 'error'
    };

    class SessionManager {
        constructor() {
            this._state = SESSION_STATES.INITIAL;
            this._session = null;
            this._token = null;
            this._refreshTimer = null;
            this._sessionCheckTimer = null;
            this._subscribers = new Set();
            this._parentReadyBroadcasted = false;
            this._initialized = false;
            this._sessionVersion = 0;
        }

        async init() {
            if (window.__SESSION_INITIALIZED__) {
                return this;
            }
            
            if (this._initialized) return this;
            
            this._state = SESSION_STATES.LOADING;
            window.__APP_STATE__ = 'INITIALIZING';

            await this._loadFromSources();

            this._startSessionMonitoring();

            window.KynectaEventBus?.emit('SESSION_INITIALIZED', {
                state: this._state,
                authenticated: this.isAuthenticated()
            });

            this._initialized = true;
            
            window.__SESSION_INITIALIZED__ = true;
            
            if (this.isAuthenticated()) {
                window.__APP_STATE__ = 'ACTIVE';
                window.__TOKEN_READY__ = true;
                
                if (this._token) {
                    window.__syncTokenToApi(this._token);
                }
                
                window.KynectaEventBus?.emit('AUTH_SUCCESS', { userId: this.getUserId() });
            } else {
                window.__APP_STATE__ = 'ACTIVE';
            }
            
            setTimeout(() => {
                if (this.isAuthenticated() && window.__propagateSessionToIframes__) {
                    window.__propagateSessionToIframes__();
                }
            }, 500);
            
            return this;
        }

        async _loadFromSources() {
            const token = window.__getAuthToken();
            if (token) {
                this._token = token;
                this._sessionVersion++;
                
                // Validate token with backend
                const validation = await window.__validateTokenWithBackend(token);
                
                if (validation.valid && validation.userId && validation.userId > 0) {
                    this._session = {
                        authenticated: true,
                        userId: validation.userId,
                        token: token,
                        user: validation.user || { id: validation.userId, username: 'User' },
                        expiresAt: validation.expiresAt || (Date.now() + 3600000),
                        fromCache: true,
                        sessionVersion: this._sessionVersion,
                        validated: true
                    };
                    this._state = SESSION_STATES.AUTHENTICATED;
                    
                    // Store validated data
                    const authData = {
                        token: token,
                        userId: validation.userId,
                        user: validation.user || { id: validation.userId, username: 'User' },
                        expiry: validation.expiresAt || (Date.now() + 3600000),
                        timestamp: Date.now(),
                        sessionVersion: this._sessionVersion,
                        validated: true
                    };
                    localStorage.setItem('kynecta_auth', JSON.stringify(authData));
                    
                    if (window.KynectaStore) {
                        window.KynectaStore.set('session', this._session);
                    }
                    return;
                } else {
                    window.__KYNECTA_LOGGER__.error('session', 'load', 'Token exists but validation failed');
                    this._session = { authenticated: false };
                    this._state = SESSION_STATES.ERROR;
                    return;
                }
            }

            this._state = SESSION_STATES.ERROR;
            this._session = { authenticated: false };
            
            if (window.KynectaStore) {
                window.KynectaStore.set('session', { authenticated: false });
            }
        }

        _setSession(sessionData) {
            this._sessionVersion++;
            this._session = { ...sessionData, sessionVersion: this._sessionVersion };
            this._token = sessionData.token;
            
            if (sessionData.guest) {
                this._state = SESSION_STATES.GUEST;
            } else {
                this._state = SESSION_STATES.AUTHENTICATED;
            }

            if (this._token) {
                window.__syncTokenToApi(this._token);
            }

            if (window.KynectaStore) {
                window.KynectaStore.set('session', this._session);
            }

            window.KynectaEventBus?.emit('SESSION_CHANGED', this._session);
        }

        _startSessionMonitoring() {
            this._sessionCheckTimer = setInterval(() => {
                this._checkSessionExpiry();
            }, 60000);

            if (this._session && !this._session.guest && this._session.expiresAt) {
                this._scheduleTokenRefresh();
            }
        }

        _checkSessionExpiry() {
            if (!this._session || !this._session.expiresAt) return;

            if (Date.now() > this._session.expiresAt) {
                this._state = SESSION_STATES.EXPIRED;
                window.KynectaEventBus?.emit('SESSION_EXPIRED');
                this.clear();
            }
        }

        _scheduleTokenRefresh() {
            if (!this._session || !this._session.expiresAt) return;

            const timeToExpiry = this._session.expiresAt - Date.now();
            const refreshTime = Math.max(0, timeToExpiry - 300000);

            if (refreshTime > 0) {
                if (this._refreshTimer) clearTimeout(this._refreshTimer);
                
                this._refreshTimer = setTimeout(() => {
                    this.refreshToken();
                }, refreshTime);
            }
        }

        async refreshToken() {
            if (!this._session || this._session.guest) return false;

            try {
                const refreshResult = await window.__attemptTokenRefresh?.();
                
                if (refreshResult?.success && refreshResult.token) {
                    this._sessionVersion++;
                    this._token = refreshResult.token;
                    this._session.token = refreshResult.token;
                    this._session.expiresAt = Date.now() + 3600000;
                    this._session.sessionVersion = this._sessionVersion;
                    
                    if (refreshResult.userId) {
                        this._session.userId = refreshResult.userId;
                        if (this._session.user) this._session.user.id = refreshResult.userId;
                    }
                    
                    window.__syncTokenToApi(refreshResult.token);
                    
                    if (window.KynectaStore) {
                        window.KynectaStore.set('session', this._session);
                    }
                    
                    const authData = {
                        token: refreshResult.token,
                        userId: this._session.userId,
                        user: this._session.user,
                        expiry: this._session.expiresAt,
                        timestamp: Date.now(),
                        sessionVersion: this._sessionVersion,
                        validated: true,
                        refreshed: true
                    };
                    localStorage.setItem('kynecta_auth', JSON.stringify(authData));
                    
                    window.KynectaEventBus?.emit('TOKEN_REFRESHED');
                    
                    window.__resetSyncHalted__?.();
                    window.KynectaEventBus?.emit('AUTH_SUCCESS', { userId: this.getUserId() });
                    
                    setTimeout(() => {
                        if (window.__propagateSessionToIframes__) {
                            window.__propagateSessionToIframes__();
                        }
                    }, 100);
                    
                    return true;
                }
                return false;
            } catch (error) {
                window.__KYNECTA_LOGGER__.error('session', 'refresh', 'Token refresh failed', { error: error.message });
                return false;
            }
        }

        getSession() {
            return this._session ? { ...this._session } : null;
        }

        getToken() {
            return this._token || window.__getAuthToken();
        }

        isAuthenticated() {
            if (!this._session || !this._session.authenticated) return false;
            const userId = window.__normalizeUserId(this._session.userId);
            return userId && userId > 0;
        }

        isGuest() {
            return this._session?.guest || false;
        }

        getUserId() {
            const userId = this._session?.userId || this._session?.user?.id;
            const normalized = window.__normalizeUserId(userId);
            return normalized && normalized > 0 ? normalized : null;
        }

        getUser() {
            return this._session?.user ? { ...this._session.user } : null;
        }

        clear() {
            this._session = null;
            this._token = null;
            this._state = SESSION_STATES.INITIAL;
            window.__TOKEN_READY__ = false;

            if (this._refreshTimer) {
                clearTimeout(this._refreshTimer);
                this._refreshTimer = null;
            }

            try {
                localStorage.removeItem('kynecta_auth');
                localStorage.removeItem('kynecta_token');
                localStorage.removeItem('kynecta_user');
            } catch (e) {}

            if (window.KynectaStore) {
                window.KynectaStore.set('session', { authenticated: false });
            }

            window.KynectaEventBus?.emit('SESSION_CLEARED');
            
            window.__SESSION_PROPAGATED__ = false;
        }

        subscribe(callback) {
            this._subscribers.add(callback);
            
            if (this._session) {
                callback(this._session);
            }
            
            return () => this._subscribers.delete(callback);
        }

        deliverToModule(moduleName, targetWindow) {
            if (!this.isAuthenticated() || !targetWindow) {
                return Promise.reject(new Error('Not authenticated or invalid target'));
            }

            return new Promise((resolve) => {
                const messageId = `session_${Date.now()}_${moduleName}`;
                const targetOrigin = window.KynectaSecurityGuard?.getTargetOrigin(moduleName) || window.location.origin;

                targetWindow.postMessage({
                    type: 'SESSION_DATA',
                    id: messageId,
                    source: 'parent',
                    target: moduleName,
                    moduleId: moduleName,
                    payload: {
                        authenticated: true,
                        userId: this.getUserId(),
                        token: this.getToken(),
                        user: this.getUser(),
                        expiresAt: this._session?.expiresAt,
                        sessionVersion: this._sessionVersion,
                        validated: true
                    },
                    timestamp: Date.now()
                }, targetOrigin);

                if (window.KynectaModuleRegistry) {
                    const module = window.KynectaModuleRegistry.get(moduleName);
                    if (module) {
                        module.sessionDelivered = true;
                    }
                }

                window.KynectaEventBus?.emit('SESSION_DELIVERED', {
                    module: moduleName,
                    timestamp: Date.now()
                });

                resolve({ success: true, module: moduleName });
            });
        }

        getState() {
            return this._state;
        }

        getStats() {
            return {
                state: this._state,
                authenticated: this.isAuthenticated(),
                guest: this.isGuest(),
                userId: this.getUserId(),
                expiresAt: this._session?.expiresAt,
                fromCache: this._session?.fromCache,
                sessionVersion: this._sessionVersion,
                validated: this._session?.validated
            };
        }

        isParentReadyBroadcasted() {
            return this._parentReadyBroadcasted;
        }

        markParentReadyBroadcasted() {
            this._parentReadyBroadcasted = true;
        }
    }

    window.KynectaSession = new SessionManager();

    window.KynectaSession.init().catch((error) => {
        window.__KYNECTA_LOGGER__.error('session', 'init', 'Session initialization failed', { error: error.message });
    });
})();
</script>

<!-- ========== SYSTEM 11: MESSAGE ROUTER ========== -->
<script>
(function() {
    'use strict';

    const REQUIRED_FIELDS = ['id', 'type', 'source', 'target', 'timestamp', 'payload'];

    const ROUTING_RULES = {
        REGISTER_MODULE: { type: 'system', handler: 'handleRegister', validate: true },
        HANDSHAKE_REQUEST: { type: 'system', handler: 'handleHandshake', validate: true },
        HANDSHAKE_ACK: { type: 'system', handler: 'handleHandshakeAck', validate: true },
        REQUEST_SESSION: { type: 'system', handler: 'handleSessionRequest', validate: true },
        VERIFY_SESSION: { type: 'system', handler: 'handleVerification', validate: true },
        HEARTBEAT: { type: 'system', handler: 'handleHeartbeat', validate: true },
        PING: { type: 'system', handler: 'handlePing', validate: true },
        ACK: { type: 'system', handler: 'handleAck', validate: true },
        API_REQUEST: { type: 'system', handler: 'handleApiRequest', validate: true },
        
        NEW_MESSAGE: { type: 'application', targets: ['messages'], validate: true },
        MESSAGE_SENT: { type: 'application', targets: ['messages'], validate: true },
        MESSAGE_RECEIVED: { type: 'application', targets: ['messages'], validate: true },
        MESSAGE_TYPING: { type: 'application', targets: ['messages'], validate: true },
        MESSAGE_DELETED: { type: 'application', targets: ['messages'], validate: true },
        MESSAGE_REACTION: { type: 'application', targets: ['messages'], validate: true },
        
        CALL_INCOMING: { type: 'application', targets: ['calls'], priority: 'high', validate: true },
        CALL_STARTED: { type: 'application', targets: ['calls'], validate: true },
        CALL_ENDED: { type: 'application', targets: ['calls'], validate: true },
        CALL_UPDATE: { type: 'application', targets: ['calls'], validate: true },
        CALL_ACCEPTED: { type: 'application', targets: ['calls'], validate: true },
        CALL_REJECTED: { type: 'application', targets: ['calls'], validate: true },
        
        FRIEND_ONLINE: { type: 'application', targets: ['friends', 'status'], validate: true },
        FRIEND_OFFLINE: { type: 'application', targets: ['friends', 'status'], validate: true },
        FRIEND_ADDED: { type: 'application', targets: ['friends', 'messages'], validate: true },
        FRIEND_REMOVED: { type: 'application', targets: ['friends'], validate: true },
        FRIEND_REQUEST_RECEIVED: { type: 'application', targets: ['friends'], validate: true },
        FRIEND_REQUEST_ACCEPTED: { type: 'application', targets: ['friends'], validate: true },
        
        GROUP_UPDATED: { type: 'application', targets: ['groups'], validate: true },
        GROUP_MESSAGE_RECEIVED: { type: 'application', targets: ['groups', 'messages'], validate: true },
        GROUP_MEMBER_JOINED: { type: 'application', targets: ['groups'], validate: true },
        GROUP_MEMBER_LEFT: { type: 'application', targets: ['groups'], validate: true },
        
        STATUS_UPDATED: { type: 'application', targets: ['status', 'friends'], validate: true },
        STATUS_DELETED: { type: 'application', targets: ['status'], validate: true },
        STATUS_REACTION: { type: 'application', targets: ['status'], validate: true },
        
        SETTINGS_UPDATED: { type: 'application', targets: ['settings'], validate: true },
        THEME_CHANGED: { type: 'application', targets: ['settings', 'messages', 'calls', 'status', 'groups', 'friends', 'tools'], validate: true },
        NOTIFICATION_SETTINGS_UPDATED: { type: 'application', targets: ['settings'], validate: true },
        
        TOOL_ACTIVATED: { type: 'application', targets: ['tools'], validate: true },
        TOOLS_EVENT: { type: 'application', targets: ['tools'], validate: true },
        
        NETWORK_ONLINE: { type: 'application', targets: ['messages', 'calls', 'status'], validate: true },
        NETWORK_OFFLINE: { type: 'application', targets: ['messages', 'calls', 'status'], validate: true },
        PARENT_READY: { type: 'application', targets: ['messages', 'status', 'groups', 'friends', 'calls', 'settings', 'tools'], validate: true },
        SESSION_ACTIVE: { type: 'application', targets: ['messages', 'status', 'groups', 'friends', 'calls', 'settings', 'tools'], validate: true },
        SESSION_DATA: { type: 'application', targets: ['messages', 'status', 'groups', 'friends', 'calls', 'settings', 'tools'], validate: true }
    };

    class MessageRouter {
        constructor() {
            this._routingRules = ROUTING_RULES;
            this._stats = {
                messagesReceived: 0,
                messagesRouted: 0,
                systemMessages: 0,
                applicationMessages: 0,
                errors: 0,
                dropped: 0,
                validationFailed: 0
            };
            this._handlers = new Map();
            this._processedMessages = new Set();
            this._messageQueue = [];
            this._processing = false;
            this._initialized = false;
        }

        init() {
            if (this._initialized) return this;
            
            this._registerSystemHandlers();

            this._processQueue();

            this._initialized = true;
            return this;
        }

        validateMessage(message) {
            if (!message || typeof message !== 'object') return false;
            
            const hasId = !!message.id;
            const hasType = !!message.type;
            const hasSource = !!message.source;
            const hasTarget = !!message.target;
            const hasTimestamp = !!message.timestamp;
            const hasPayload = message.payload !== undefined;
            
            return hasId && hasType && hasSource && hasTarget && hasTimestamp && hasPayload;
        }

        normalizeMessage(message) {
            return {
                id: message.id || message.messageId || message.requestId || `msg_${Date.now()}`,
                type: message.type || message.action || 'unknown',
                source: message.source || message.from || message.sender || 'unknown',
                target: message.target || message.to || message.destination || '*',
                payload: message.payload || message.data || {},
                timestamp: message.timestamp || Date.now(),
                _original: message
            };
        }

        _registerSystemHandlers() {
            const systemHandlers = {
                handleRegister: (data, source, origin, module) => this._handleRegister(data, source, origin, module),
                handleHandshake: (data, source, origin, module) => this._handleHandshake(data, source, origin, module),
                handleHandshakeAck: (data, source, origin, module) => this._handleHandshakeAck(data, source, origin, module),
                handleSessionRequest: (data, source, origin, module) => this._handleSessionRequest(data, source, origin, module),
                handleVerification: (data, source, origin, module) => this._handleVerification(data, source, origin, module),
                handleHeartbeat: (data, source, origin, module) => this._handleHeartbeat(data, source, origin, module),
                handlePing: (data, source, origin, module) => this._handlePing(data, source, origin, module),
                handleAck: (data, source, origin, module) => this._handleAck(data, source, origin, module),
                handleApiRequest: (data, source, origin, module) => this._handleApiRequest(data, source, origin, module)
            };

            this._handlers = systemHandlers;
        }

        route(message, source, origin) {
            this._messageQueue.push({
                message,
                source,
                origin,
                timestamp: Date.now()
            });

            if (!this._processing) {
                setTimeout(() => this._processQueue(), 0);
            }

            return true;
        }

        async _processQueue() {
            if (this._processing) return;
            if (this._messageQueue.length === 0) return;

            this._processing = true;

            try {
                while (this._messageQueue.length > 0) {
                    const item = this._messageQueue.shift();
                    
                    if (Date.now() - item.timestamp > 30000) {
                        continue;
                    }

                    this._processMessage(item.message, item.source, item.origin);

                    if (this._messageQueue.length % 10 === 0) {
                        await new Promise(resolve => setTimeout(resolve, 0));
                    }
                }
            } finally {
                this._processing = false;
                
                if (this._messageQueue.length > 0) {
                    setTimeout(() => this._processQueue(), 0);
                }
            }
        }

        _processMessage(message, source, origin) {
            this._stats.messagesReceived++;

            if (!this.validateMessage(message)) {
                this._stats.validationFailed++;
                this._stats.dropped++;
                window.__KYNECTA_LOGGER__.warn('router', 'validation', 'Message validation failed');
                return false;
            }

            const normalized = this.normalizeMessage(message);

            if (normalized.id) {
                if (this._processedMessages.has(normalized.id)) {
                    this._stats.dropped++;
                    return false;
                }
                this._processedMessages.add(normalized.id);
                
                if (this._processedMessages.size > 1000) {
                    this._processedMessages.clear();
                }
            }

            const sourceModule = this._identifySourceModule(source);
            
            const rule = this._routingRules[normalized.type];
            
            if (rule) {
                if (rule.type === 'system') {
                    this._stats.systemMessages++;
                    return this._handleSystemMessage(normalized, source, origin, sourceModule, rule.handler);
                } else {
                    this._stats.applicationMessages++;
                    this._stats.messagesRouted++;
                    return this._routeApplicationMessage(normalized, sourceModule, rule.targets);
                }
            } else {
                this._routeUnknownMessage(normalized, sourceModule);
                return true;
            }
        }

        _routeUnknownMessage(message, sourceModule) {
            if (message.target && message.target !== '*') {
                this._routeApplicationMessage(message, sourceModule, [message.target]);
            }
        }

        _identifySourceModule(source) {
            if (!source) return null;
            
            return window.KynectaModuleRegistry?.getByWindow(source)?.name || null;
        }

        _handleSystemMessage(message, source, origin, sourceModule, handlerName) {
            const handler = this._handlers[handlerName];
            if (!handler) {
                this._stats.errors++;
                return false;
            }

            try {
                handler(message, source, origin, sourceModule);
                return true;
            } catch (error) {
                this._stats.errors++;
                window.__KYNECTA_LOGGER__.error('router', message.id, 'System handler error', { error: error.message });
                return false;
            }
        }

        _routeApplicationMessage(message, sourceModule, targets) {
            if (!targets || targets.length === 0) return false;

            const moduleIds = window.KynectaModuleRegistry?.getModuleIds() || {};
            let routed = false;

            for (const target of targets) {
                if (target === sourceModule && !message.includeSource) {
                    continue;
                }

                if (!window.KynectaModuleRegistry?.isValidAndRegistered(target)) {
                    continue;
                }

                const iframeId = moduleIds[target];
                if (!iframeId) continue;

                const iframe = document.getElementById(iframeId);
                if (!iframe || !iframe.contentWindow) {
                    window.KynectaModuleRegistry?.queueMessage(target, message);
                    routed = true;
                    continue;
                }

                const targetOrigin = window.KynectaSecurityGuard?.getTargetOrigin(target) || window.location.origin;

                try {
                    iframe.contentWindow.postMessage({
                        ...message,
                        _routed: true,
                        _routerTimestamp: Date.now()
                    }, targetOrigin);
                    routed = true;
                } catch (error) {
                    this._stats.errors++;
                    window.__KYNECTA_LOGGER__.error('router', message.id, 'Failed to route message', { error: error.message });
                }
            }

            return routed;
        }

        _handleRegister(data, source, origin, sourceModule) {
            const moduleName = data.payload?.module || data.module || sourceModule;
            
            if (!moduleName) return;

            const existingModule = window.KynectaModuleRegistry?.get(moduleName);
            if (existingModule && existingModule.registered && existingModule.state === 'active') {
                if (source) {
                    source.postMessage({
                        type: 'MODULE_REGISTERED',
                        id: `resp_${data.id}`,
                        source: 'parent',
                        target: moduleName,
                        payload: { success: true, module: moduleName, timestamp: Date.now(), cached: true },
                        timestamp: Date.now()
                    }, origin);

                    source.postMessage({
                        type: 'ACK',
                        id: `ack_${data.id}`,
                        source: 'parent',
                        target: moduleName,
                        payload: { success: true, module: moduleName, cached: true },
                        timestamp: Date.now()
                    }, origin);
                }
                return;
            }

            const canAttempt = window.KynectaModuleRegistry?.incrementRegistrationAttempt(moduleName);
            if (!canAttempt) {
                window.KynectaModuleRegistry?.setState(moduleName, 'lockdown');
                window.KynectaRecovery?.recoverModule(moduleName, 'max_registration_attempts');
                
                if (source) {
                    source.postMessage({
                        type: 'MODULE_REGISTRATION_FAILED',
                        id: `resp_${data.id}`,
                        source: 'parent',
                        target: moduleName,
                        payload: { success: false, reason: 'max_attempts_exceeded' },
                        timestamp: Date.now()
                    }, origin);
                }
                return;
            }

            const registered = window.KynectaModuleRegistry?.register(moduleName, source, data.payload?.metadata || {});

            if (source) {
                source.postMessage({
                    type: 'MODULE_REGISTERED',
                    id: `resp_${data.id}`,
                    source: 'parent',
                    target: moduleName,
                    payload: { success: !!registered, module: moduleName, timestamp: Date.now() },
                    timestamp: Date.now()
                }, origin);

                source.postMessage({
                    type: 'ACK',
                    id: `ack_${data.id}`,
                    source: 'parent',
                    target: moduleName,
                    payload: { success: true, module: moduleName },
                    timestamp: Date.now()
                }, origin);

                window.KynectaSecurityGuard?.registerIframeOrigin(
                    window.KynectaModuleRegistry?.get(moduleName)?.iframeId,
                    origin
                );

                if (registered && window.KynectaSession?.isAuthenticated()) {
                    setTimeout(() => {
                        window.KynectaSession.deliverToModule(moduleName, source).catch(() => {});
                    }, 10);
                }

                if (window.KynectaLifecycle?.isReady()) {
                    setTimeout(() => {
                        source.postMessage({
                            type: 'PARENT_READY',
                            id: `ready_${Date.now()}`,
                            source: 'parent',
                            target: moduleName,
                            payload: { timestamp: Date.now(), protocol: 'KYN-8.0' },
                            timestamp: Date.now()
                        }, origin);
                    }, 5);
                }
            }

            window.KynectaEventBus?.emit('MODULE_REGISTERED', { module: moduleName, success: registered });
        }

        _handleHandshake(data, source, origin, sourceModule) {
            if (!sourceModule || !source) return;

            window.KynectaModuleRegistry?.setState(sourceModule, 'registering');

            source.postMessage({
                type: 'HANDSHAKE_ACK',
                id: `hs_ack_${data.id}`,
                source: 'parent',
                target: sourceModule,
                payload: {
                    success: true,
                    module: sourceModule,
                    timestamp: Date.now()
                },
                timestamp: Date.now()
            }, origin);

            window.KynectaEventBus?.emit('HANDSHAKE_COMPLETED', { module: sourceModule });
        }

        _handleHandshakeAck(data, source, origin, sourceModule) {
            if (!sourceModule) return;

            window.KynectaModuleRegistry?.setState(sourceModule, 'active', {
                handshakeComplete: true
            });

            window.KynectaEventBus?.emit('MODULE_ACTIVE', { module: sourceModule });
        }

        _handleSessionRequest(data, source, origin, sourceModule) {
            if (!sourceModule || !source) return;

            if (window.KynectaSession?.isAuthenticated()) {
                window.KynectaSession.deliverToModule(sourceModule, source).catch(() => {});
            } else {
                source.postMessage({
                    type: 'SESSION_DATA',
                    id: `session_${data.id}`,
                    source: 'parent',
                    target: sourceModule,
                    payload: { authenticated: false },
                    timestamp: Date.now()
                }, origin);
            }

            source.postMessage({
                type: 'ACK',
                id: `ack_${data.id}`,
                source: 'parent',
                target: sourceModule,
                payload: { success: true },
                timestamp: Date.now()
            }, origin);
        }

        _handleVerification(data, source, origin, sourceModule) {
            if (!source) return;

            const authenticated = window.KynectaSession?.isAuthenticated() || false;
            const userId = window.KynectaSession?.getUserId() || null;

            source.postMessage({
                type: 'SESSION_VERIFIED',
                id: `verify_${data.id}`,
                source: 'parent',
                target: sourceModule,
                payload: {
                    valid: authenticated,
                    userId: userId,
                    expiresAt: window.KynectaSession?.getSession()?.expiresAt
                },
                timestamp: Date.now()
            }, origin);

            source.postMessage({
                type: 'VERIFY_RESPONSE',
                id: `verify_resp_${data.id}`,
                source: 'parent',
                target: sourceModule,
                payload: { valid: authenticated, userId: userId },
                timestamp: Date.now()
            }, origin);

            source.postMessage({
                type: 'ACK',
                id: `ack_${data.id}`,
                source: 'parent',
                target: sourceModule,
                payload: { success: true, valid: authenticated },
                timestamp: Date.now()
            }, origin);
        }

        _handleHeartbeat(data, source, origin, sourceModule) {
            if (!sourceModule) return;

            window.KynectaModuleRegistry?.heartbeat(sourceModule);

            source.postMessage({
                type: 'HEARTBEAT_ACK',
                id: `hb_ack_${data.id}`,
                source: 'parent',
                target: sourceModule,
                payload: { timestamp: Date.now() },
                timestamp: Date.now()
            }, origin);

            if (data.expectAck) {
                source.postMessage({
                    type: 'ACK',
                    id: `ack_${data.id}`,
                    source: 'parent',
                    target: sourceModule,
                    payload: { success: true },
                    timestamp: Date.now()
                }, origin);
            }
        }

        _handlePing(data, source, origin, sourceModule) {
            if (!source) return;

            source.postMessage({
                type: 'PONG',
                id: `pong_${data.id}`,
                source: 'parent',
                target: sourceModule,
                payload: { timestamp: Date.now(), echo: data.payload },
                timestamp: Date.now()
            }, origin);
        }

        _handleAck(data, source, origin, sourceModule) {
            if (!data.id) return;

            window.KynectaReliability?.handleAck(data.id, data.payload);
        }

        _handleApiRequest(data, source, origin, sourceModule) {
            if (!source || !sourceModule) return;

            const { requestId, endpoint, method = 'GET', body = null, headers = {} } = data.payload || data;
            
            if (!requestId || !endpoint) {
                source.postMessage({
                    type: 'API_RESPONSE',
                    id: `api_err_${Date.now()}`,
                    requestId: requestId || 'unknown',
                    source: 'parent',
                    target: sourceModule,
                    payload: {
                        success: false,
                        error: 'Missing requestId or endpoint'
                    },
                    timestamp: Date.now()
                }, origin);
                return;
            }

            const handleApiRequestAsync = async () => {
                try {
                    let result;
                    if (window.API && typeof window.API.request === 'function') {
                        result = await window.API.request(endpoint, { method, body, headers });
                    } else if (window.api?.core?.fetch) {
                        result = await window.api.core.fetch(endpoint, { method, body, headers });
                    } else {
                        const token = window.__getAuthToken();
                        const response = await fetch(endpoint, {
                            method,
                            headers: {
                                'Content-Type': 'application/json',
                                'Authorization': token ? `Bearer ${token}` : '',
                                ...headers
                            },
                            body: body ? JSON.stringify(body) : undefined
                        });
                        result = await response.json();
                    }
                    
                    source.postMessage({
                        type: 'API_RESPONSE',
                        id: `api_resp_${requestId}`,
                        requestId: requestId,
                        source: 'parent',
                        target: sourceModule,
                        payload: {
                            success: true,
                            data: result
                        },
                        timestamp: Date.now()
                    }, origin);
                } catch (error) {
                    source.postMessage({
                        type: 'API_RESPONSE',
                        id: `api_err_${requestId}`,
                        requestId: requestId,
                        source: 'parent',
                        target: sourceModule,
                        payload: {
                            success: false,
                            error: error.message || 'API request failed'
                        },
                        timestamp: Date.now()
                    }, origin);
                }
            };

            handleApiRequestAsync();
        }

        getStats() {
            return {
                ...this._stats,
                processedMessages: this._processedMessages.size,
                queueSize: this._messageQueue.length
            };
        }
    }

    window.KynectaMessageRouter = new MessageRouter().init();
})();
</script>

<!-- ========== SYSTEM 12: HANDSHAKE MANAGER (PASSIVE) ========== -->
<script>
(function() {
    'use strict';

    const HANDSHAKE_STATES = {
        NONE: 'none',
        PENDING: 'pending',
        IN_PROGRESS: 'in_progress',
        WAITING_FOR_PARENT: 'waiting_for_parent',
        REGISTERING: 'registering',
        REGISTERED: 'registered',
        COMPLETED: 'completed',
        FAILED: 'failed',
        TIMEOUT: 'timeout',
        LOCKDOWN: 'lockdown'
    };

    const MAX_RETRY_LIMIT = 1;
    const HANDSHAKE_TIMEOUT = 8000;

    class HandshakeManager {
        constructor() {
            this._handshakes = new Map();
            this._maxRetries = MAX_RETRY_LIMIT;
            this._timeout = HANDSHAKE_TIMEOUT;
            this._stats = {
                initiated: 0,
                completed: 0,
                failed: 0,
                timeout: 0,
                lockdown: 0
            };
            this._initialized = false;
        }

        init() {
            if (this._initialized) return this;
            
            window.KynectaEventBus?.on('MODULE_REGISTERED', (data) => {
                if (data.module && data.success) {
                }
            });

            this._initialized = true;
            return this;
        }

        handleHandshakeRequest(moduleName, source, origin) {
            if (!moduleName || !source) return false;

            const normalizedName = window.KynectaModuleRegistry?.normalizeModuleName(moduleName);
            if (!normalizedName) return false;

            const module = window.KynectaModuleRegistry?.get(normalizedName);
            
            if (module && (module.state === 'active' || module.state === 'completed')) {
                source.postMessage({
                    type: 'HANDSHAKE_ACK',
                    id: `hs_ack_${Date.now()}`,
                    source: 'parent',
                    target: normalizedName,
                    payload: {
                        success: true,
                        module: normalizedName,
                        timestamp: Date.now(),
                        cached: true
                    },
                    timestamp: Date.now()
                }, origin);
                return true;
            }

            if (module?.state === HANDSHAKE_STATES.LOCKDOWN) {
                return false;
            }

            this._stats.initiated++;

            const handshake = {
                state: HANDSHAKE_STATES.IN_PROGRESS,
                lastAttempt: Date.now()
            };
            this._handshakes.set(normalizedName, handshake);

            window.KynectaModuleRegistry?.setState(normalizedName, 'registering');

            source.postMessage({
                type: 'HANDSHAKE_ACK',
                id: `hs_ack_${Date.now()}`,
                source: 'parent',
                target: normalizedName,
                payload: {
                    success: true,
                    module: normalizedName,
                    timestamp: Date.now()
                },
                timestamp: Date.now()
            }, origin);

            this._stats.completed++;
            handshake.state = HANDSHAKE_STATES.COMPLETED;

            window.KynectaEventBus?.emit('HANDSHAKE_COMPLETED', { module: normalizedName });

            return true;
        }

        getStatus(moduleName) {
            const normalizedName = window.KynectaModuleRegistry?.normalizeModuleName(moduleName);
            if (!normalizedName) return { state: HANDSHAKE_STATES.NONE };
            
            const handshake = this._handshakes.get(normalizedName);
            if (!handshake) {
                return { state: HANDSHAKE_STATES.NONE };
            }

            return {
                state: handshake.state,
                lastAttempt: handshake.lastAttempt
            };
        }

        getStats() {
            return {
                ...this._stats,
                active: Array.from(this._handshakes.entries())
                    .filter(([_, h]) => h.state === HANDSHAKE_STATES.IN_PROGRESS)
                    .map(([name]) => name),
                lockdown: Array.from(this._handshakes.entries())
                    .filter(([_, h]) => h.state === HANDSHAKE_STATES.LOCKDOWN)
                    .map(([name]) => name)
            };
        }

        reset(moduleName) {
            const normalizedName = window.KynectaModuleRegistry?.normalizeModuleName(moduleName);
            if (normalizedName) {
                this._handshakes.delete(normalizedName);
                window.KynectaModuleRegistry?.reset(normalizedName);
            }
        }

        isLockdown(moduleName) {
            const normalizedName = window.KynectaModuleRegistry?.normalizeModuleName(moduleName);
            if (!normalizedName) return true;
            
            const handshake = this._handshakes.get(normalizedName);
            return handshake?.state === HANDSHAKE_STATES.LOCKDOWN;
        }
    }

    window.KynectaHandshake = new HandshakeManager().init();
})();
</script>

<!-- ========== SYSTEM 13: HEARTBEAT MONITOR ========== -->
<script>
(function() {
    'use strict';

    class HeartbeatMonitor {
        constructor() {
            this._checkInterval = null;
            this._degradedModules = new Set();
            this._stats = {
                heartbeatsReceived: 0,
                timeouts: 0,
                recoveries: 0,
                degraded: 0
            };
            this._initialized = false;
            this._started = false;
        }

        init() {
            if (this._initialized) return this;
            
            window.KynectaEventBus?.on('HEARTBEAT_RECEIVED', (data) => {
                this.receiveHeartbeat(data.module);
            });

            window.KynectaEventBus?.on('MODULE_ACTIVE', (data) => {
                if (data.module && !this._started) {
                    this.start();
                }
            });

            this._initialized = true;
            return this;
        }

        start() {
            if (this._checkInterval || this._started) return;

            this._checkInterval = setInterval(() => {
                this._checkHeartbeats();
            }, 30000);

            this._started = true;
        }

        stop() {
            if (this._checkInterval) {
                clearInterval(this._checkInterval);
                this._checkInterval = null;
            }
            this._started = false;
        }

        receiveHeartbeat(moduleName) {
            this._stats.heartbeatsReceived++;

            const updated = window.KynectaModuleRegistry?.heartbeat(moduleName);
            
            if (updated && this._degradedModules.has(moduleName)) {
                this._degradedModules.delete(moduleName);
                this._stats.recoveries++;
                this._stats.degraded = this._degradedModules.size;
                
                window.KynectaEventBus?.emit('MODULE_RECOVERED', { module: moduleName });
            }
        }

        _checkHeartbeats() {
            const now = Date.now();
            const registeredModules = window.KynectaModuleRegistry?.getRegistered() || [];

            for (const moduleName of registeredModules) {
                const module = window.KynectaModuleRegistry?.get(moduleName);
                if (!module || !module.registered) continue;

                if (module.state !== 'active') continue;

                const timeSinceHeartbeat = now - module.lastHeartbeat;

                if (timeSinceHeartbeat > 90000) {
                    if (!this._degradedModules.has(moduleName) && module.state !== 'lockdown') {
                        this._degradedModules.add(moduleName);
                        this._stats.timeouts++;
                        this._stats.degraded = this._degradedModules.size;

                        window.KynectaModuleRegistry?.setState(moduleName, 'degraded');

                        window.KynectaEventBus?.emit('MODULE_DEGRADED', {
                            module: moduleName,
                            timeSinceHeartbeat
                        });

                        this._triggerRecovery(moduleName);
                    }
                }
            }
        }

        _triggerRecovery(moduleName) {
            const module = window.KynectaModuleRegistry?.get(moduleName);
            if (!module) return;

            if (module.state === 'lockdown') return;

            if (window.KynectaRecovery) {
                window.KynectaRecovery.recoverModule(moduleName, 'heartbeat_timeout').catch(() => {});
            }

            if (window.KynectaReliability) {
                window.KynectaReliability.clearPendingForModule(moduleName);
            }

            window.KynectaEventBus?.emit('MODULE_RECOVERY_ATTEMPTED', { module: moduleName });
        }

        getStats() {
            return {
                ...this._stats,
                degradedModules: Array.from(this._degradedModules)
            };
        }

        isDegraded(moduleName) {
            return this._degradedModules.has(moduleName);
        }
    }

    window.KynectaHeartbeat = new HeartbeatMonitor().init();
})();
</script>

<!-- ========== SYSTEM 14: RECOVERY MANAGER ========== -->
<script>
(function() {
    'use strict';

    class RecoveryManager {
        constructor() {
            this._recoveryAttempts = new Map();
            this._maxAttempts = 2;
            this._cooldownPeriod = 60000;
            this._recoveryStrategies = new Map();
            this._stats = {
                recoveryAttempted: 0,
                recoverySucceeded: 0,
                recoveryFailed: 0,
                systemRecoveries: 0,
                lockdown: 0
            };
            this._initialized = false;
        }

        init() {
            if (this._initialized) return this;
            
            this._registerDefaultStrategies();

            window.KynectaEventBus?.on('MODULE_DEGRADED', (data) => {
                this.recoverModule(data.module, 'heartbeat_timeout');
            });

            window.KynectaEventBus?.on('HANDSHAKE_FAILED', (data) => {
                this.recoverModule(data.module, 'handshake_failed');
            });

            window.KynectaEventBus?.on('HANDSHAKE_LOCKDOWN', (data) => {
                this._handleLockdown(data.module, data.reason);
            });

            window.addEventListener('online', () => {
                this._handleNetworkOnline();
            });

            this._initialized = true;
            return this;
        }

        _registerDefaultStrategies() {
            const modules = ['messages', 'calls', 'friends', 'groups', 'status', 'settings', 'tools'];
            
            modules.forEach(module => {
                this.registerStrategy(module, async (module, reason) => {
                    return this._reloadIframe(module, reason);
                });
            });
        }

        registerStrategy(moduleName, strategy) {
            const normalizedName = window.KynectaModuleRegistry?.normalizeModuleName(moduleName);
            if (normalizedName) {
                this._recoveryStrategies.set(normalizedName, strategy);
            }
        }

        _handleLockdown(moduleName, reason) {
            this._stats.lockdown++;
            
            const recovery = this._recoveryAttempts.get(moduleName) || {
                attempts: 0,
                lastAttempt: 0,
                state: 'lockdown'
            };
            recovery.state = 'lockdown';
            this._recoveryAttempts.set(moduleName, recovery);

            window.KynectaEventBus?.emit('MODULE_LOCKDOWN', { module: moduleName, reason });
        }

        async recoverModule(moduleName, reason) {
            const normalizedName = window.KynectaModuleRegistry?.normalizeModuleName(moduleName);
            if (!normalizedName) {
                return { success: false, reason: 'invalid_module' };
            }

            const module = window.KynectaModuleRegistry?.get(normalizedName);
            if (module?.state === 'lockdown') {
                return { success: false, reason: 'module_in_lockdown' };
            }

            this._stats.recoveryAttempted++;

            const recovery = this._recoveryAttempts.get(normalizedName) || {
                attempts: 0,
                lastAttempt: 0,
                state: 'ok'
            };

            const now = Date.now();
            if (now - recovery.lastAttempt < this._cooldownPeriod) {
                return { success: false, reason: 'in_cooldown' };
            }

            if (recovery.attempts >= this._maxAttempts) {
                recovery.state = 'failed';
                this._recoveryAttempts.set(normalizedName, recovery);
                this._stats.recoveryFailed++;
                
                window.KynectaEventBus?.emit('MODULE_RECOVERY_FAILED', {
                    module: normalizedName,
                    reason: 'max_attempts_exceeded'
                });
                
                return { success: false, reason: 'max_attempts_exceeded' };
            }

            const strategy = this._recoveryStrategies.get(normalizedName) || this._defaultRecovery;
            
            recovery.attempts++;
            recovery.lastAttempt = now;
            recovery.state = 'recovering';
            this._recoveryAttempts.set(normalizedName, recovery);

            window.KynectaEventBus?.emit('MODULE_RECOVERING', {
                module: normalizedName,
                attempt: recovery.attempts,
                reason
            });

            try {
                const result = await strategy(normalizedName, reason);
                
                if (result.success) {
                    recovery.state = 'ok';
                    recovery.attempts = 0;
                    this._stats.recoverySucceeded++;
                    
                    window.KynectaEventBus?.emit('MODULE_RECOVERED', {
                        module: normalizedName
                    });
                    
                    return result;
                } else {
                    throw new Error(result.error || 'Recovery failed');
                }
            } catch (error) {
                if (recovery.attempts >= this._maxAttempts) {
                    recovery.state = 'failed';
                    this._stats.recoveryFailed++;
                    
                    window.KynectaEventBus?.emit('MODULE_RECOVERY_FAILED', {
                        module: normalizedName,
                        reason: error.message
                    });
                }
                
                return { success: false, error: error.message };
            } finally {
                this._recoveryAttempts.set(normalizedName, recovery);
            }
        }

        _defaultRecovery = async (moduleName, reason) => {
            return this._reloadIframe(moduleName, reason);
        }

        async _reloadIframe(moduleName, reason) {
            const module = window.KynectaModuleRegistry?.get(moduleName);
            if (!module || !module.iframe) {
                return { success: false, error: 'module_not_found' };
            }

            const iframe = module.iframe;
            const currentSrc = iframe.src;

            window.KynectaModuleRegistry?.setState(moduleName, 'recovering');

            if (window.KynectaHandshake) {
                window.KynectaHandshake.reset(moduleName);
            }

            if (window.KynectaReliability) {
                window.KynectaReliability.clearPendingForModule(moduleName);
            }

            return new Promise((resolve) => {
                const loadHandler = () => {
                    iframe.removeEventListener('load', loadHandler);
                    
                    setTimeout(() => {
                        if (window.KynectaModuleRegistry) {
                            window.KynectaModuleRegistry.reset(moduleName);
                        }
                        
                        resolve({ success: true });
                    }, 500);
                };

                iframe.addEventListener('load', loadHandler);
                
                const separator = currentSrc.includes('?') ? '&' : '?';
                iframe.src = `${currentSrc}${separator}_recovery=${Date.now()}`;
            });
        }

        _handleNetworkOnline() {
            this._stats.systemRecoveries++;

            for (const [moduleName, recovery] of this._recoveryAttempts.entries()) {
                const module = window.KynectaModuleRegistry?.get(moduleName);
                if (recovery.state === 'failed' && module?.state !== 'lockdown') {
                    this.recoverModule(moduleName, 'network_recovered').catch(() => {});
                }
            }

            if (window.KynectaRealtime) {
                const token = window.__getAuthToken();
                if (token) {
                    window.KynectaRealtime.connect().catch(() => {});
                }
            }

            if (window.KynectaOfflineQueue) {
                window.KynectaOfflineQueue.process();
            }
        }

        getStatus(moduleName) {
            const normalizedName = window.KynectaModuleRegistry?.normalizeModuleName(moduleName);
            if (!normalizedName) return { attempts: 0, lastAttempt: 0, state: 'unknown' };
            
            return this._recoveryAttempts.get(normalizedName) || {
                attempts: 0,
                lastAttempt: 0,
                state: 'ok'
            };
        }

        getStats() {
            return {
                ...this._stats,
                modules: Array.from(this._recoveryAttempts.entries()).map(([name, data]) => ({
                    module: name,
                    ...data
                }))
            };
        }

        reset(moduleName) {
            const normalizedName = window.KynectaModuleRegistry?.normalizeModuleName(moduleName);
            if (normalizedName) {
                this._recoveryAttempts.delete(normalizedName);
            } else if (!moduleName) {
                this._recoveryAttempts.clear();
            }
        }
    }

    window.KynectaRecovery = new RecoveryManager().init();
})();
</script>

<!-- ========== SYSTEM 15: PARENT LIFECYCLE CONTROLLER ========== -->
<script>
(function() {
    'use strict';

    const LIFECYCLE_STATES = {
        BOOT: 'boot',
        INITIALIZING: 'initializing',
        READY: 'ready',
        WAIT_PARENT: 'wait_parent',
        ACTIVE: 'active'
    };

    class LifecycleController {
        constructor() {
            this._state = LIFECYCLE_STATES.BOOT;
            this._initStartTime = Date.now();
            this._initComplete = false;
            this._parentReady = false;
            this._parentReadyBroadcasted = false;
            this._components = new Map();
            this._listeners = new Set();
            this._initialized = false;
            this._registrationBarrierPassed = false;
            window.__PARENT_READY_PROMISE__ = new Promise((resolve) => {
                this._resolveParentReady = resolve;
            });
            
            window.__PARENT_READY_STATE__ = 'BOOT';
        }

        async init() {
            if (this._initialized) return this;
            
            this._state = LIFECYCLE_STATES.INITIALIZING;
            window.__PARENT_READY_STATE__ = 'INITIALIZING';

            // Wait for token to be available
            const checkToken = () => {
                const token = localStorage.getItem('token');
                if (!token) {
                    window.__KYNECTA_LOGGER__.warn('lifecycle', 'init', 'Waiting for token to be available');
                    setTimeout(checkToken, 500);
                } else {
                    window.__KYNECTA_LOGGER__.info('lifecycle', 'init', 'Token available, continuing initialization');
                    this._continueInit();
                }
            };
            checkToken();
            
            return this;
        }

        async _continueInit() {
            const initOrder = [
                { name: 'EventBus', check: () => window.KynectaEventBus },
                { name: 'StateStore', check: () => window.KynectaStore },
                { name: 'APIServices', check: () => window.API },
                { name: 'Realtime', check: () => window.KynectaRealtime },
                { name: 'SyncManager', check: () => window.KynectaSyncManager },
                { name: 'OfflineQueue', check: () => window.KynectaOfflineQueue },
                { name: 'ModuleRegistry', check: () => window.KynectaModuleRegistry },
                { name: 'SecurityGuard', check: () => window.KynectaSecurityGuard },
                { name: 'Reliability', check: () => window.KynectaReliability },
                { name: 'SessionManager', check: () => window.KynectaSession },
                { name: 'MessageRouter', check: () => window.KynectaMessageRouter },
                { name: 'HandshakeManager', check: () => window.KynectaHandshake },
                { name: 'HeartbeatMonitor', check: () => window.KynectaHeartbeat },
                { name: 'RecoveryManager', check: () => window.KynectaRecovery }
            ];

            for (const component of initOrder) {
                try {
                    await this._waitForComponent(component.name, component.check);
                    this._components.set(component.name, { initialized: true, timestamp: Date.now() });
                } catch (error) {
                    this._components.set(component.name, { initialized: false, error: error.message });
                    window.__KYNECTA_LOGGER__.error('lifecycle', component.name, 'Component initialization failed', { error: error.message });
                }
            }

            const criticalComponents = ['EventBus', 'StateStore', 'SessionManager', 'ModuleRegistry', 'MessageRouter'];
            const criticalFailed = criticalComponents.filter(
                name => !this._components.get(name)?.initialized
            );

            if (criticalFailed.length > 0) {
                this._state = LIFECYCLE_STATES.BOOT;
                window.__PARENT_READY_STATE__ = 'BOOT';
                window.__KYNECTA_LOGGER__.error('lifecycle', 'init', 'Critical components failed', { failed: criticalFailed });
            } else {
                this._state = LIFECYCLE_STATES.READY;
                window.__PARENT_READY_STATE__ = 'READY';
                this._initComplete = true;
                this._parentReady = true;
                this._resolveParentReady();
            }

            window.KynectaEventBus?.emit('LIFECYCLE_READY', {
                state: this._state,
                initTime: Date.now() - this._initStartTime,
                components: Array.from(this._components.entries())
            });

            this._initialized = true;
        }

        _waitForComponent(name, checkFn, timeout = 10000) {
            return new Promise((resolve, reject) => {
                const start = Date.now();
                
                const check = () => {
                    try {
                        if (checkFn()) {
                            resolve();
                            return;
                        }
                    } catch (e) {}

                    if (Date.now() - start > timeout) {
                        reject(new Error(`Timeout waiting for ${name}`));
                        return;
                    }

                    setTimeout(check, 100);
                };

                check();
            });
        }

        isReady() {
            return this._parentReady;
        }

        getState() {
            return this._state;
        }

        getComponentStatus() {
            return Array.from(this._components.entries()).map(([name, info]) => ({
                name,
                ...info
            }));
        }

        getStats() {
            return {
                state: this._state,
                initTime: Date.now() - this._initStartTime,
                initComplete: this._initComplete,
                parentReady: this._parentReady,
                components: this.getComponentStatus()
            };
        }

        subscribe(listener) {
            this._listeners.add(listener);
            
            listener({
                state: this._state,
                initComplete: this._initComplete,
                parentReady: this._parentReady,
                timestamp: Date.now()
            });
            
            return () => this._listeners.delete(listener);
        }
    }

    window.KynectaLifecycle = new LifecycleController();

    window.KynectaLifecycle.init().catch(error => {
        window.__KYNECTA_LOGGER__.error('lifecycle', 'init', 'Lifecycle initialization failed', { error: error.message });
    });
})();
</script>

<!-- ========== IFRAME INITIALIZATION ========== -->
<script>
(function() {
    'use strict';
    
    const IFRAME_CONFIG = [
        { id: 'messagesIframe', src: 'message.html', critical: true },
        { id: 'statusIframe', src: 'status.html', critical: false },
        { id: 'groupIframe', src: 'group.html', critical: false },
        { id: 'friendsIframe', src: 'friend.html', critical: false },
        { id: 'callsIframe', src: 'calls.html', critical: false },
        { id: 'settingsIframe', src: 'settings.html', critical: false },
        { id: 'toolsIframe', src: 'Tools.html', critical: false }
    ];

    function initializeIframes() {
        IFRAME_CONFIG.forEach(config => {
            const iframe = document.getElementById(config.id);
            if (iframe && iframe.src === 'about:blank') {
                setTimeout(() => {
                    iframe.src = config.src;
                }, config.critical ? 0 : 100);
            }
        });
    }

    initializeIframes();
    
    window.addEventListener('load', function() {
        setTimeout(initializeIframes, 100);
    });
})();
</script>

<!-- ========== SESSION PROPAGATION ========== -->
<script>
(function() {
    'use strict';

    function getFullSessionPayload() {
        try {
            // Check direct token first with validation
            const directToken = localStorage.getItem('token');
            if (directToken && directToken !== 'undefined' && directToken !== 'null') {
                // Check if we have validated auth data
                const authData = localStorage.getItem('kynecta_auth');
                if (authData) {
                    const parsed = JSON.parse(authData);
                    if (parsed.validated && parsed.userId && parsed.userId > 0) {
                        return {
                            authenticated: true,
                            token: directToken,
                            tokenPresent: true,
                            userId: parsed.userId,
                            user: parsed.user || { id: parsed.userId, username: 'User' },
                            expiresAt: parsed.expiry || (Date.now() + 3600000),
                            sessionVersion: window.__PARENT_SESSION__?.sessionVersion || 0,
                            validated: true
                        };
                    }
                }
                
                return { authenticated: false };
            }
            
            const authData = localStorage.getItem('kynecta_auth');
            if (authData) {
                const parsed = JSON.parse(authData);
                if (parsed && parsed.token && parsed.validated && parsed.userId && parsed.userId > 0) {
                    return {
                        authenticated: true,
                        token: parsed.token,
                        tokenPresent: true,
                        userId: parsed.userId,
                        user: parsed.user || { id: parsed.userId, username: 'User' },
                        expiresAt: parsed.expiry || (Date.now() + 3600000),
                        sessionVersion: window.__PARENT_SESSION__?.sessionVersion || 0,
                        validated: true
                    };
                }
            }
            
            return { authenticated: false };
        } catch (e) {
            window.__KYNECTA_LOGGER__.error('parent', 'session', 'Failed to get session payload', { error: e.message });
            return { authenticated: false };
        }
    }

    function propagateSession() {
        // Use normalized session data to ensure consistency
        const sessionData = window.__getNormalizedSessionForModule();
        
        if (!sessionData.authenticated || !sessionData.userId || sessionData.userId <= 0) {
            window.__KYNECTA_LOGGER__.info('parent', 'propagate', 'No authenticated session to propagate');
            return;
        }
        
        // Ensure token is available
        if (!sessionData.token) {
            sessionData.token = window.__getAuthToken();
        }
        
        // Validate before propagation
        if (!sessionData.userId || sessionData.userId <= 0) {
            window.__KYNECTA_LOGGER__.error('parent', 'propagate', 'Cannot propagate session: Missing userId');
            return;
        }
        
        // Ensure token is available in localStorage under 'token' key
        if (sessionData.token) {
            localStorage.setItem('token', sessionData.token);
        }
        
        if (window.API && window.API.setUserToken) {
            window.API.setUserToken(sessionData.token);
        }
        
        window.__userToken = sessionData.token;
        window.__accessToken = sessionData.token;
        
        const iframes = document.querySelectorAll('iframe');
        let sentCount = 0;
        
        iframes.forEach(iframe => {
            if (!iframe.contentWindow) return;
            const moduleName = iframe.id?.replace('Iframe', '');
            const targetOrigin = window.location.origin;
            
            // Create message with consistent session structure
            const message = {
                type: 'SESSION_DATA',
                id: `session_prop_${Date.now()}_${moduleName}`,
                source: 'parent',
                target: moduleName || '*',
                moduleId: moduleName,
                payload: {
                    authenticated: sessionData.authenticated,
                    token: sessionData.token,
                    userId: sessionData.userId,
                    user: sessionData.user,
                    expiresAt: sessionData.expiresAt,
                    sessionVersion: sessionData.sessionVersion,
                    validated: true
                },
                timestamp: Date.now(),
                sessionVersion: sessionData.sessionVersion
            };
            
            try {
                iframe.contentWindow.postMessage(message, targetOrigin);
                sentCount++;
            } catch (e) {
                window.__KYNECTA_LOGGER__.error('parent', 'propagate', 'Failed to send session to iframe', {
                    iframeId: iframe.id,
                    error: e.message
                });
            }
        });
        
        window.__SESSION_PROPAGATED__ = true;
        window.__KYNECTA_LOGGER__.info('parent', 'propagate', `Session propagated to ${sentCount} modules`, { 
            userId: sessionData.userId,
            modules: sentCount
        });
    }

    if (window.__isAuthenticated() || localStorage.getItem('moodchat_token') || localStorage.getItem('token')) {
        setTimeout(propagateSession, 500);
    }
    
    window.KynectaEventBus?.on('AUTH_SUCCESS', function() {
        setTimeout(propagateSession, 100);
    });
    
    window.addEventListener('load', function() {
        setTimeout(propagateSession, 500);
    });
    
    // Debounced storage event handler
    let propagateDebounceTimer = null;
    window.addEventListener('storage', function(event) {
        if (event.key === 'moodchat_token' || event.key === 'moodchat_user' || event.key === 'kynecta_auth' || event.key === 'token') {
            if (propagateDebounceTimer) clearTimeout(propagateDebounceTimer);
            propagateDebounceTimer = setTimeout(() => {
                window.__KYNECTA_LOGGER__.info('parent', 'storage', 'Storage changed, propagating session');
                propagateSession();
            }, 100);
        }
    });
    
    window.__propagateSessionToIframes__ = propagateSession;
})();
</script>

