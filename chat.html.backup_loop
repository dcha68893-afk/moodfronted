    <div class="safe-message-bridge" id="safeMessageBridge"></div>

    <script>
        (function() {
            if (typeof jQuery === 'undefined') {
                window.jQuery = function(selector) {
                    if (typeof selector === 'function') {
                        if (document.readyState === 'loading') {
                            document.addEventListener('DOMContentLoaded', selector);
                        } else {
                            selector();
                        }
                    }
                    return {
                        ready: function(fn) {
                            if (document.readyState === 'loading') {
                                document.addEventListener('DOMContentLoaded', fn);
                            } else {
                                fn();
                            }
                            return this;
                        }
                    };
                };
                window.$ = window.jQuery;
            }
            
            if (!window.spectrum) {
                window.spectrum = {
                    fn: {
                        spectrum: function() { return this; }
                    }
                };
            }
        })();
        (function() {
            if (typeof jQuery === 'undefined' || !window.jQuery) {
                window.jQuery = function(selector) {
                    if (typeof selector === 'function') {
                        if (document.readyState === 'loading') {
                            document.addEventListener('DOMContentLoaded', selector);
                        } else {
                            selector();
                        }
                        return {
                            ready: function(fn) {
                                if (document.readyState === 'loading') {
                                    document.addEventListener('DOMContentLoaded', fn);
                                } else {
                                    fn();
                                }
                                return this;
                            }
                        };
                    }
                    return {
                        length: 0,
                        ready: function(fn) {
                            if (document.readyState === 'loading') {
                                document.addEventListener('DOMContentLoaded', fn);
                            } else {
                                fn();
                            }
                            return this;
                        },
                        spectrum: function() { return this; },
                        on: function() { return this; },
                        off: function() { return this; },
                        val: function() { return ''; }
                    };
                };
                window.$ = window.jQuery;
            }
            
            if (!$.fn.spectrum) {
                $.fn.spectrum = function() { return this; };
            }
        })();
        (function() {
            'use strict';
            
            window.Environment = window.Environment || {
                type: 'LOCAL_DEV',
                isLocal: true,
                isProduction: false,
                apiBaseUrl: 'http://localhost:4000/api',
                wsBaseUrl: 'ws://localhost:4000/ws',
                
                detect: function() {
                    const hostname = window.location.hostname;
                    
                    if (hostname === 'localhost' || hostname === '127.0.0.1' || hostname === '::1') {
                        this.type = 'LOCAL_DEV';
                        this.isLocal = true;
                        this.apiBaseUrl = 'http://localhost:4000/api';
                        this.wsBaseUrl = 'ws://localhost:4000/ws';
                    } else if (hostname.includes('onrender.com')) {
                        this.type = 'PRODUCTION';
                        this.isProduction = true;
                        this.apiBaseUrl = 'https://moodchat-fy56.onrender.com/api';
                        this.wsBaseUrl = 'wss://moodchat-fy56.onrender.com/ws';
                    }
                    
                    return this;
                },
                
                get: function() {
                    return {
                        type: this.type,
                        isLocal: this.isLocal,
                        isProduction: this.isProduction,
                        apiBaseUrl: this.apiBaseUrl,
                        wsBaseUrl: this.wsBaseUrl,
                        timestamp: Date.now()
                    };
                }
            };
            
            window.Environment.detect();
            
            window.environmentDetector = window.environmentDetector || {
                type: window.Environment.type,
                isLocal: window.Environment.isLocal,
                isProduction: window.Environment.isProduction,
                detect: function() { return this; },
                get: function() { return { type: this.type }; }
            };
        })();
        (function() {
            'use strict';
            
            if (!window.ParentStateManager) {
                window.ParentStateManager = {
                    _ready: false,
                    _session: null,
                    
                    init: function() {
                        try {
                            const storedUser = localStorage.getItem('kynecta_user');
                            const storedToken = localStorage.getItem('kynecta_token');
                            
                            if (storedUser && storedToken) {
                                this._session = {
                                    authenticated: true,
                                    user: JSON.parse(storedUser),
                                    token: storedToken,
                                    userId: JSON.parse(storedUser).id
                                };
                                this._ready = true;
                            } else {
                                this._session = { authenticated: false };
                                this._ready = true;
                            }
                        } catch (e) {
                            this._session = { authenticated: false };
                            this._ready = true;
                        }
                        
                        return this;
                    },
                    
                    getSession: function() {
                        return this._session || { authenticated: false };
                    },
                    
                    getToken: function() {
                        return this._session?.token || null;
                    },
                    
                    getUser: function() {
                        return this._session?.user || null;
                    },
                    
                    isReady: function() {
                        return this._ready;
                    },
                    
                    isAuthenticated: function() {
                        return this._session?.authenticated || false;
                    },
                    
                    markModuleReady: function(moduleName) {},
                    
                    waitForSession: function(timeout) {
                        return Promise.resolve(this.getSession());
                    },
                    
                    waitForModuleHandshake: function(moduleName, timeout) {
                        return Promise.resolve(this.getSession());
                    },
                    
                    subscribe: function(listener) {
                        return function() {};
                    }
                };
                
                window.ParentStateManager.init();
            }
            
            if (!window.Environment) {
                window.Environment = {
                    type: 'LOCAL_DEV',
                    isLocal: true,
                    isProduction: false,
                    apiBaseUrl: 'http://localhost:4000/api',
                    wsBaseUrl: 'ws://localhost:4000/ws',
                    
                    detect: function() {
                        const hostname = window.location.hostname;
                        if (hostname === 'localhost' || hostname === '127.0.0.1') {
                            this.type = 'LOCAL_DEV';
                            this.isLocal = true;
                        } else if (hostname.includes('onrender.com')) {
                            this.type = 'PRODUCTION';
                            this.isProduction = true;
                            this.apiBaseUrl = 'https://moodchat-fy56.onrender.com/api';
                            this.wsBaseUrl = 'wss://moodchat-fy56.onrender.com/ws';
                        }
                        return this;
                    }
                };
                window.Environment.detect();
            }
        })();
    </script>

    <!-- Environment Detector -->
    <script>
    (function() {
        window.environmentDetector = window.environmentDetector || {
            type: 'LOCAL_DEV',
            isLocal: true,
            isRender: false,
            isVPN: false,
            isProduction: false,
            isSecure: window.location.protocol === 'https:',
            latency: null,
            connectionType: 'unknown',
            saveData: false,
            effectiveType: '4g',
            rtt: null,
            downlink: null,
            timestamp: Date.now(),
            
            get: function() {
                return {
                    type: this.type,
                    isLocal: this.isLocal,
                    isRender: this.isRender,
                    isVPN: this.isVPN,
                    isProduction: this.isProduction,
                    isSecure: this.isSecure,
                    latency: this.latency,
                    connectionType: this.connectionType,
                    saveData: this.saveData,
                    effectiveType: this.effectiveType,
                    rtt: this.rtt,
                    downlink: this.downlink,
                    timestamp: Date.now()
                };
            },
            
            detect: function() {
                try {
                    const hostname = window.location.hostname;
                    
                    if (hostname === 'localhost' || hostname === '127.0.0.1' || hostname === '::1') {
                        this.type = 'LOCAL_DEV';
                        this.isLocal = true;
                    } else if (hostname.includes('onrender.com')) {
                        this.type = 'RENDER_HOSTED';
                        this.isRender = true;
                    } else if (hostname.includes('vpn') || hostname.includes('proxy')) {
                        this.type = 'VPN_NETWORK';
                        this.isVPN = true;
                    } else if (this.isSecure) {
                        this.type = 'PRODUCTION';
                        this.isProduction = true;
                    }
                    
                    if (navigator.connection) {
                        this.connectionType = navigator.connection.type || 'unknown';
                        this.effectiveType = navigator.connection.effectiveType || '4g';
                        this.rtt = navigator.connection.rtt || null;
                        this.downlink = navigator.connection.downlink || null;
                        this.saveData = navigator.connection.saveData || false;
                        this.latency = this.rtt;
                    }
                } catch (e) {}
                return this.get();
            },
            
            getTimeoutMultiplier: function() {
                if (this.isVPN) return 3.0;
                if (this.isRender) return 1.5;
                if (this.isLocal) return 0.8;
                return 1.0;
            },
            
            update: function() {
                return this.detect();
            }
        };
        
        window.environmentDetector.detect();
    })();
    </script>

    <!-- ========== GOVERNANCE LAYER - SILENT MODE ========== -->
    <script>
    (function() {
        'use strict';

        window.__KYNECTA_GOVERNANCE__ = {
            parentReady: { sent: false, timestamp: null, iframesAcked: new Set(), pending: new Map() },
            handshake: { active: false, completed: false, owner: null, startedAt: null, queue: [], results: new Map() },
            session: { lastSync: 0, version: 0, buffer: null, pendingSync: new Map(), syncedIframes: new Set(), refreshInProgress: false },
            acks: { pending: new Map(), received: new Set(), retryQueue: new Map() },
            origin: { trustedPatterns: [window.location.origin.replace(/:\d+$/, ''), 'null'], dynamic: new Set(), wildcards: [/^https?:\/\/(.*\.)?onrender\.com$/, /^https?:\/\/(.*\.)?mydomain\.com$/, /^https?:\/\/.*\.vercel\.app$/, /^https?:\/\/.*\.netlify\.app$/] },
            modules: { active: null, registry: new Map(), conflicts: [] },
            quarantine: new Set(),
            errors: new Map(),
            debug: false,
            metrics: { handshakes: 0, acks: 0, retries: 0, errors: 0, lastReset: Date.now() }
        };

        const OriginResolver = {
            normalize(origin) {
                if (!origin || origin === 'null') return 'null';
                try {
                    let normalized = origin;
                    if (normalized.endsWith('/')) normalized = normalized.slice(0, -1);
                    return normalized;
                } catch (e) {
                    return origin;
                }
            },
            isTrusted(origin) {
                if (!origin || origin === 'null') return true;
                const state = window.__KYNECTA_GOVERNANCE__.origin;
                const normalized = this.normalize(origin);
                if (state.trustedPatterns.includes(normalized)) return true;
                if (state.dynamic.has(normalized)) return true;
                for (const pattern of state.trustedPatterns) {
                    if (pattern.includes('*')) {
                        const regex = new RegExp('^' + pattern.replace(/\*/g, '.*') + '$');
                        if (regex.test(normalized)) return true;
                    }
                }
                for (const regex of state.wildcards) {
                    if (regex.test(normalized)) return true;
                }
                try {
                    const url = new URL(normalized);
                    const current = new URL(window.location.origin);
                    if (url.hostname === current.hostname) {
                        this.addTrusted(normalized);
                        return true;
                    }
                } catch (e) {}
                return false;
            },
            addTrusted(origin) {
                const normalized = this.normalize(origin);
                window.__KYNECTA_GOVERNANCE__.origin.dynamic.add(normalized);
                return true;
            },
            getTargetOrigin(iframeId) {
                const iframe = document.getElementById(iframeId);
                if (!iframe || !iframe.src) return '*';
                try {
                    const url = new URL(iframe.src, window.location.href);
                    return url.origin;
                } catch (e) {
                    return '*';
                }
            }
        };

        const ParentReadyController = {
            broadcast(force = false) {
                if (window.__PARENT_AUTHORITY__ && !force) {
                    return false;
                }
                return false;
            },
            handleAck(iframeId, messageId) {},
            requestRebroadcast(iframeId, reason) {},
            reset() {}
        };

        const HandshakeGovernor = {
            acquire(iframeId, priority = 0) { return null; },
            release(iframeId, result) {},
            processQueue() {},
            reset(iframeId) {},
            getStatus(iframeId) {
                return window.__PARENT_AUTHORITY__?.handshakeComplete ? 'completed' : 'none';
            }
        };

        const SessionCoordinator = {
            getCurrentSession() {
                try {
                    if (window.__KYNECTA_AUTHORITIES__?.parentState?.getSession) {
                        return window.__KYNECTA_AUTHORITIES__.parentState.getSession();
                    }
                    if (window.__KYNECTA_AUTHORITIES__?.session?.get) {
                        return window.__KYNECTA_AUTHORITIES__.session.get();
                    }
                    if (window.SessionGuardian?.getSession) {
                        return window.SessionGuardian.getSession();
                    }
                    if (window.__sessionCache) {
                        return window.__sessionCache;
                    }
                    if (window.__PARENT_SESSION__ && window.__PARENT_SESSION__.session) {
                        return window.__PARENT_SESSION__.session;
                    }
                } catch (e) {}
                return { authenticated: false };
            },
            sync(iframeId, force = false) {
                const state = window.__KYNECTA_GOVERNANCE__.session;
                
                if (!force && state.syncedIframes.has(iframeId)) {
                    return Promise.resolve({ success: true, cached: true });
                }
                
                if (state.pendingSync.has(iframeId)) {
                    return state.pendingSync.get(iframeId);
                }
                
                const session = this.getCurrentSession();
                if (!session || !session.authenticated) {
                    return Promise.resolve({ success: false, reason: 'not_authenticated' });
                }
                
                const syncPromise = new Promise((resolve, reject) => {
                    const iframe = document.getElementById(iframeId);
                    if (!iframe || !iframe.contentWindow) {
                        reject(new Error('Iframe not ready'));
                        return;
                    }
                    
                    const messageId = 'session_' + Date.now() + '_' + Math.random().toString(36).substr(2, 8);
                    
                    const timeout = setTimeout(() => {
                        state.pendingSync.delete(iframeId);
                        reject(new Error('Session sync timeout'));
                    }, 3000);
                    
                    if (window.AckRouter) {
                        window.AckRouter.register(messageId, {
                            type: 'SESSION_SYNC',
                            iframeId,
                            resolve: (result) => {
                                clearTimeout(timeout);
                                state.syncedIframes.add(iframeId);
                                state.lastSync = Date.now();
                                state.version++;
                                resolve(result);
                            },
                            reject: (err) => {
                                clearTimeout(timeout);
                                state.pendingSync.delete(iframeId);
                                reject(err);
                            },
                            timeout
                        });
                    }
                    
                    const safeSession = {
                        authenticated: session.authenticated || false,
                        userId: session.userId || (session.user ? session.user.id : null),
                        token: session.token || null,
                        expiresAt: session.expiresAt || null,
                        version: state.version
                    };
                    
                    try {
                        iframe.contentWindow.postMessage({
                            type: 'SESSION_SYNC',
                            messageId,
                            requestId: messageId,
                            payload: safeSession,
                            timestamp: Date.now(),
                            expectAck: true,
                            _processedBy: 'governance'
                        }, '*');
                    } catch (e) {
                        clearTimeout(timeout);
                        reject(e);
                    }
                });
                
                state.pendingSync.set(iframeId, syncPromise);
                return syncPromise;
            },
            broadcast(force = false) {
                const session = this.getCurrentSession();
                if (!session || !session.authenticated) return false;
                
                const iframeIds = ['messagesIframe', 'statusIframe', 'groupIframe', 'friendsIframe', 'callsIframe', 'settingsIframe', 'toolsIframe'];
                iframeIds.forEach(id => { this.sync(id, force).catch(() => {}); });
                return true;
            },
            onSessionChange(newSession) {
                if (window.__KYNECTA_GOVERNANCE__ && window.__KYNECTA_GOVERNANCE__.session) {
                    window.__KYNECTA_GOVERNANCE__.session.buffer = newSession;
                    window.__KYNECTA_GOVERNANCE__.session.version++;
                }
                this.broadcast(true);
            },
            isSynced(iframeId) {
                return window.__KYNECTA_GOVERNANCE__?.session?.syncedIframes?.has(iframeId) || false;
            },
            reset(iframeId) {
                if (iframeId && window.__KYNECTA_GOVERNANCE__?.session) {
                    window.__KYNECTA_GOVERNANCE__.session.syncedIframes.delete(iframeId);
                    window.__KYNECTA_GOVERNANCE__.session.pendingSync.delete(iframeId);
                } else if (window.__KYNECTA_GOVERNANCE__?.session) {
                    window.__KYNECTA_GOVERNANCE__.session.syncedIframes.clear();
                    window.__KYNECTA_GOVERNANCE__.session.pendingSync.clear();
                }
            }
        };
        
        window.AckRouter = {
            register(messageId, handler) {
                const state = window.__KYNECTA_GOVERNANCE__.acks;
                if (state.received.has(messageId)) {
                    return false;
                }
                state.pending.set(messageId, handler);
                return true;
            },
            handleAck(messageId, payload, source) {
                const state = window.__KYNECTA_GOVERNANCE__.acks;
                if (state.received.has(messageId)) {
                    return false;
                }
                state.received.add(messageId);
                
                const handler = state.pending.get(messageId);
                if (handler) {
                    clearTimeout(handler.timeout);
                    handler.resolve(payload);
                    state.pending.delete(messageId);
                    return true;
                }
                return false;
            },
            handleNack(messageId, reason) {
                const state = window.__KYNECTA_GOVERNANCE__.acks;
                const handler = state.pending.get(messageId);
                if (handler) {
                    const retryCount = state.retryQueue.get(messageId) || 0;
                    if (retryCount < 1) {
                        state.retryQueue.set(messageId, retryCount + 1);
                        setTimeout(() => {
                            const iframe = document.getElementById(handler.iframeId);
                            if (iframe && iframe.contentWindow) {
                                iframe.contentWindow.postMessage({
                                    type: handler.type,
                                    messageId: messageId + '_retry_' + retryCount,
                                    requestId: messageId + '_retry_' + retryCount,
                                    payload: handler.originalPayload,
                                    timestamp: Date.now(),
                                    expectAck: true,
                                    retry: true,
                                    _processedBy: 'governance'
                                }, '*');
                            }
                        }, 500 * Math.pow(1.5, retryCount));
                    } else {
                        handler.reject(new Error('Max retries exceeded: ' + reason));
                        state.pending.delete(messageId);
                        state.retryQueue.delete(messageId);
                        window.__KYNECTA_GOVERNANCE__.metrics.retries++;
                    }
                }
            },
            cleanup() {
                const state = window.__KYNECTA_GOVERNANCE__.acks;
                if (state.received.size > 1000) {
                    state.received.clear();
                }
            }
        };

        const ModuleResolver = {
            register(moduleName, priority = 0) {
                const state = window.__KYNECTA_GOVERNANCE__.modules;
                state.registry.set(moduleName, { priority, lastActive: Date.now() });
            },
            acquire(moduleName) {
                const state = window.__KYNECTA_GOVERNANCE__.modules;
                if (!state.active) {
                    state.active = moduleName;
                    return true;
                }
                if (state.active === moduleName) {
                    return true;
                }
                const activePriority = state.registry.get(state.active)?.priority || 0;
                const newPriority = state.registry.get(moduleName)?.priority || 0;
                if (newPriority > activePriority) {
                    state.conflicts.push({ preempted: state.active, by: moduleName, timestamp: Date.now() });
                    state.active = moduleName;
                    return true;
                }
                return false;
            },
            release(moduleName) {
                const state = window.__KYNECTA_GOVERNANCE__.modules;
                if (state.active === moduleName) {
                    state.active = null;
                }
            },
            getActive() {
                return window.__KYNECTA_GOVERNANCE__.modules.active;
            }
        };

        const ErrorContainment = {
            wrap(handler, context, quarantine = true) {
                return function(...args) {
                    try {
                        return handler.apply(this, args);
                    } catch (error) {
                        return ErrorContainment.handle(error, context, args, quarantine);
                    }
                };
            },
            handle(error, context, args, quarantine) {
                const state = window.__KYNECTA_GOVERNANCE__;
                const errorId = context + '_' + error.message;
                
                const errorInfo = state.errors.get(errorId) || { count: 0, lastSeen: 0 };
                errorInfo.count++;
                errorInfo.lastSeen = Date.now();
                state.errors.set(errorId, errorInfo);
                
                state.metrics.errors++;
                
                if (quarantine && errorInfo.count > 3) {
                    state.quarantine.add(context);
                }
                
                return { success: false, error: 'handler_error', quarantined: quarantine && errorInfo.count > 3 };
            },
            isQuarantined(context) {
                return window.__KYNECTA_GOVERNANCE__.quarantine.has(context);
            },
            reset(context) {
                if (context) {
                    window.__KYNECTA_GOVERNANCE__.quarantine.delete(context);
                    window.__KYNECTA_GOVERNANCE__.errors.delete(context + '_');
                } else {
                    window.__KYNECTA_GOVERNANCE__.quarantine.clear();
                    window.__KYNECTA_GOVERNANCE__.errors.clear();
                }
            }
        };

        (function setupMessageInterceptor() {
        })();

        ModuleResolver.register('messages-core', 10);
        ModuleResolver.register('calls-core', 9);
        ModuleResolver.register('groups-core', 8);
        ModuleResolver.register('settings-core', 7);
        ModuleResolver.register('tools-core', 6);
        ModuleResolver.register('status-core', 5);

        setInterval(() => { if (window.AckRouter) window.AckRouter.cleanup(); }, 60000);
        
        window.addEventListener('online', () => { SessionCoordinator.broadcast(true); });
        window.addEventListener('offline', () => {});

        window.__KYNECTA_GOVERNANCE_API__ = {
            getReport: function() {
                const state = window.__KYNECTA_GOVERNANCE__;
                return {
                    timestamp: Date.now(),
                    metrics: { ...state.metrics },
                    handshake: { active: state.handshake.active, owner: state.handshake.owner, queueLength: state.handshake.queue.length, completed: state.handshake.results.size },
                    session: { syncedIframes: Array.from(state.session.syncedIframes), version: state.session.version, pendingSync: state.session.pendingSync.size },
                    parentReady: { sent: state.parentReady.sent, acked: state.parentReady.iframesAcked.size, pending: Array.from(state.parentReady.pending.entries()) },
                    errors: Array.from(state.errors.entries()).map(([id, info]) => ({ id, ...info })),
                    quarantine: Array.from(state.quarantine),
                    modules: { active: state.modules.active, registry: Array.from(state.modules.registry.entries()) }
                };
            },
            resetMetrics: function() {
                window.__KYNECTA_GOVERNANCE__.metrics = { handshakes: 0, acks: 0, retries: 0, errors: 0, lastReset: Date.now() };
            },
            enableDebug: function() { window.__KYNECTA_GOVERNANCE__.debug = true; },
            disableDebug: function() { window.__KYNECTA_GOVERNANCE__.debug = false; },
            resetHandshake: HandshakeGovernor.reset.bind(HandshakeGovernor),
            resetSession: SessionCoordinator.reset.bind(SessionCoordinator),
            broadcastParentReady: () => {},
            getOriginResolver: () => OriginResolver
        };

    })();
    </script>

    <!-- ========== STABILIZATION PATCHES (PRESERVED) ========== -->
    <script>
    (function() {
        'use strict';

        const messageIdGenerator = (function() {
            let counter = 0;
            return function() {
                const ts = Date.now();
                const rand = Math.random().toString(36).substring(2, 8);
                const seq = (counter++ % 1000).toString().padStart(3, '0');
                return `msg_${ts}_${rand}_${seq}`;
            };
        })();

        window.sendToIframe = function(iframe, messageObject, targetOrigin = '*') {
            if (!iframe || !iframe.contentWindow) {
                return false;
            }

            const canonicalMessage = {
                type: messageObject.type || 'unknown',
                id: messageObject.id || messageIdGenerator(),
                requestId: messageObject.requestId || messageObject.id || messageIdGenerator(),
                timestamp: messageObject.timestamp || Date.now(),
                source: 'parent',
                target: iframe.id || 'unknown',
                payload: messageObject.payload || (messageObject.data ? { data: messageObject.data } : {}),
                session: window.AUTH_SESSION ? { 
                    userId: window.AUTH_SESSION.userId,
                    authenticated: true
                } : { authenticated: false },
                expectAck: messageObject.expectAck || false,
                signature: messageObject.signature !== undefined ? messageObject.signature : null,
                _processedBy: 'stabilization'
            };

            if (window.__safePostMessage) {
                return window.__safePostMessage(iframe, canonicalMessage, targetOrigin);
            }

            try {
                iframe.contentWindow.postMessage(canonicalMessage, targetOrigin);
                return true;
            } catch (e) {
                return false;
            }
        };

        if (window.MessageBus && window.MessageBus.send) {
            const originalSend = window.MessageBus.send;
            window.MessageBus.send = function(frameId, type, payload, expectAck, timeout) {
                const iframe = document.getElementById(frameId);
                if (!iframe) return Promise.resolve({ success: false, error: 'iframe missing' });
                const msg = { type, payload: payload || {}, id: messageIdGenerator(), requestId: messageIdGenerator(), timestamp: Date.now(), expectAck };
                window.sendToIframe(iframe, msg);
                if (expectAck) {
                    return Promise.resolve({ success: true, async: true });
                }
                return Promise.resolve({ success: true });
            };
        }

        const handshakeInProgress = new Set();
        const childReadyReceived = new Set();

        setTimeout(function() {
            const coreVersions = new Set();
            if (window.KynectaCoreVersion) coreVersions.add(window.KynectaCoreVersion);
            if (window.kynectaVersion) coreVersions.add(window.kynectaVersion);
            if (window.__KYNECTA_CORE_VERSION__) coreVersions.add(window.__KYNECTA_CORE_VERSION__);
        }, 1000);

    })();
    </script>

    <!-- ========== EARLY MESSAGE BRIDGE (PRESERVED) ========== -->
    <script>
    (function() {
        const trustedOrigins = new Set([window.location.origin, 'null']);
        const knownIframeIds = ['messagesIframe','statusIframe','groupIframe','friendsIframe','callsIframe','settingsIframe','toolsIframe'];

        function safeMessageBridge(event) {
            try {
                if (event.origin !== window.location.origin && event.origin !== 'null') return;
                const isKnownIframe = knownIframeIds.some(id => {
                    const el = document.getElementById(id);
                    return el && el.contentWindow === event.source;
                });
                if (!isKnownIframe && event.source !== window) return;
                if (!event.data || typeof event.data !== 'object') return;
                
                if (event.data && typeof event.data === 'object') {
                    event.data._processedBy = 'early-bridge';
                }
            } catch (e) {}
        }
        window.removeEventListener('message', safeMessageBridge);
        window.addEventListener('message', safeMessageBridge);

        try {
            if (!window._sessionCache) {
                const token = window.__getAuthToken();
                const cachedUser = localStorage.getItem('kynecta_user');
                if (token && cachedUser) {
                    window._sessionCache = {
                        user: JSON.parse(cachedUser),
                        token: token,
                        userId: JSON.parse(cachedUser).id || null,
                        expires: Date.now() + 3600000
                    };
                    
                    window.AUTH_SESSION = Object.freeze({
                        userId: window._sessionCache.userId,
                        token: window._sessionCache.token,
                        sessionId: 'sess_' + Date.now(),
                        permissions: [],
                        timestamp: Date.now()
                    });
                    
                    if (window.__BOOT_STATE__) {
                        window.__BOOT_STATE__.sessionRestored = true;
                    }
                }
            }
        } catch (e) {}

        const originalPostMessage = window.postMessage;
        window.postMessage = function(message, targetOrigin, transfer) {
            try {
                if (message && typeof message === 'object' && !message.id && !message.type) {
                    message = {
                        id: 'msg_' + Date.now() + '_' + Math.random().toString(36).substr(2, 9),
                        requestId: 'msg_' + Date.now() + '_' + Math.random().toString(36).substr(2, 9),
                        type: message.type || 'unknown',
                        source: 'parent',
                        timestamp: Date.now(),
                        session: window._sessionCache || { authenticated: false },
                        payload: message.payload || message,
                        signature: 'sig_' + Date.now(),
                        _processedBy: 'early-bridge'
                    };
                }
            } catch (e) {}
            return originalPostMessage.call(this, message, targetOrigin, transfer);
        }.bind(window);

        window.__simpleSign = function(obj) {
            return 'sig_' + Date.now() + '_' + Math.random().toString(36).substr(2, 5);
        };

        const showOriginal = window.IframeOrchestrator && window.IframeOrchestrator.show;
        if (showOriginal) {
            window.IframeOrchestrator.show = function(iframeId) {
                try {
                    return showOriginal.call(this, iframeId);
                } catch (e) {
                    document.querySelectorAll('.iframe-container').forEach(c => c.classList.add('hidden'));
                    const target = document.getElementById(iframeId.replace('Iframe','Content'));
                    if (target) target.classList.remove('hidden');
                    return false;
                }
            };
        }

        window.__HANDSHAKE_STATE__ = { messages: false, calls: false, groups: false, status: false, settings: false, friends: false };
        function updateHandshakeState(iframeId, ack) {
            const key = iframeId.replace('Iframe','');
            if (window.__HANDSHAKE_STATE__.hasOwnProperty(key)) {
                window.__HANDSHAKE_STATE__[key] = ack;
            }
            
            if (window.__BOOT_STATE__ && ack) {
                window.__BOOT_STATE__.iframesRegistered.add(iframeId);
            }
        }

        if (!window.parent._kynectaProxy) {
            window.parent._kynectaProxy = {
                getCurrentUser: function() { return window.getCurrentUser ? window.getCurrentUser() : null; },
                switchPage: function(page) { return window.switchPage ? window.switchPage(page) : null; },
                goBack: function() { return window.goBack ? window.goBack() : null; },
                closeModal: function(id) { return window.closeModal ? window.closeModal(id) : null; }
            };
            Object.defineProperty(window.parent, 'someFunction', {
                get: function() { return window.parent._kynectaProxy.getCurrentUser; },
                set: function() {}
            });
        }

        const asyncMethods = ['setTimeout', 'setInterval', 'requestAnimationFrame', 'queueMicrotask'];
        asyncMethods.forEach(m => {
            const orig = window[m];
            window[m] = function(cb, ...args) {
                return orig.call(window, function() {
                    try {
                        return cb.apply(this, arguments);
                    } catch (e) {}
                }, ...args);
            };
        });

        window.__PARENT_DEBUG__ = false;
        window.toggleParentDebug = function() {
            window.__PARENT_DEBUG__ = !window.__PARENT_DEBUG__;
            if (window.__PARENT_DEBUG__) {
                console.log('[ParentDebug] enabled');
            }
        };
    })();
    </script>

    <!-- ========== RESPONSIVE LAYOUT CONTROLLER (PRESERVED) ========== -->
    <script>
    (function() {
        function syncLayout() {
            const width = window.innerWidth;
            const sidebar = document.getElementById('permanentSidebar');
            const mobileNav = document.getElementById('mobileNavBar');
            const containers = document.querySelectorAll('.iframe-container');
            if (!sidebar || !mobileNav) return;
            if (width <= 768) {
                sidebar.style.display = 'none';
                mobileNav.style.display = 'flex';
                containers.forEach(c => {
                    c.style.left = '0';
                    c.style.width = '100%';
                });
            } else if (width >= 1024) {
                sidebar.style.display = 'flex';
                mobileNav.style.display = 'none';
                containers.forEach(c => {
                    c.style.left = '60px';
                    c.style.width = 'calc(100% - 60px)';
                });
            } else {
                sidebar.style.display = 'flex';
                mobileNav.style.display = 'none';
                containers.forEach(c => {
                    c.style.left = '60px';
                    c.style.width = 'calc(100% - 60px)';
                });
            }
        }
        window.addEventListener('load', syncLayout);
        window.addEventListener('resize', syncLayout);
        window.addEventListener('orientationchange', syncLayout);
        syncLayout();
    })();
    </script>

    <!-- ========== ORCHESTRATION ENGINE (PRESERVED - SILENT MODE) ========== -->
    <script>
    (function() {
        'use strict';

        const SecurityCore = {
            sanitizeString: function(str) {
                if (!str || typeof str !== 'string') return str || '';
                return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#039;');
            },
            generateUUID: function() {
                return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function(c) {
                    const r = Math.random() * 16 | 0;
                    const v = c === 'x' ? r : (r & 0x3 | 0x8);
                    return v.toString(16);
                });
            },
            createSignature: function(payload, timestamp) {
                const str = JSON.stringify(payload) + timestamp + 'kynecta-secret';
                let hash = 0;
                for (let i = 0; i < str.length; i++) {
                    const char = str.charCodeAt(i);
                    hash = ((hash << 5) - hash) + char;
                    hash = hash & hash;
                }
                return hash.toString(36);
            }
        };

        const LogGovernor = {
            warned: new Set(),
            errors: new Map(),
            maxErrors: 50,
            enabled: false,
            once: function(type, message, ...args) {},
            error: function(type, error, context = '') {},
            info: function(type, message, ...args) {}
        };

        const StorageResilience = {
            memoryStore: new Map(),
            storageAvailable: true,
            init: function() {
                try {
                    const testKey = '_kynecta_test_';
                    localStorage.setItem(testKey, 'test');
                    localStorage.removeItem(testKey);
                    this.storageAvailable = true;
                } catch (e) {
                    this.storageAvailable = false;
                }
                return this;
            },
            get: function(key, fallback = null) {
                if (this.storageAvailable) {
                    try {
                        const value = localStorage.getItem(key);
                        if (value !== null) return value;
                    } catch (e) {}
                }
                return this.memoryStore.has(key) ? this.memoryStore.get(key) : fallback;
            },
            set: function(key, value) {
                if (this.storageAvailable) {
                    try {
                        localStorage.setItem(key, String(value));
                        return true;
                    } catch (e) {}
                }
                this.memoryStore.set(key, String(value));
                return true;
            },
            remove: function(key) {
                if (this.storageAvailable) {
                    try {
                        localStorage.removeItem(key);
                    } catch (e) {}
                }
                this.memoryStore.delete(key);
            },
            getJSON: function(key, fallback = null) {
                const value = this.get(key);
                if (!value) return fallback;
                try {
                    return JSON.parse(value);
                } catch (e) {
                    return fallback;
                }
            },
            setJSON: function(key, value) {
                try {
                    return this.set(key, JSON.stringify(value));
                } catch (e) {
                    return false;
                }
            }
        }.init();

        const SessionAuthority = {
            _state: { user: null, token: null, authenticated: false, timestamp: 0, fromCache: false, initialized: false, expiresAt: null, signature: null, refreshToken: null, userId: null },
            _subscribers: new Set(),
            _initPromise: null,
            _readySubscribers: new Map(),
            _isReady: false,
            
            init: function() {
                if (this._initPromise) return this._initPromise;
                
                this._initPromise = new Promise((resolve) => {
                    const token = window.__getAuthToken();
                    const cachedUser = StorageResilience.getJSON('kynecta_user', null);
                    
                    if (token && cachedUser) {
                        this._state.user = cachedUser;
                        this._state.userId = window.__normalizeUserId(cachedUser.id || cachedUser.userId);
                        this._state.token = token;
                        this._state.authenticated = true;
                        this._state.fromCache = true;
                        this._state.timestamp = Date.now();
                        this._state.signature = SecurityCore.createSignature({ userId: this._state.userId }, this._state.timestamp);
                        this._state.expiresAt = Date.now() + 3600000;
                        
                        window.AUTH_SESSION = Object.freeze({
                            userId: this._state.userId,
                            token: this._state.token,
                            sessionId: 'sess_' + Date.now(),
                            permissions: [],
                            timestamp: Date.now()
                        });
                        
                        if (window.__BOOT_STATE__) {
                            window.__BOOT_STATE__.sessionRestored = true;
                        }
                        
                        if (window.__markSessionReady) {
                            window.__markSessionReady();
                        }
                    } else if (token) {
                        this._state.user = { id: 'user_' + Date.now(), name: 'User' };
                        this._state.userId = this._state.user.id;
                        this._state.token = token;
                        this._state.authenticated = true;
                        this._state.fromCache = true;
                        this._state.timestamp = Date.now();
                        this._state.expiresAt = Date.now() + 3600000;
                        
                        window.AUTH_SESSION = Object.freeze({
                            userId: this._state.userId,
                            token: token,
                            sessionId: 'sess_' + Date.now(),
                            permissions: [],
                            timestamp: Date.now()
                        });
                    }
                    
                    this._state.initialized = true;
                    this._checkReadyAndNotify();
                    
                    resolve(this._state);
                });
                
                return this._initPromise;
            },
            
            _checkReadyAndNotify: function() {
                if (!this._state.authenticated) return;
                
                const required = ['userId', 'token', 'expiresAt', 'signature'];
                const hasAll = required.every(field => !!this._state[field]);
                
                if (hasAll && !this._isReady) {
                    this._isReady = true;
                    if (window.__markSessionReady) {
                        window.__markSessionReady();
                    }
                    this._readySubscribers.forEach((cb) => {
                        try { cb(this.getState()); } catch (e) {}
                    });
                    this._readySubscribers.clear();
                }
            },
            
            onReady: function(callback, timeout = 5000) {
                const id = SecurityCore.generateUUID();
                
                if (this._isReady) {
                    callback(this.getState());
                    return () => {};
                }
                
                return new Promise((resolve, reject) => {
                    const timeoutId = setTimeout(() => {
                        this._readySubscribers.delete(id);
                        reject(new Error('Session ready timeout'));
                    }, timeout);
                    
                    this._readySubscribers.set(id, (state) => {
                        clearTimeout(timeoutId);
                        callback(state);
                        resolve();
                    });
                });
            },
            
            _loadFromAuthSources: async function() {
                const token = window.__getAuthToken();
                if (token) {
                    this._state.token = token;
                    this._state.authenticated = true;
                }
            },
            
            subscribe: function(callback) {
                this._subscribers.add(callback);
                if (this._state.initialized) {
                    callback(this.getState());
                }
                return () => this._subscribers.delete(callback);
            },
            
            getState: function() {
                return {
                    user: this._state.user ? { ...this._state.user } : null,
                    token: this._state.token,
                    authenticated: this._state.authenticated,
                    timestamp: this._state.timestamp,
                    fromCache: this._state.fromCache,
                    initialized: this._state.initialized,
                    userId: this._state.userId,
                    expiresAt: this._state.expiresAt,
                    signature: this._state.signature,
                    refreshToken: this._state.refreshToken
                };
            },
            
            getToken: function() {
                return this._state.token || window.__getAuthToken();
            },
            
            getUser: function() {
                return this._state.user ? { ...this._state.user } : null;
            },
            
            isAuthenticated: function() {
                return this._state.authenticated || !!window.__isAuthenticated();
            },
            
            isReady: function() {
                return this._isReady;
            },
            
            logout: function() {
                this._state.user = null;
                this._state.token = null;
                this._state.authenticated = false;
                this._state.timestamp = Date.now();
                this._state.userId = null;
                this._state.expiresAt = null;
                this._state.signature = null;
                this._isReady = false;
                
                window.AUTH_SESSION = null;
                
                StorageResilience.remove('kynecta_user');
                StorageResilience.remove('kynecta_token');
                localStorage.removeItem('kynecta_auth');
                this._subscribers.forEach(cb => { try { cb(this.getState()); } catch (e) {} });
                
                if (window.api?.auth?.logout) {
                    window.api.auth.logout().catch(() => {});
                }
                if (window.app?.core?.session?.logout) {
                    window.app.core.session.logout().catch(() => {});
                }
            }
        };

        const MessageValidator = {
            trustedOrigins: new Set([window.location.origin, 'null']),
            
            validateInbound: function(event) {
                if (event.origin !== window.location.origin && event.origin !== 'null') {
                    return false;
                }
                
                const isFromIframe = ['messagesIframe', 'statusIframe', 'groupIframe', 'friendsIframe', 'callsIframe', 'settingsIframe', 'toolsIframe']
                    .some(id => {
                        const el = document.getElementById(id);
                        return el && el.contentWindow === event.source;
                    });
                
                if (!isFromIframe && event.source !== window) {
                    return false;
                }
                
                if (!event.data || typeof event.data !== 'object') {
                    return false;
                }
                
                return true;
            },
            
            validateOutbound: function(message, targetOrigin) {
                if (!message.id) {
                    message.id = SecurityCore.generateUUID();
                }
                if (!message.requestId) {
                    message.requestId = message.id;
                }
                if (!message.timestamp) {
                    message.timestamp = Date.now();
                }
                if (message.payload) {
                    message.signature = SecurityCore.createSignature(message.payload, message.timestamp);
                }
                return true;
            },
            
            adaptLegacyMessage: function(msg) {
                if (msg.protocolVersion) return msg;
                return {
                    type: msg.type,
                    payload: msg.payload || msg.data || {},
                    id: msg.id || msg.messageId || SecurityCore.generateUUID(),
                    requestId: msg.requestId || msg.id || msg.messageId || SecurityCore.generateUUID(),
                    protocolVersion: '1.0',
                    timestamp: msg.timestamp || Date.now(),
                    source: msg.source || 'iframe',
                    expectAck: msg.expectAck || false,
                    legacy: true
                };
            }
        };

        const HandshakeManager = {
            handshakes: new Map(),
            maxRetries: 1,
            
            init: function() {
                if (window.MessageBus) {
                    MessageBus.on('HANDSHAKE_REQUEST', this.handleHandshakeRequest.bind(this));
                    MessageBus.on('CHILD_READY', this.handleChildReady.bind(this));
                    MessageBus.on('SESSION_REQUEST', this.handleSessionRequest.bind(this));
                    MessageBus.on('SESSION_ACK', this.handleSessionAck.bind(this));
                }
                return this;
            },
            
            handleSessionAck: function(payload, frameId) {
                const handshake = this.handshakes.get(frameId);
                if (handshake) {
                    handshake.sessionAcked = true;
                    handshake.ackTimestamp = Date.now();
                }
                
                if (window.__BOOT_STATE__) {
                    window.__BOOT_STATE__.iframesRegistered.add(frameId);
                }
            },
            
            initiateHandshake: function(frameId, retryCount = 0) {
                const frame = document.getElementById(frameId);
                if (!frame?.contentWindow) {
                    return Promise.reject(new Error('Iframe not ready'));
                }
                
                if (window.__PARENT_AUTHORITY__) {
                    window.__PARENT_AUTHORITY__.registerFrame(frame.contentWindow);
                }
                
                if (this.handshakes.has(frameId)) {
                    const existing = this.handshakes.get(frameId);
                    if (existing.status === 'completed') {
                        return Promise.resolve(existing.result);
                    }
                    if (existing.status === 'in-progress') {
                        return existing.promise;
                    }
                }
                
                const messageId = SecurityCore.generateUUID();
                const timestamp = Date.now();
                
                const session = SessionAuthority.getState();
                const handshakePayload = {
                    messageId,
                    requestId: messageId,
                    timestamp,
                    protocolVersion: '2.0',
                    sessionReady: SessionAuthority.isReady(),
                    session: session.authenticated ? {
                        userId: session.userId,
                        token: session.token ? 'present' : 'none',
                        timestamp: session.timestamp,
                        expiresAt: session.expiresAt,
                        signature: session.signature
                    } : null
                };
                
                handshakePayload.signature = SecurityCore.createSignature(handshakePayload, timestamp);
                
                const handshakePromise = new Promise((resolve, reject) => {
                    const timeout = setTimeout(() => {
                        if (retryCount < this.maxRetries) {
                            this.handshakes.delete(frameId);
                            setTimeout(() => {
                                this.initiateHandshake(frameId, retryCount + 1)
                                    .then(resolve)
                                    .catch(reject);
                            }, Math.pow(1.5, retryCount) * 500);
                        } else {
                            this.handshakes.delete(frameId);
                            
                            const orch = window.IframeOrchestrator;
                            if (orch) {
                                orch.markDegraded(frameId, 'handshake-timeout');
                            }
                            
                            this._attemptLegacyHandshake(frameId);
                            resolve({ success: false, legacy: true, degraded: true });
                        }
                    }, 2000 * (retryCount + 1));
                    
                    this.handshakes.set(frameId, {
                        status: 'in-progress',
                        retries: retryCount,
                        promise: handshakePromise,
                        timeout,
                        resolve,
                        reject,
                        messageId,
                        startTime: Date.now()
                    });
                    
                    if (window.MessageBus && MessageBus.send) {
                        MessageBus.send(frameId, 'HANDSHAKE_REQUEST', handshakePayload, true, 3000)
                            .then(response => {
                                if (response?.success) {
                                    this._completeHandshake(frameId, response.result);
                                    resolve(response.result);
                                }
                            })
                            .catch(() => {});
                    } else {
                        try {
                            frame.contentWindow.postMessage({
                                source: 'parent',
                                type: 'HANDSHAKE_REQUEST',
                                payload: handshakePayload,
                                messageId,
                                requestId: messageId,
                                timestamp,
                                expectAck: true,
                                _processedBy: 'orchestration'
                            }, '*');
                        } catch (e) {
                            reject(e);
                        }
                    }
                });
                
                return handshakePromise;
            },
            
            _completeHandshake: function(frameId, result) {
                const handshake = this.handshakes.get(frameId);
                if (handshake) {
                    clearTimeout(handshake.timeout);
                    handshake.status = 'completed';
                    handshake.result = result;
                    
                    if (window.__BOOT_STATE__) {
                        window.__BOOT_STATE__.iframesRegistered.add(frameId);
                    }
                    
                    if (window.__markHandshakeComplete) {
                        window.__markHandshakeComplete();
                    }
                }
                
                if (SessionAuthority.isReady()) {
                    this._sendSessionToFrame(frameId);
                } else {
                    SessionAuthority.onReady(() => {
                        this._sendSessionToFrame(frameId);
                    }).catch(() => {});
                }
            },
            
            _attemptLegacyHandshake: function(frameId) {
                const session = SessionAuthority.getState();
                
                const messages = [
                    { type: 'SESSION_DATA', payload: session },
                    { type: 'INIT', payload: session },
                    { type: 'AUTH_STATE', payload: session }
                ];
                
                messages.forEach(msg => {
                    if (window.MessageBus && MessageBus.send) {
                        MessageBus.send(frameId, msg.type, msg.payload, false).catch(() => {});
                    } else {
                        const frame = document.getElementById(frameId);
                        if (frame?.contentWindow) {
                            frame.contentWindow.postMessage({
                                source: 'parent',
                                type: msg.type,
                                payload: msg.payload,
                                _processedBy: 'orchestration'
                            }, '*');
                        }
                    }
                });
                
                this.handshakes.set(frameId, { status: 'legacy', timestamp: Date.now() });
                
                if (window.__BOOT_STATE__) {
                    window.__BOOT_STATE__.iframesRegistered.add(frameId);
                }
            },
            
            _sendSessionToFrame: function(frameId) {
                const session = SessionAuthority.getState();
                if (!session.authenticated) return;
                
                const safeSession = {
                    authenticated: session.authenticated,
                    user: session.user ? {
                        id: session.user.id || session.user.userId,
                        name: session.user.name,
                        email: session.user.email
                    } : null,
                    token: session.token,
                    timestamp: session.timestamp,
                    expiresAt: session.expiresAt,
                    signature: session.signature,
                    userId: session.userId
                };
                
                if (window.MessageBus && MessageBus.send) {
                    MessageBus.send(frameId, 'SESSION_SYNC', safeSession, true, 2000)
                        .then(response => {
                            if (response?.success) {
                                this.handleSessionAck(response, frameId);
                            }
                        })
                        .catch(() => {
                            setTimeout(() => {
                                this._sendSessionToFrame(frameId);
                            }, 1000);
                        });
                } else {
                    const frame = document.getElementById(frameId);
                    if (frame?.contentWindow) {
                        frame.contentWindow.postMessage({
                            source: 'parent',
                            type: 'SESSION_SYNC',
                            payload: safeSession,
                            messageId: SecurityCore.generateUUID(),
                            requestId: SecurityCore.generateUUID(),
                            timestamp: Date.now(),
                            expectAck: true,
                            _processedBy: 'orchestration'
                        }, '*');
                        
                        setTimeout(() => {}, 2000);
                    }
                }
            },
            
            handleHandshakeRequest: function(payload, frameId) {
                if (payload.signature) {
                    const expectedSig = SecurityCore.createSignature(payload, payload.timestamp);
                    if (payload.signature !== expectedSig) {
                        return { success: false, error: 'Invalid signature' };
                    }
                }
                
                const frame = document.getElementById(frameId);
                if (frame && window.__PARENT_AUTHORITY__) {
                    window.__PARENT_AUTHORITY__.registerFrame(frame.contentWindow);
                }
                
                if (window.__BOOT_STATE__) {
                    window.__BOOT_STATE__.iframesRegistered.add(frameId);
                }
                
                const session = SessionAuthority.getState();
                const response = {
                    messageId: payload.messageId,
                    requestId: payload.requestId,
                    timestamp: Date.now(),
                    protocolVersion: '2.0',
                    sessionReady: SessionAuthority.isReady(),
                    session: session.authenticated ? {
                        userId: session.userId,
                        token: session.token ? 'present' : 'none',
                        timestamp: session.timestamp,
                        expiresAt: session.expiresAt,
                        signature: session.signature
                    } : null
                };
                
                response.signature = SecurityCore.createSignature(response, response.timestamp);
                
                this.handshakes.set(frameId, { status: 'completed', result: response, timestamp: Date.now() });
                if (window.__markHandshakeComplete) {
                    window.__markHandshakeComplete();
                }
                
                return { success: true, result: response };
            },
            
            handleChildReady: function(payload, frameId) {
                const frame = document.getElementById(frameId);
                if (frame && window.__PARENT_AUTHORITY__) {
                    window.__PARENT_AUTHORITY__.registerFrame(frame.contentWindow);
                }
                
                if (window.__BOOT_STATE__) {
                    window.__BOOT_STATE__.iframesRegistered.add(frameId);
                }
                
                if (!this.handshakes.has(frameId) || this.handshakes.get(frameId).status !== 'completed') {
                    this.initiateHandshake(frameId).catch(() => {});
                } else {
                    this._sendSessionToFrame(frameId);
                }
            },
            
            handleSessionRequest: function(payload, frameId) {
                this._sendSessionToFrame(frameId);
                return { success: true };
            },
            
            getHandshakeStatus: function(frameId) {
                return this.handshakes.get(frameId)?.status || 'none';
            },
            
            hasAck: function(frameId) {
                return this.handshakes.get(frameId)?.sessionAcked || false;
            }
        };

        const DependencyManager = {
            modules: new Map(),
            status: 'booting',
            init() {
                this.define('api.core', () => window.api?.core);
                this.define('api.request', () => window.api?.request, ['api.core']);
                this.define('api.auth', () => window.api?.auth, ['api.core', 'api.request']);
                this.define('api.messages', () => window.api?.messages, ['api.core', 'api.auth']);
                this.define('app.core.bootstrap', () => window.app?.core?.bootstrap, ['api.core']);
                this.define('app.core.session', () => window.app?.core?.session, ['api.auth', 'app.core.bootstrap']);
                this.define('app.core.ui', () => window.app?.core?.ui, ['app.core.bootstrap']);
                this.define('app.ui.auth', () => window.app?.ui?.auth, ['api.auth', 'app.core.session', 'app.core.ui']);
                this.define('call.core', () => window.callCore || window.call?.core, ['api.core', 'app.core.session']);

                return this;
            },
            define(name, getter, deps = []) {
                this.modules.set(name, { getter, deps, loaded: false, value: null });
            },
            isReady(name) {
                const mod = this.modules.get(name);
                if (!mod) return false;
                if (mod.loaded) return true;
                
                for (const dep of mod.deps) {
                    if (!this.isReady(dep)) return false;
                }

                try {
                    const value = mod.getter();
                    if (value) {
                        mod.value = value;
                        mod.loaded = true;
                        return true;
                    }
                } catch (e) {
                    return false;
                }
                return false;
            },
            get(name, fallback = null) {
                return this.isReady(name) ? this.modules.get(name).value : fallback;
            },
            onReady(name, callback, timeout = 5000) {
                if (this.isReady(name)) {
                    callback(this.get(name));
                    return;
                }
                const start = Date.now();
                const interval = setInterval(() => {
                    if (this.isReady(name)) {
                        clearInterval(interval);
                        callback(this.get(name));
                    } else if (Date.now() - start > timeout) {
                        clearInterval(interval);
                        callback(null);
                    }
                }, 50);
            }
        }.init();

        const MessageBus = window.MessageBus || {
            VERSION: '2.0',
            APP_NAME: 'chat-system',
            SOURCE_PARENT: 'PARENT',
            SOURCE_IFRAME: 'IFRAME',
            handlers: new Map(),
            frameHandlers: new Map(),
            trustedOrigins: null,
            sequence: 0,
            pendingAcks: new Map(),
            frameReadyState: new Map(),
            sessionSyncState: new Map(),
            
            init() {
                this.trustedOrigins = new Set([window.location.origin, 'null']);
                
                return this;
            },

            validate(event) {
                if (event.origin !== window.location.origin && event.origin !== 'null') {
                    return false;
                }
                if (!event.data || typeof event.data !== 'object') return false;
                if (event.data.source !== this.SOURCE_IFRAME) return false;
                if (event.data.app !== this.APP_NAME) return false;
                if (event.data.version !== this.VERSION) return false;
                return true;
            },

            receive(event) {
                if (!this.validate(event)) return;
                
                const { type, payload, frameId, sequence, messageId, requestId } = event.data;
                
                if (type === 'ACK' && requestId) {
                    const ackHandler = this.pendingAcks.get(requestId);
                    if (ackHandler) {
                        ackHandler.resolve?.(payload);
                        this.pendingAcks.delete(requestId);
                    }
                    return;
                }

                if (type === 'SESSION_ACK') {
                    const frame = frameId || this._identifyFrame(event.source);
                    if (frame) {
                        this.sessionSyncState.set(frame, { synced: true, timestamp: Date.now() });
                        HandshakeManager.handleSessionAck(payload, frame);
                    }
                }

                const handler = this.handlers.get(type);
                if (handler) {
                    try {
                        const result = handler(payload, frameId, event);
                        if (event.data.expectAck) {
                            event.source.postMessage({
                                source: this.SOURCE_PARENT,
                                app: this.APP_NAME,
                                version: this.VERSION,
                                type: 'ACK',
                                requestId: requestId || sequence,
                                payload: { success: true, result },
                                timestamp: Date.now(),
                                _processedBy: 'orchestration'
                            }, event.origin);
                        }
                    } catch (error) {
                        if (event.data.expectAck) {
                            event.source.postMessage({
                                source: this.SOURCE_PARENT,
                                app: this.APP_NAME,
                                version: this.VERSION,
                                type: 'ACK',
                                requestId: requestId || sequence,
                                payload: { success: false, error: SecurityCore.sanitizeString(error.message) },
                                timestamp: Date.now(),
                                _processedBy: 'orchestration'
                            }, event.origin);
                        }
                    }
                }
            },

            _identifyFrame: function(source) {
                const iframes = ['messagesIframe', 'statusIframe', 'groupIframe', 'friendsIframe', 'callsIframe', 'settingsIframe', 'toolsIframe'];
                for (const id of iframes) {
                    const el = document.getElementById(id);
                    if (el && el.contentWindow === source) {
                        return id;
                    }
                }
                return null;
            },

            send(frameId, type, payload = {}, expectAck = false, timeout = 3000) {
                const frame = document.getElementById(frameId);
                if (!frame?.contentWindow) {
                    return Promise.resolve({ success: false, error: 'iframe not ready' });
                }

                const sequence = ++this.sequence;
                const messageId = `msg_${Date.now()}_${sequence}`;
                const requestId = messageId;
                const message = {
                    source: this.SOURCE_PARENT,
                    app: this.APP_NAME,
                    version: this.VERSION,
                    type,
                    payload,
                    frameId,
                    messageId,
                    requestId,
                    sequence,
                    session: window.AUTH_SESSION ? { 
                        userId: window.AUTH_SESSION.userId,
                        authenticated: true
                    } : { authenticated: false },
                    expectAck,
                    timestamp: Date.now(),
                    _processedBy: 'orchestration'
                };

                if (!MessageValidator.validateOutbound(message, '*')) {
                    return Promise.resolve({ success: false, error: 'message validation failed' });
                }

                try {
                    frame.contentWindow.postMessage(message, '*');
                } catch (e) {
                    return Promise.resolve({ success: false, error: e.message });
                }

                if (!expectAck) {
                    return Promise.resolve({ success: true, async: false });
                }

                return new Promise((resolve, reject) => {
                    const timer = setTimeout(() => {
                        if (this.pendingAcks.has(requestId)) {
                            this.pendingAcks.delete(requestId);
                            resolve({ success: false, error: 'ack timeout' });
                        }
                    }, timeout);
                    this.pendingAcks.set(requestId, { resolve, reject, timer, frameId, type });
                });
            },

            broadcast(type, payload = {}) {
                const iframes = ['messagesIframe', 'statusIframe', 'groupIframe', 'friendsIframe', 'callsIframe', 'settingsIframe', 'toolsIframe'];
                iframes.forEach(frameId => {
                    this.send(frameId, type, payload, false).catch(() => {});
                });
            },

            on(type, handler) {
                this.handlers.set(type, handler);
            },

            off(type) {
                this.handlers.delete(type);
            },

            markFrameReady(frameId) {
                this.frameReadyState.set(frameId, true);
            },

            isFrameReady(frameId) {
                return this.frameReadyState.has(frameId);
            },
            
            isSessionSynced: function(frameId) {
                return this.sessionSyncState.get(frameId)?.synced || false;
            }
        };

        if (!window.MessageBus) {
            window.MessageBus = MessageBus.init();
        } else {
            const originalOn = window.MessageBus.on;
            window.MessageBus.on = function(type, handler) {
                const wrappedHandler = (payload, frameId, event) => {
                    if (MessageValidator.validateInbound(event)) {
                        return handler(payload, frameId, event);
                    }
                };
                originalOn.call(this, type, wrappedHandler);
            };
        }

        const SessionGuardian = window.SessionGuardian || {
            session: null,
            authenticated: false,
            subscribers: [],
            fallbackUser: null,
            initPromise: null,
            _callCoreInitialized: false,
            
            init() {
                try {
                    const token = window.__getAuthToken();
                    const cached = localStorage.getItem('kynecta_user');
                    if (token && cached) {
                        this.fallbackUser = JSON.parse(cached);
                        this.session = { user: this.fallbackUser, authenticated: true, fromCache: true };
                        this.authenticated = true;
                        
                        window.AUTH_SESSION = Object.freeze({
                            userId: this.fallbackUser.id,
                            token: token,
                            sessionId: 'sess_' + Date.now(),
                            permissions: this.fallbackUser.permissions || [],
                            timestamp: Date.now()
                        });
                        
                        if (window.__BOOT_STATE__) {
                            window.__BOOT_STATE__.sessionRestored = true;
                        }
                        
                        if (window.__markSessionReady) {
                            window.__markSessionReady();
                        }
                    }
                } catch (e) {}

                this.initPromise = new Promise(resolve => {
                    DependencyManager.onReady('app.core.session', (sessionMod) => {
                        if (sessionMod) {
                            this.loadFromModule(sessionMod).then(resolve);
                        } else {
                            resolve(this.session || { user: null, authenticated: false });
                        }
                    }, 3000);
                });

                SessionAuthority.subscribe((state) => {
                    this.session = { user: state.user, token: state.token, authenticated: state.authenticated, timestamp: state.timestamp };
                    this.authenticated = state.authenticated;
                    
                    if (state.authenticated) {
                        window.AUTH_SESSION = Object.freeze({
                            userId: state.userId,
                            token: state.token,
                            sessionId: 'sess_' + Date.now(),
                            permissions: state.user?.permissions || [],
                            timestamp: Date.now()
                        });
                    }
                    
                    if (window.__BOOT_STATE__ && state.authenticated) {
                        window.__BOOT_STATE__.sessionRestored = true;
                    }
                    
                    if (state.authenticated && window.__markSessionReady) {
                        window.__markSessionReady();
                    }
                    
                    if (state.authenticated && SessionAuthority.isReady() && window.MessageBus) {
                        MessageBus.broadcast('SESSION_UPDATE', state);
                    }
                });

                SessionAuthority.onReady(() => {
                    const checkIframeAndInitCall = () => {
                        const anyIframeLoaded = window.IframeOrchestrator && 
                            window.IframeOrchestrator.registry && 
                            Array.from(window.IframeOrchestrator.registry.values()).some(e => e.loaded);
                        
                        if (anyIframeLoaded && !this._callCoreInitialized) {
                            this._initCallCore();
                        } else {
                            setTimeout(checkIframeAndInitCall, 500);
                        }
                    };
                    checkIframeAndInitCall();
                }).catch(() => {});

                MessageBus.on('REQUEST_SESSION', (payload, frameId, event) => {
                    this.distributeToFrame(frameId, event);
                });

                MessageBus.on('REQUEST_TOKEN', (payload, frameId) => {
                    return { token: this.session?.token || SessionAuthority.getToken() || 'demo-token', expiry: Date.now() + 3600000, user: this.session?.user || SessionAuthority.getUser() };
                });

                MessageBus.on('CHILD_READY', (payload, frameId, event) => {
                    MessageBus.markFrameReady(frameId);
                    this.distributeToFrame(frameId, event);
                    
                    if (window.__BOOT_STATE__) {
                        window.__BOOT_STATE__.iframesRegistered.add(frameId);
                    }
                    
                    if (window.__PARENT_AUTHORITY__) {
                        const frame = document.getElementById(frameId);
                        if (frame) {
                            window.__PARENT_AUTHORITY__.registerFrame(frame.contentWindow);
                        }
                    }
                });

                return this;
            },

            _initCallCore: function() {
                if (this._callCoreInitialized) return;
                
                if (window.callCore && typeof window.callCore.init === 'function') {
                    try {
                        window.callCore.init({ session: SessionAuthority.getState(), messageBus: MessageBus });
                        this._callCoreInitialized = true;
                    } catch (e) {}
                } else {
                    const checkCallCore = () => {
                        if (window.callCore && typeof window.callCore.init === 'function') {
                            this._initCallCore();
                        } else {
                            setTimeout(checkCallCore, 500);
                        }
                    };
                    checkCallCore();
                }
            },

            async loadFromModule(sessionMod) {
                try {
                    const user = await sessionMod.getCurrentUser?.() || window.api?.auth?.getCurrentUser?.() || this.fallbackUser;
                    const token = await sessionMod.getToken?.() || window.api?.auth?.getToken?.() || localStorage.getItem('kynecta_token');
                    
                    this.session = { user: user || null, token: token || null, authenticated: !!user, timestamp: Date.now(), fromModule: true };
                    this.authenticated = !!user;
                    
                    if (user && token) {
                        localStorage.setItem('kynecta_user', JSON.stringify(user));
                        localStorage.setItem('kynecta_token', token);
                        
                        window.AUTH_SESSION = Object.freeze({
                            userId: user.id,
                            token: token,
                            sessionId: 'sess_' + Date.now(),
                            permissions: user.permissions || [],
                            timestamp: Date.now()
                        });
                        
                        if (window.__BOOT_STATE__) {
                            window.__BOOT_STATE__.sessionRestored = true;
                        }
                        
                        if (window.__markSessionReady) {
                            window.__markSessionReady();
                        }
                    }
                } catch (e) {
                    this.session = this.session || { user: this.fallbackUser, authenticated: !!this.fallbackUser };
                    this.authenticated = !!this.fallbackUser;
                }
                return this.session;
            },

            getSession() {
                return SessionAuthority.getState();
            },

            distributeToFrame(frameId, event) {
                const session = this.getSession();
                if (session.authenticated && SessionAuthority.isReady()) {
                    const response = {
                        source: MessageBus.SOURCE_PARENT,
                        app: MessageBus.APP_NAME,
                        version: MessageBus.VERSION,
                        type: 'SESSION_DATA',
                        payload: session,
                        frameId,
                        timestamp: Date.now(),
                        _processedBy: 'orchestration'
                    };
                    try {
                        event.source.postMessage(response, event.origin);
                    } catch (e) {}
                }
            },

            broadcastSession() {
                const session = this.getSession();
                if (session.authenticated && SessionAuthority.isReady()) {
                    MessageBus.broadcast('SESSION_UPDATE', session);
                }
            },

            async refresh() {
                return SessionAuthority.refresh?.() || this.session;
            },

            logout() {
                SessionAuthority.logout();
                MessageBus.broadcast('SESSION_LOGOUT', { timestamp: Date.now() });
                this._callCoreInitialized = false;
            }
        };

        if (!window.SessionGuardian) {
            window.SessionGuardian = SessionGuardian.init();
        }

        const IframeOrchestrator = window.IframeOrchestrator || {
            registry: new Map(),
            configs: [
                { id: 'messagesIframe', container: 'messagesContent', src: 'message.html', critical: true },
                { id: 'statusIframe', container: 'statusContent', src: 'status.html', critical: false },
                { id: 'groupIframe', container: 'groupContent', src: 'group.html', critical: false },
                { id: 'friendsIframe', container: 'friendsContent', src: 'friend.html', critical: false },
                { id: 'callsIframe', container: 'callsContent', src: 'calls.html', critical: false },
                { id: 'settingsIframe', container: 'settingsContent', src: 'settings.html', critical: false },
                { id: 'toolsIframe', container: 'toolsContent', src: 'Tools.html', critical: false }
            ],
            activeIframe: 'messagesIframe',
            faultState: new Map(),
            degradedFrames: new Set(),
            
            init() {
                this.configs.forEach(cfg => {
                    const container = document.getElementById(cfg.container);
                    if (!container) {
                        return;
                    }

                    let iframe = document.getElementById(cfg.id);
                    if (!iframe) {
                        iframe = document.createElement('iframe');
                        iframe.id = cfg.id;
                        iframe.className = 'content-iframe';
                        iframe.title = cfg.title || cfg.id;
                        iframe.setAttribute('sandbox', 'allow-same-origin allow-scripts allow-forms allow-popups allow-modals allow-downloads');
                        iframe.setAttribute('allow', 'camera; microphone; fullscreen; geolocation');
                        container.appendChild(iframe);
                    }

                    if (iframe.src !== cfg.src && iframe.src.indexOf(cfg.src) === -1) {
                        if (cfg.critical) {
                            iframe.src = cfg.src;
                        } else {
                            setTimeout(() => { iframe.src = cfg.src; }, 100);
                        }
                    }

                    this.registry.set(cfg.id, {
                        ...cfg,
                        element: iframe,
                        container,
                        loaded: iframe.src !== 'about:blank',
                        lastActive: 0,
                        faultCount: 0,
                        degraded: false,
                        handshakeStatus: 'pending'
                    });

                    iframe.addEventListener('load', () => {
                        const entry = this.registry.get(cfg.id);
                        if (entry) {
                            entry.loaded = true;
                            
                            if (window.__BOOT_STATE__) {
                                window.__BOOT_STATE__.iframesRegistered.add(cfg.id);
                            }
                            
                            if (window.__PARENT_AUTHORITY__) {
                                window.__PARENT_AUTHORITY__.registerFrame(iframe.contentWindow);
                            }
                            
                            if (window.__IFRAME_READY__ === false) {
                                window.__IFRAME_READY__ = true;
                            }
                            
                            if (window.__KYNECTA_COORDINATOR__) {
                                const module = cfg.id.replace('Iframe', '');
                                window.__KYNECTA_COORDINATOR__.markIframeReady(module);
                            }
                        }
                    });

                    iframe.addEventListener('error', () => {
                        this.handleIframeError(cfg.id);
                    });
                });

                this.show('messagesIframe');
                
                return this;
            },

            show(iframeId) {
                const entry = this.registry.get(iframeId);
                if (!entry) return false;

                this.registry.forEach(e => {
                    e.container.classList.add('hidden');
                });

                entry.container.classList.remove('hidden');
                this.activeIframe = iframeId;

                document.querySelectorAll('.nav-icon, .mobile-nav-icon').forEach(el => {
                    el.classList.remove('active', 'bg-purple-700', 'text-white');
                    if (el.classList.contains('nav-icon')) {
                        el.classList.add('text-gray-400', 'hover:text-white', 'hover:bg-gray-800');
                    }
                });

                const desktopIcon = document.querySelector(`.nav-icon[data-page="${entry.id.replace('Iframe', '')}"]`);
                if (desktopIcon) {
                    desktopIcon.classList.remove('text-gray-400', 'hover:text-white', 'hover:bg-gray-800');
                    desktopIcon.classList.add('text-white', 'bg-purple-700');
                }

                const mobileIcon = document.querySelector(`.mobile-nav-icon[data-page="${entry.id.replace('Iframe', '')}"]`);
                if (mobileIcon) {
                    mobileIcon.classList.add('active');
                }

                if (entry.loaded) {
                    MessageBus.send(iframeId, 'PAGE_ACTIVATED', { page: entry.id.replace('Iframe', ''), timestamp: Date.now() }, false).catch(() => {});
                }

                return true;
            },

            handleIframeError(frameId) {
                const entry = this.registry.get(frameId);
                if (!entry) return;

                entry.faultCount++;
                
                if (entry.faultCount >= 2 && !entry.degraded) {
                    this.markDegraded(frameId, 'load-failure');
                }
                
                if (!entry.degraded) {
                    setTimeout(() => this.recover(frameId), 1000 * entry.faultCount);
                }
            },

            markDegraded(frameId, reason) {
                const entry = this.registry.get(frameId);
                if (!entry || entry.degraded) return;
                
                entry.degraded = true;
                this.degradedFrames.add(frameId);
                
                const marker = document.createElement('div');
                marker.className = 'iframe-fault-marker';
                marker.innerHTML = `<span><i class="fas fa-exclamation-triangle mr-2"></i> This section is having trouble loading (${reason})</span><button onclick="window.IframeOrchestrator.recover('${frameId}')">Retry</button>`;
                entry.container.insertBefore(marker, entry.container.firstChild);
                
                const badge = document.createElement('div');
                badge.className = 'iframe-degraded-badge';
                badge.innerHTML = '<i class="fas fa-exclamation-circle"></i> Limited mode';
                entry.container.appendChild(badge);
            },

            recover(frameId) {
                const entry = this.registry.get(frameId);
                if (!entry) return;
                
                const currentSrc = entry.element.src;
                if (currentSrc && currentSrc !== 'about:blank') {
                    entry.element.src = currentSrc.split('?')[0] + `?recover=${Date.now()}`;
                } else {
                    entry.element.src = entry.src;
                }
                
                const marker = entry.container.querySelector('.iframe-fault-marker');
                if (marker) marker.remove();
                const badge = entry.container.querySelector('.iframe-degraded-badge');
                if (badge) badge.remove();
                
                entry.degraded = false;
                this.degradedFrames.delete(frameId);
                entry.faultCount = 0;
                
                // Reset parent ready sent flag for this module
                const moduleName = entry.id.replace('Iframe', '');
                if (window.__resetParentReadySent) {
                    window.__resetParentReadySent(moduleName);
                }
            },

            getActive() {
                return this.activeIframe;
            },

            isDegraded(frameId) {
                return this.registry.get(frameId)?.degraded || false;
            },

            preloadAll() {
                this.registry.forEach(entry => {
                    if (!entry.loaded && entry.element.src === 'about:blank') {
                        entry.element.src = entry.src;
                    }
                });
            }
        };

        window.IframeOrchestrator = IframeOrchestrator;

        const NavigationEngine = window.NavigationEngine || {
            init() {
                document.querySelectorAll('.nav-icon').forEach(el => {
                    el.addEventListener('click', (e) => {
                        e.preventDefault();
                        e.stopPropagation();
                        const page = el.dataset.page;
                        if (page) {
                            const iframeId = `${page}Iframe`;
                            IframeOrchestrator.show(iframeId);
                        }
                    });
                });

                document.querySelectorAll('.mobile-nav-icon').forEach(el => {
                    el.addEventListener('click', (e) => {
                        e.preventDefault();
                        e.stopPropagation();
                        const page = el.dataset.page;
                        if (page) {
                            const iframeId = `${page}Iframe`;
                            IframeOrchestrator.show(iframeId);
                        }
                    });
                });

                MessageBus.on('NAVIGATE_TO', (payload) => {
                    if (payload?.page) {
                        const iframeId = `${payload.page}Iframe`;
                        IframeOrchestrator.show(iframeId);
                    }
                });

                return this;
            }
        };

        const ToolController = window.ToolController || {
            init() {
                document.querySelectorAll('.tool-menu-item[data-tool="mood_tracker"]').forEach(el => {
                    el.addEventListener('click', () => {
                        document.getElementById('moodModal')?.classList.remove('hidden');
                    });
                });

                document.querySelectorAll('[data-tool="logout"]').forEach(el => {
                    el.addEventListener('click', () => {
                        SessionGuardian.logout();
                        setTimeout(() => { window.location.href = '../index.html'; }, 300);
                    });
                });

                document.querySelectorAll('.tool-menu-item[data-tool="goals"], .tool-menu-item[data-tool="analytics"]').forEach(el => {
                    el.addEventListener('click', () => {
                        IframeOrchestrator.show('toolsIframe');
                    });
                });

                document.querySelectorAll('.mood-option').forEach(el => {
                    el.addEventListener('click', () => {
                        const mood = el.dataset.mood;
                        if (mood) {
                            MessageBus.broadcast('MOOD_UPDATE', { mood, timestamp: Date.now() });
                            window.closeModal('moodModal');
                        }
                    });
                });

                document.querySelectorAll('.nav-icon[data-page="tools"], .mobile-nav-icon[data-page="tools"]').forEach(el => {
                    el.addEventListener('contextmenu', (e) => {
                        e.preventDefault();
                        const menu = window.innerWidth < 768 ? document.getElementById('mobileQuickToolsDropdownMenu') : document.getElementById('quickToolsDropdownMenu');
                        if (menu) {
                            menu.classList.toggle('hidden');
                            menu.classList.toggle('open');
                        }
                    });
                });

                document.getElementById('closeQuickToolsMenu')?.addEventListener('click', () => {
                    document.getElementById('quickToolsDropdownMenu')?.classList.add('hidden');
                });
                
                document.getElementById('closeMobileQuickToolsMenu')?.addEventListener('click', () => {
                    document.getElementById('mobileQuickToolsDropdownMenu')?.classList.add('hidden');
                });

                return this;
            }
        };

        const ErrorBoundary = window.ErrorBoundary || {
            init() {
                window.addEventListener('error', (event) => {
                    if (event.target?.tagName === 'IFRAME') {
                        event.preventDefault();
                        return false;
                    }
                    return true;
                });

                window.addEventListener('unhandledrejection', (event) => {
                    event.preventDefault();
                });

                return this;
            }
        };

        const Bootstrap = {
            async run() {
                await SessionAuthority.init();

                if (window.SessionGuardian) {
                    await window.SessionGuardian.initPromise;
                }

                HandshakeManager.init();
                IframeOrchestrator.init();
                NavigationEngine.init();
                ToolController.init();
                
                SessionAuthority.onReady(() => {
                    SessionGuardian.broadcastSession();
                    
                    if (window.__propagateSessionToIframes__) {
                        window.__propagateSessionToIframes__();
                    }
                }).catch(() => {});

                if ('requestIdleCallback' in window) {
                    requestIdleCallback(() => IframeOrchestrator.preloadAll(), { timeout: 2000 });
                } else {
                    setTimeout(() => IframeOrchestrator.preloadAll(), 500);
                }

                const loadingScreen = document.getElementById('loadingScreen');
                if (loadingScreen) {
                    loadingScreen.style.opacity = '0';
                    setTimeout(() => {
                        loadingScreen.classList.add('hidden');
                        loadingScreen.style.opacity = '';
                    }, 300);
                }
            }
        };

        window.switchPage = window.switchPage || ((page) => {
            const iframeId = `${page}Iframe`;
            return IframeOrchestrator.show(iframeId);
        });

        window.goBack = window.goBack || (() => {
            return IframeOrchestrator.show('messagesIframe');
        });

        window.getCurrentUser = window.getCurrentUser || (() => {
            return SessionAuthority.getUser() || SessionGuardian.session?.user || null;
        });

        window.closeModal = window.closeModal || ((modalId) => {
            const modal = document.getElementById(modalId);
            if (modal) modal.classList.add('hidden');
        });

        window.showBottomNavigation = window.showBottomNavigation || (() => {
            if (window.innerWidth < 768) {
                document.getElementById('mobileNavBar')?.classList.remove('hidden-nav');
            }
        });

        window.hideBottomNavigation = window.hideBottomNavigation || (() => {
            if (window.innerWidth < 768) {
                document.getElementById('mobileNavBar')?.classList.add('hidden-nav');
            }
        });

        window.handleLogout = window.handleLogout || (() => {
            SessionGuardian.logout();
            window.location.href = '../index.html';
        });

        window.toggleDebugPanel = () => {
            const panel = document.getElementById('kynectaDebugPanel');
            if (panel) {
                panel.classList.toggle('visible');
            }
        };

        MessageBus.on('API_REQUEST', async (payload, frameId) => {
            if (!SessionGuardian.authenticated && !SessionAuthority.isAuthenticated()) {
                return { success: false, error: 'not authenticated' };
            }
            
            if (DependencyManager.isReady('api.request')) {
                try {
                    const requestMod = DependencyManager.get('api.request');
                    const response = await requestMod.request(payload.endpoint, payload.options);
                    return { success: true, data: response };
                } catch (e) {
                    return { success: false, error: e.message };
                }
            }
            
            if (window.API) {
                return window.__safeApiCall(() => window.API.request(payload.endpoint, payload.options));
            }
            
            return { success: false, error: 'api not available' };
        });

        MessageBus.on('REQUEST_TOKEN', (payload) => {
            return { token: SessionAuthority.getToken() || SessionGuardian.session?.token || 'demo-token', expiry: Date.now() + 3600000, user: SessionAuthority.getUser() || SessionGuardian.session?.user };
        });

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', () => {
                ErrorBoundary.init();
                NavigationEngine.init();
                ToolController.init();
                Bootstrap.run().catch(e => {});
            });
        } else {
            ErrorBoundary.init();
            NavigationEngine.init();
            ToolController.init();
            Bootstrap.run().catch(e => {});
        }
    })();
    </script>

    <script>
    (function() {
        setTimeout(function() {
            var loadingScreen = document.getElementById('loadingScreen');
            if (loadingScreen && !loadingScreen.classList.contains('hidden')) {
                loadingScreen.style.opacity = '0';
                setTimeout(function() {
                    loadingScreen.classList.add('hidden');
                    loadingScreen.style.opacity = '';
                }, 300);
            }
        }, 3000);
        
        setTimeout(function() {
            var messagesIframe = document.getElementById('messagesIframe');
            if (messagesIframe && messagesIframe.contentWindow) {
                try {
                    messagesIframe.contentWindow.postMessage({ type: 'PING', timestamp: Date.now(), _processedBy: 'final' }, '*');
                } catch (e) {
                    messagesIframe.src = messagesIframe.src.split('?')[0] + '?reload=' + Date.now();
                }
            }
        }, 5000);
    })();
    </script>

    <script src="js/app.core.eventbus.js"></script>
    <script src="js/app.core.store.js"></script>
    <script src="js/app.realtime.socket.js"></script>
    <script src="js/services.message.js"></script>
    <script src="js/services.friend.js"></script>
    <script src="js/app.sync.manager.js"></script>
    <script src="js/app.offline.queue.js"></script>

    <script>
    window.closeModal = window.closeModal || function(modalId) {
        const modal = document.getElementById(modalId);
        if (modal) modal.classList.add('hidden');
    };
    </script>

    <script>
    (function() {
        'use strict';
        
        window.addEventListener('load', function() {
            setTimeout(function() {
                if (window.__propagateSessionToIframes__) {
                    window.__propagateSessionToIframes__();
                }
            }, 1000);
        });
        
        window.KynectaEventBus?.on('AUTH_SUCCESS', function() {
            setTimeout(function() {
                if (window.__propagateSessionToIframes__) {
                    window.__propagateSessionToIframes__();
                }
            }, 100);
        });
    })();
    </script>

    <script>
        // Add this debug code after the token validation section
(function debugTokens() {
    console.log('=== TOKEN DEBUG ===');
    console.log('token:', localStorage.getItem('token')?.substring(0, 30) + '...');
    console.log('moodchat_token:', localStorage.getItem('moodchat_token')?.substring(0, 30) + '...');
    
    const authData = localStorage.getItem('kynecta_auth');
    if (authData) {
        try {
            const parsed = JSON.parse(authData);
            console.log('kynecta_auth.token:', parsed.token?.substring(0, 30) + '...');
            console.log('kynecta_auth.userId:', parsed.userId);
            console.log('kynecta_auth.validated:', parsed.validated);
        } catch(e) {}
    }
    
    console.log('=== END DEBUG ===');
})();
// Add this to chat.html - intercept fetch to log headers
(function debugHeaders() {
    const originalFetch = window.fetch;
    window.fetch = async function(...args) {
        console.log('[FETCH DEBUG] Request URL:', args[0]);
        console.log('[FETCH DEBUG] Headers:', args[1]?.headers);
        
        const response = await originalFetch(...args);
        
        if (response.status === 401) {
            console.error('[FETCH DEBUG] 401 response for:', args[0]);
            console.error('[FETCH DEBUG] Response headers:', [...response.headers.entries()]);
        }
        
        return response;
    };
})();
// Debug message sending
(function() {
    const originalPostMessage = window.postMessage;
    window.postMessage = function(message, targetOrigin, transfer) {
        console.log('[PARENT DEBUG] Sending message:', {
            type: message.type,
            target: message.target,
            module: message.module,
            hasPayload: !!message.payload,
            hasSession: !!(message.payload?.session),
            timestamp: message.timestamp
        });
        return originalPostMessage.call(this, message, targetOrigin, transfer);
    };
    
    // Also monitor MessageBus sends
    if (window.__KYNECTA_MESSAGE_BUS__) {
        const originalSend = window.__KYNECTA_MESSAGE_BUS__.send;
        window.__KYNECTA_MESSAGE_BUS__.send = function(moduleId, message) {
            console.log('[MESSAGE BUS] Sending to', moduleId, 'type:', message.type);
            return originalSend.call(this, moduleId, message);
        };
    }
})();
</script>
<script>
// Detailed backend validation debug
(async function debugBackendValidation() {
    const token = localStorage.getItem('token');
    if (!token) {
        console.log('No token found for debug');
        return;
    }
    
    console.log('=== BACKEND VALIDATION DEBUG ===');
    console.log('Token exists:', token.substring(0, 30) + '...');
    
    try {
        const API_BASE = window.__getApiBase();
        const response = await fetch(`${API_BASE}/auth/validate-token`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'Authorization': `Bearer ${token}`
            },
            body: JSON.stringify({ token: token })
        });
        
        console.log('Response Status:', response.status);
        console.log('Response Headers:', [...response.headers.entries()]);
        
        const text = await response.text();
        console.log('Raw Response:', text);
        
        let data;
        try {
            data = JSON.parse(text);
            console.log('Parsed Response:', JSON.stringify(data, null, 2));
            console.log('Response keys:', Object.keys(data));
        } catch(e) {
            console.log('Failed to parse JSON:', e.message);
        }
        
        console.log('=== END DEBUG ===');
    } catch(e) {
        console.error('Debug request failed:', e);
    }
})();
</script>

<script>
// Debug endpoint to check what validation returns
(async function debugValidation() {
    const token = localStorage.getItem('token');
    if (token) {
        console.log('=== DEBUG VALIDATION ===');
        console.log('Token:', token.substring(0, 30) + '...');
        
        try {
            const API_BASE = window.__getApiBase();
            const response = await fetch(`${API_BASE}/auth/validate-token`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Authorization': `Bearer ${token}`
                },
                body: JSON.stringify({ token: token })
            });
            
            const data = await response.json();
            console.log('Validation Response Status:', response.status);
            console.log('Validation Response Data:', JSON.stringify(data, null, 2));
            console.log('=== END DEBUG ===');
        } catch (e) {
            console.error('Validation debug failed:', e);
        }
    }
})();
</script>
</body>
</html>


