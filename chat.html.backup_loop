<script>
// ===== SINGLE SOURCE OF TRUTH FOR TOKEN VALIDATION =====
// This is the ONLY token validation function
let _isValidating = false;
let _lastValidationResult = null;
let _lastValidationTime = 0;
const VALIDATION_COOLDOWN = 10000; // 10 seconds cooldown

window.__validateTokenWithBackend = async function(token) {
    // Prevent multiple simultaneous validations
    if (_isValidating) {
        console.log('⏳ Validation already in progress, waiting...');
        // Wait for the ongoing validation
        await new Promise(resolve => {
            const checkInterval = setInterval(() => {
                if (!_isValidating) {
                    clearInterval(checkInterval);
                    resolve();
                }
            }, 100);
        });
        return _lastValidationResult || { valid: false };
    }
    
    // Check cooldown
    const now = Date.now();
    if (_lastValidationResult && (now - _lastValidationTime) < VALIDATION_COOLDOWN) {
        console.log('⏱️ Using cached validation result (cooldown)');
        return _lastValidationResult;
    }
    
    _isValidating = true;
    _lastValidationTime = now;
    
    try {
        if (!token) {
            _lastValidationResult = { valid: false, reason: 'no_token' };
            return _lastValidationResult;
        }
        
        const API_BASE = window.__getApiBase ? window.__getApiBase() : 'http://localhost:4000/api';
        console.log('🔍 Validating token with backend...');
        
        const response = await fetch(`${API_BASE}/auth/validate-token`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'Authorization': `Bearer ${token}`
            }
        });
        
        const data = await response.json();
        
        const isValid = data.valid === true || data.success === true || data.authValidated === true;
        const userId = data.userId || data.user?.id;
        
        _lastValidationResult = {
            valid: isValid,
            userId: userId,
            user: data.user || { id: userId, username: 'User' },
            timestamp: now
        };
        
        console.log(isValid ? '✅ Token is valid' : '❌ Token is invalid', _lastValidationResult);
        return _lastValidationResult;
        
    } catch (error) {
        console.error('❌ Validation error:', error);
        _lastValidationResult = { valid: false, error: error.message };
        return _lastValidationResult;
    } finally {
        _isValidating = false;
    }
};

// Single initialization - runs only once
let _initialized = false;

async function initializeApp() {
    if (_initialized) {
        console.log('⚠️ App already initialized, skipping');
        return;
    }
    _initialized = true;
    
    console.log('🚀 Initializing app...');
    
    // Get token
    let token = localStorage.getItem('token') || localStorage.getItem('moodchat_token');
    
    if (!token) {
        console.log('ℹ️ No token found');
        return;
    }
    
    // Validate once
    const validation = await window.__validateTokenWithBackend(token);
    
    if (validation.valid && validation.userId) {
        console.log('✅ Session valid for user:', validation.userId);
        
        // Ensure token is stored
        localStorage.setItem('token', token);
        localStorage.setItem('moodchat_token', token);
        
        if (validation.user) {
            localStorage.setItem('currentUser', JSON.stringify(validation.user));
        }
        
        // Dispatch session ready event once
        window.dispatchEvent(new CustomEvent('session:ready', {
            detail: {
                token: token,
                user: validation.user,
                userId: validation.userId,
                timestamp: Date.now(),
                validated: true
            }
        }));
        
        // Broadcast to modules once
        setTimeout(() => {
            if (window.__broadcastSessionToModules) {
                window.__broadcastSessionToModules();
            }
        }, 100);
        
    } else {
        console.log('⚠️ Invalid token, clearing...');
        localStorage.removeItem('token');
        localStorage.removeItem('moodchat_token');
        localStorage.removeItem('kynecta_auth');
    }
}

// Start once when DOM is ready
if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializeApp);
} else {
    initializeApp();
}

// Listen for storage changes (debounced)
let storageDebounce = null;
window.addEventListener('storage', function(event) {
    if (event.key === 'token' || event.key === 'moodchat_token' || event.key === 'kynecta_auth') {
        if (storageDebounce) clearTimeout(storageDebounce);
        storageDebounce = setTimeout(() => {
            console.log('📦 Storage changed, re-initializing...');
            _initialized = false; // Allow re-initialization on storage change
            initializeApp();
        }, 500);
    }
});
</script><script>
// ===== SINGLE SOURCE OF TRUTH FOR TOKEN VALIDATION =====
// Prevent multiple simultaneous validations
let _isValidating = false;
let _lastValidationTime = 0;
let _validationCache = null;
let _validationCacheTime = 0;
const VALIDATION_COOLDOWN = 5000; // 5 seconds cooldown
const CACHE_DURATION = 30000; // Cache validation for 30 seconds

// SINGLE validation function - all others should call this
window.__validateTokenWithBackend = async function(token) {
    // Check cache first
    const now = Date.now();
    if (_validationCache && _validationCacheTime && (now - _validationCacheTime) < CACHE_DURATION) {
        console.log('📦 Using cached validation result');
        return _validationCache;
    }
    
    // Prevent concurrent validations
    if (_isValidating) {
        console.log('⏳ Validation already in progress, waiting...');
        // Wait for the ongoing validation
        await new Promise(resolve => {
            const checkInterval = setInterval(() => {
                if (!_isValidating) {
                    clearInterval(checkInterval);
                    resolve();
                }
            }, 100);
        });
        // Return cached result after waiting
        return _validationCache || { valid: false, reason: 'timeout' };
    }
    
    // Check cooldown
    if (now - _lastValidationTime < VALIDATION_COOLDOWN && _validationCache) {
        console.log('⏱️ Validation cooldown active, using cached result');
        return _validationCache;
    }
    
    _isValidating = true;
    _lastValidationTime = now;
    
    try {
        if (!token) {
            _validationCache = { valid: false, reason: 'no_token' };
            return _validationCache;
        }
        
        const API_BASE = window.__getApiBase ? window.__getApiBase() : 'http://localhost:4000/api';
        console.log('🔍 Validating token with backend (single source)...');
        
        const response = await fetch(${API_BASE}/auth/validate-token, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'Authorization': Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ1c2VySWQiOjExLCJpZCI6MTEsImVtYWlsIjoidGVzdHVzZXIxMjNAZXhhbXBsZS5jb20iLCJ1c2VybmFtZSI6InRlc3R1c2VyMTIzIiwicm9sZSI6InVzZXIiLCJpYXQiOjE3NzQ1NTYwNTQsImV4cCI6MTc3NDY0MjQ1NH0.uTKx7MMbIpdNgBZrHuIXy7YJxN0m9lrlFeAJcpz4v_U
            }
        });
        
        let data;
        try {
            data = await response.json();
        } catch (e) {
            data = { success: false, valid: false };
        }
        
        const isValid = data.valid === true || data.success === true;
        const userId = data.userId || data.user?.id || data.user?.userId;
        
        const result = {
            valid: isValid,
            userId: userId,
            user: data.user || { id: userId, username: 'User' },
            expiresAt: data.expiresIn ? Date.now() + (data.expiresIn * 1000) : null,
            authValidated: data.authValidated === true,
            timestamp: Date.now()
        };
        
        _validationCache = result;
        _validationCacheTime = now;
        
        console.log(isValid ? '✅ Token is valid' : '❌ Token is invalid', result);
        return result;
        
    } catch (error) {
        console.error('❌ Validation error:', error);
        _validationCache = { valid: false, reason: 'network_error', error: error.message };
        return _validationCache;
    } finally {
        _isValidating = false;
    }
};

// Clear cache on storage changes (but not too often)
let _storageDebounceTimer = null;
window.addEventListener('storage', function(event) {
    if (event.key === 'token' || event.key === 'moodchat_token' || event.key === 'kynecta_auth') {
        if (_storageDebounceTimer) clearTimeout(_storageDebounceTimer);
        _storageDebounceTimer = setTimeout(() => {
            console.log('📦 Storage changed, clearing validation cache');
            _validationCache = null;
            _validationCacheTime = 0;
        }, 500);
    }
});

// Single initialization function
let _initialized = false;
async function initializeAuth() {
    if (_initialized) {
        console.log('⚠️ Auth already initialized, skipping');
        return;
    }
    _initialized = true;
    
    // Get token from any location
    let token = localStorage.getItem('token') || 
                localStorage.getItem('moodchat_token') || 
                sessionStorage.getItem('token');
    
    if (token) {
        const validation = await window.__validateTokenWithBackend(token);
        if (validation.valid && validation.userId) {
            console.log('✅ Session valid for user:', validation.userId);
            // Ensure token is stored in all locations
            localStorage.setItem('token', token);
            localStorage.setItem('moodchat_token', token);
            if (validation.user) {
                localStorage.setItem('currentUser', JSON.stringify(validation.user));
            }
        } else {
            console.log('⚠️ Invalid token, clearing...');
            localStorage.removeItem('token');
            localStorage.removeItem('moodchat_token');
            localStorage.removeItem('kynecta_auth');
        }
    } else {
        console.log('ℹ️ No token found');
    }
}

// Start initialization only once
if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializeAuth);
} else {
    initializeAuth();
}
</script>
<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
    <link rel="manifest" href="manifest.json">
    <meta name="theme-color" content="#4F46E5">
